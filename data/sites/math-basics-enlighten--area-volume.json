 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：平面图形的面积」的一句话核心是什么？",
   "back": "所有直线图形的面积公式都从“矩形面积＝长×宽”出发，靠割补推出来。",
   "chapterId": "ch01",
   "tags": [
    "area-volume",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：圆、扇形与曲线形面积」的一句话核心是什么？",
   "back": "圆面积是把圆切成无数个小扇形拼成矩形得到的：S=πr²，周长 C=2πr。",
   "chapterId": "ch02",
   "tags": [
    "area-volume",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：立体图形的体积」的一句话核心是什么？",
   "back": "柱是“底面积乘高”，锥是柱的三分之一，台是两锥相减，球是 4πr³/3；辛普森公式把它们合成一条。",
   "chapterId": "ch03",
   "tags": [
    "area-volume",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "什么是「面积」？",
   "back": "图形包含的单位正方形个数。",
   "chapterId": "ch01",
   "tags": [
    "area-volume",
    "术语"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「割补法」？",
   "back": "剪切重拼求面积的方法。",
   "chapterId": "ch01",
   "tags": [
    "area-volume",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「等积变形」？",
   "back": "形状改变而面积不变的变形。",
   "chapterId": "ch01",
   "tags": [
    "area-volume",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「圆周率」？",
   "back": "圆周长与直径之比 π。",
   "chapterId": "ch02",
   "tags": [
    "area-volume",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「扇形」？",
   "back": "两条半径与一段弧围成的图形。",
   "chapterId": "ch02",
   "tags": [
    "area-volume",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「弓形」？",
   "back": "弦与弧围成的图形。",
   "chapterId": "ch02",
   "tags": [
    "area-volume",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「祖暅原理」？",
   "back": "等高处截面积相等的两个立体体积相等。",
   "chapterId": "ch03",
   "tags": [
    "area-volume",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「辛普森公式」？",
   "back": "V=(h/6)(S顶+4S中+S底)。",
   "chapterId": "ch03",
   "tags": [
    "area-volume",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「台体」？",
   "back": "锥体被平行于底面的平面截去上部后的部分。",
   "chapterId": "ch03",
   "tags": [
    "area-volume",
    "术语"
   ]
  }
 ],
