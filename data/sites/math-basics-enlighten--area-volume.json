   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c02",
   "explain": "V=(4/3)π×27=36π。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q07",
   "chapterId": "__all__",
   "stem": "圆柱底面半径 2、高 6，体积是：",
   "options": [
    "24π",
    "12π",
    "8π",
    "36π"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "V=π×4×6=24π。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q08",
   "chapterId": "__all__",
   "stem": "用辛普森公式求半径为 r 的球体积，代入 S顶=S底=0、S中=πr²，得到：",
   "options": [
    "(2/3)πr³",
    "(4/3)πr³",
    "πr³",
    "(1/3)πr³"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "V=(2r/6)(0+4πr²+0)=(4/3)πr³，与球体积公式一致。",
