 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "三角形底为 8、高为 5，面积是：",
   "options": [
    "40",
    "20",
    "13",
    "10"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "S=8×5/2=20。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "把一个图形按 1:3 放大，面积变为原来的：",
   "options": [
    "3 倍",
    "6 倍",
    "9 倍",
    "1/3"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "c01",
   "explain": "面积比是相似比的平方，3²=9。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "stem": "半径为 3 的圆，面积是：",
   "options": [
    "6π",
    "9π",
    "3π",
    "12π"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "S=πr²=9π。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "stem": "半径为 4、圆心角为 90° 的扇形面积是：",
   "options": [
    "4π",
    "8π",
    "2π",
    "16π"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c01",
   "explain": "90°=π/2，S=(1/2)×16×π/2=4π。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "stem": "圆锥底面半径 3、高 4，体积是：",
   "options": [
    "12π",
    "36π",
    "16π",
    "4π"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c02",
   "explain": "V=(1/3)π×9×4=12π。",
   "misconception": "",
   "bookSource": null
  },
  {
