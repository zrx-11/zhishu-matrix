 "cards": [
  {
   "id": "f01",
   "front": "R1 改变了模型架构吗？",
   "back": "没有，R1 结构与 V3 相同，变的是后训练。",
   "chapterId": "ch10",
   "tags": [
    "架构",
    "R1"
   ]
  },
  {
   "id": "f02",
   "front": "三代架构的瓶颈迁移顺序？",
   "back": "KV cache → 注意力 FLOPs + KV → prefill + KV 存储/带宽。",
   "chapterId": "ch10",
   "tags": [
    "架构",
    "瓶颈"
   ]
  },
  {
   "id": "f03",
   "front": "MLA 解决什么？",
   "back": "用低维潜向量压 KV cache，支撑 128K 上下文。",
   "chapterId": "ch10",
   "tags": [
    "架构",
    "MLA"
   ]
  },
  {
   "id": "f04",
   "front": "CSA2 多了哪个压缩维度？",
   "back": "层维度：跨层复用主 KV、索引器 K 和 top-k 索引。",
   "chapterId": "ch10",
   "tags": [
    "架构",
    "CSA2"
   ]
  },
  {
   "id": "f05",
   "front": "MoE 的总参数和激活参数区别？",
   "back": "总参数是全部专家，激活参数是单 token 实际用到的部分。",
   "chapterId": "ch11",
   "tags": [
    "组件",
    "MoE"
   ]
  },
  {
   "id": "f06",
   "front": "mHC 的约束和投影方法？",
   "back": "双随机矩阵，Sinkhorn-Knopp 迭代。",
   "chapterId": "ch11",
   "tags": [
    "组件",
    "mHC"
   ]
  },
  {
   "id": "f07",
   "front": "Muon 怎么更新？",
   "back": "Newton-Schulz 正交化梯度矩阵，再动量更新。",
   "chapterId": "ch11",
   "tags": [
    "组件",
    "Muon"
   ]
  },
  {
   "id": "f08",
   "front": "Engram 为什么 O(1)？",
   "back": "哈希查表，不需要矩阵乘法。",
   "chapterId": "ch11",
   "tags": [
    "组件",
    "Engram"
   ]
  },
  {
   "id": "f09",
   "front": "R1 后训练四阶段？",
   "back": "冷启动 SFT → 推理 RL → 拒绝采样 SFT → 推理+通用 RL。",
   "chapterId": "ch12",
   "tags": [
    "训练",
    "R1"
   ]
  },
  {
   "id": "f10",
   "front": "V4 后训练两阶段？",
   "back": "领域专家 SFT+GRPO → 多教师 OPD。",
   "chapterId": "ch12",
   "tags": [
    "训练",
    "V4"
   ]
  },
  {
   "id": "f11",
   "front": "OPD 的“在线”指什么？",
   "back": "轨迹由学生自己生成，教师在这些轨迹上给 logits。",
   "chapterId": "ch12",
   "tags": [
    "训练",
    "OPD"
   ]
  },
  {
   "id": "f12",
   "front": "V4 的稳定性手段？",
   "back": "Anticipatory Routing、SwiGLU Clamping、mHC、Muon。",
   "chapterId": "ch12",
   "tags": [
    "训练",
    "稳定性"
   ]
  },
  {
   "id": "f13",
   "front": "单请求 KV 怎么算？",
   "back": "token 数 × 每 token 字节数。",
   "chapterId": "ch13",
   "tags": [
    "选型",
    "KV"
   ]
  },
  {
   "id": "f14",
   "front": "CED 适合什么负载？",
   "back": "输入密集、prefill 占比高的智能体负载。",
   "chapterId": "ch13",
   "tags": [
    "选型",
    "CED"
   ]
  },
  {
   "id": "f15",
   "front": "选型三问？",
   "back": "瓶颈是什么、代价是什么、实验验证了什么。",
   "chapterId": "ch13",
   "tags": [
    "选型",
    "方法"
   ]
  },
  {
   "id": "f16",
   "front": "评审报告六节？",
   "back": "画像、瓶颈、对比、建议、风险、结论。",
   "chapterId": "ch13",
   "tags": [
    "选型",
    "报告"
   ]
  }
 ],
 "glossary": [
  {
   "term": "瓶颈迁移",
   "en": "",
   "def": "部署瓶颈从 KV cache 转向 FLOPs 再转向 prefill/带宽。",
   "chapterIds": [
    "ch10"
   ]
  },
  {
   "term": "激活参数",
   "en": "",
   "def": "单个 token 实际参与计算的参数。",
   "chapterIds": [
    "ch10"
   ]
  },
  {
   "term": "总参数",
   "en": "",
   "def": "模型全部参数，MoE 中远大于激活参数。",
   "chapterIds": [
    "ch10"
   ]
  },
  {
   "term": "非对称架构",
   "en": "",
   "def": "prefill 和 decode 走不同计算路径的架构。",
   "chapterIds": [
    "ch10"
   ]
  },
  {
   "term": "专家并行",
   "en": "",
   "def": "把 MoE 专家分布到不同设备上。",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "路由",
   "en": "",
   "def": "决定 token 进入哪些专家的机制。",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "双随机矩阵",
   "en": "",
   "def": "行和、列和都为 1 的非负矩阵。",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "正交化",
   "en": "",
   "def": "把梯度矩阵的奇异值拉到接近 1。",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "压缩维度",
   "en": "",
   "def": "条目大小、序列长度、层数、位宽四个可压缩方向。",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "prefill",
   "en": "",
   "def": "读入整段输入并建立 KV cache 的阶段。",
   "chapterIds": [
    "ch12"
   ]
  },
  {
   "term": "decode",
   "en": "",
   "def": "逐 token 生成输出的阶段。",
   "chapterIds": [
    "ch12"
   ]
  },
  {
   "term": "OPD",
   "en": "",
   "def": "学生在自己轨迹上向多个教师做全词表蒸馏。",
   "chapterIds": [
    "ch12"
   ]
  },
  {
   "term": "GRM",
   "en": "",
   "def": "生成式奖励模型，模型自己生成评分理由和分数。",
   "chapterIds": [
    "ch12"
   ]
  },
  {
   "term": "DSec",
   "en": "",
   "def": "V4.1 用于大规模智能体 RL 的弹性计算沙箱。",
   "chapterIds": [
    "ch12"
   ]
  },
  {
   "term": "任务三元组",
   "en": "",
   "def": "问题、环境、验证系统。",
   "chapterIds": [
    "ch12"
   ]
  },
  {
