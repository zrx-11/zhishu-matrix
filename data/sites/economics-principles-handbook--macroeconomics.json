 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch23",
   "stem": "下列哪一项计入当年的 GDP？",
   "options": [
    "二手车的转手价格",
    "政府发放的失业救济金",
    "新建住宅的建造价值",
    "购买某公司股票"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "新建住宅属于投资（I），计入 GDP。二手车只计中介佣金，救济金是转移支付，买股票是资产换手，都不计入。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch23",
   "stem": "某国名义 GDP 为 550 亿元，按基年价格计算的实际 GDP 为 385 亿元。GDP 平减指数约为？",
   "options": [
    "100",
    "130",
    "142.9",
    "165"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "平减指数 = 名义 ÷ 实际 × 100 = 550 ÷ 385 × 100 ≈ 142.9，说明价格水平比基年高约 43%。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch23",
   "stem": "支出法下，进口消费品为什么要从总支出中减去？",
   "options": [
    "因为进口品价格更高",
    "因为它已被计入消费但并非本国生产",
    "因为进口要交关税",
    "因为进口品不计入统计口径"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "消费者买进口货时这笔钱算在 C 里，但它不是本国生产的，所以通过 NX = 出口 − 进口 把它扣除。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch23",
   "stem": "GDP 无法反映下列哪些内容？",
   "options": [
    "家务劳动的价值",
    "收入分配状况",
    "环境破坏的成本",
    "产品的质量改进"
   ],
   "answer": [
    0,
    1,
    2,
    3
   ],
   "type": "multi",
   "conceptId": "",
   "explain": "GDP 只统计有市场价格的最终产品，不反映分配、环境、家务与质量变化，因此不能等同于福利。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q01",
   "chapterId": "ch24",
   "stem": "篮子为 4 个苹果与 2 条面包。基年成本 14 元，当期成本 20 元。CPI 约为？",
   "options": [
    "120",
    "135",
    "142.9",
    "150"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "CPI = 20 ÷ 14 × 100 ≈ 142.9，表示价格水平比基年高约 42.9%。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch24",
   "stem": "CPI 与 GDP 平减指数最重要的差别是？",
   "options": [
    "CPI 只统计消费品，平减指数覆盖全部国内生产",
    "CPI 每月公布，平减指数每年公布",
    "CPI 不含服务，平减指数含服务",
    "两者完全相同"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "CPI 只用消费者篮子（含进口消费品），平减指数覆盖国内生产的全部产品（含投资品与出口），两者数值与用途都不同。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch24",
   "stem": "名义利率 6%，通胀率 4%，实际利率约为？",
   "options": [
    "10%",
    "2%",
    "1.5%",
    "−2%"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "实际利率 ≈ 名义利率 − 通胀率 = 2%。影响储蓄与借贷决策的是实际利率，而不是挂牌的名义利率。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch24",
   "stem": "按物价指数自动调整工资或养老金的做法叫什么？（两个字）",
   "options": [],
   "answer": "指数化",
   "type": "blank",
   "conceptId": "",
   "explain": "指数化能避免通胀侵蚀实际收入，但可能形成工资与物价互相推动的螺旋。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q01",
   "chapterId": "ch25",
   "stem": "70 法则下，年增长 7% 的经济翻倍约需多少年？",
   "options": [
    "7 年",
    "10 年",
    "20 年",
    "35 年"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "70 ÷ 7 = 10 年。增长 2% 则需 35 年，复利效应下差距悬殊。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch25",
   "stem": "「追赶效应」存在的原因是？",
   "options": [
    "穷国人口多",
    "穷国资本少，每增加一单位资本的增产效果更明显",
    "穷国技术更好",
    "发达国家不愿意增长"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "资本边际收益递减意味着一单位资本在资本存量低的穷国产生更大的产出增量，因此穷国有更快的增长潜力。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch25",
   "stem": "下列哪项不是决定生产率的核心因素？",
   "options": [
    "物质资本",
    "人力资本",
    "货币发行量",
    "技术知识"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "生产率由物质资本、人力资本、自然资源与技术决定。货币量影响价格水平，不影响生产率。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch25",
   "stem": "有利于长期增长的政策包括？",
   "options": [
    "保护产权与政治稳定",
    "提高储蓄率并投资于资本",
    "普及教育与改善健康",
    "闭关限制进口"
   ],
   "answer": [
    0,
    1,
    2
   ],
   "type": "multi",
   "conceptId": "",
   "explain": "前三项分别对应制度、资本、人力资本。闭关限制进口通常不利于技术引进与专业化分工。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q01",
   "chapterId": "ch26",
   "stem": "在可贷资金市场模型中，资金的供给来自？",
   "options": [
    "投资",
    "储蓄",
    "政府支出",
    "进口"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "储蓄提供可贷资金，投资形成需求；两者相交决定利率。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch26",
   "stem": "政府预算赤字扩大，在其他条件不变时通常导致？",
   "options": [
    "利率下降、投资增加",
    "利率上升、私人投资减少",
    "利率不变",
    "储蓄减少、投资增加"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "赤字增加资金需求，需求曲线右移，利率上升，部分私人投资被挤出。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch26",
   "stem": "宏观意义上的「投资」指？",
   "options": [
    "购买股票",
    "购买债券",
    "购买新机器与厂房",
    "把钱存入银行"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "宏观投资指形成新资本（设备、厂房、住宅、库存）；买卖股票债券只是资产转手。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch26",
   "stem": "金融中介包括？",
   "options": [
    "商业银行",
    "共同基金",
    "债券发行企业",
    "中央银行"
   ],
   "answer": [
    0,
    1,
    3
   ],
   "type": "multi",
   "conceptId": "",
   "explain": "银行、共同基金、央行都属于中介类机构；债券发行企业是资金需求方，通过金融市场直接融资。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q01",
   "chapterId": "ch27",
   "stem": "三年后获得 100 万元，贴现率 5%，现值约为？",
   "options": [
    "85 万",
    "86.4 万",
    "95 万",
    "115 万"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "PV = 100 ÷ 1.05³ ≈ 86.4 万元；今天的 86.4 万按 5% 复利三年正好变成 100 万。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch27",
   "stem": "分散化投资能消除哪类风险？",
   "options": [
    "市场风险",
    "个别企业或行业的风险",
    "通货膨胀风险",
    "利率风险"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "企业特有风险可通过持有不相关资产抵消；市场风险影响全部资产，分散无法消除。",
   "misconception": "",
   "bookSource": null
  },
  {
