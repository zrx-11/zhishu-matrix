   "chapterId": "ch36",
   "tags": [
    "货币政策"
   ]
  },
  {
   "id": "f-ch36-04",
   "front": "零通胀目标的三重风险",
   "back": "滑入通缩、反通胀代价高、名义工资难以下调。",
   "chapterId": "ch36",
   "tags": [
    "通胀目标"
   ]
  },
  {
   "id": "f-ch36-05",
   "front": "周期性赤字与结构性赤字",
   "back": "前者由衰退造成应容忍，后者是长期入不敷出应削减。",
   "chapterId": "ch36",
   "tags": [
    "财政"
   ]
  },
