 "cards": [
  {
   "id": "f-ch23-01",
   "front": "GDP 定义的四个限定",
   "back": "一国境内、一定时期、最终产品与服务、市场价值。",
   "chapterId": "ch23",
   "tags": [
    "GDP"
   ]
  },
  {
   "id": "f-ch23-02",
   "front": "支出法的四项",
   "back": "C 消费 + I 投资 + G 政府购买 + NX 净出口；进口通过 NX 扣除。",
   "chapterId": "ch23",
   "tags": [
    "GDP",
    "计算"
   ]
  },
  {
   "id": "f-ch23-03",
   "front": "名义 GDP 与实际 GDP 的差别",
   "back": "名义用当期价格，实际用基年价格；实际剔除了价格变动，反映真实产量。",
   "chapterId": "ch23",
   "tags": [
    "GDP"
   ]
  },
  {
   "id": "f-ch23-04",
   "front": "GDP 平减指数的算法",
   "back": "名义 GDP ÷ 实际 GDP × 100；其百分比变化即通胀率的近似。",
   "chapterId": "ch23",
   "tags": [
    "GDP",
    "通胀"
   ]
  },
  {
   "id": "f-ch23-05",
   "front": "GDP 的四类盲区",
   "back": "家务与自给劳动、地下经济、分配与环境、闲暇与质量改进。",
   "chapterId": "ch23",
   "tags": [
    "GDP",
    "局限"
   ]
  },
  {
   "id": "f-ch24-01",
   "front": "CPI 的三步算法",
   "back": "定篮子、查当期价格、算「当期成本 ÷ 基期成本 × 100」。",
   "chapterId": "ch24",
   "tags": [
    "CPI",
    "计算"
   ]
  },
  {
   "id": "f-ch24-02",
   "front": "CPI 高估通胀的三个原因",
   "back": "替代偏差、新产品出现、质量改进未被计入。",
   "chapterId": "ch24",
   "tags": [
    "CPI",
    "易错"
   ]
  },
  {
   "id": "f-ch24-03",
   "front": "CPI 与平减指数的三点差别",
   "back": "覆盖范围（消费 vs 全部生产）、是否含进口、篮子固定还是随产量变化。",
   "chapterId": "ch24",
   "tags": [
    "CPI"
   ]
  },
  {
   "id": "f-ch24-04",
   "front": "实际利率的算法与作用",
   "back": "实际利率 ≈ 名义利率 − 通胀率；影响储蓄、借贷与投资决策。",
   "chapterId": "ch24",
   "tags": [
    "利率"
   ]
  },
  {
   "id": "f-ch24-05",
   "front": "指数化的利弊",
   "back": "利：保住实际收入；弊：可能形成工资与物价螺旋。",
   "chapterId": "ch24",
   "tags": [
    "通胀"
   ]
  },
  {
   "id": "f-ch25-01",
   "front": "生产率与生活水平的关系",
   "back": "人均生活水平由生产率（每劳动小时的产出）决定，而不是工作时长或资源禀赋。",
   "chapterId": "ch25",
   "tags": [
    "增长"
   ]
  },
  {
   "id": "f-ch25-02",
   "front": "决定生产率的四项因素",
   "back": "物质资本、人力资本、自然资源、技术知识。",
   "chapterId": "ch25",
   "tags": [
    "增长"
   ]
  },
  {
   "id": "f-ch25-03",
   "front": "技术知识与人力资本的区别",
   "back": "技术知识是「知识存在」；人力资本是「人掌握了知识」。技术可引进，人力资本必须自己培养。",
   "chapterId": "ch25",
   "tags": [
    "增长",
    "易错"
   ]
  },
  {
   "id": "f-ch25-04",
   "front": "70 法则",
   "back": "翻倍年数约等于 70 ÷ 年增长率（%）。",
   "chapterId": "ch25",
   "tags": [
    "增长",
    "计算"
   ]
  },
  {
   "id": "f-ch25-05",
   "front": "追赶效应的条件",
   "back": "穷国资本少、边际收益高，增长潜力大；但需要产权、开放、教育等制度条件配合。",
   "chapterId": "ch25",
   "tags": [
    "增长"
   ]
  },
  {
   "id": "f-ch26-01",
   "front": "宏观投资与金融投资的区别",
   "back": "宏观投资是购买新资本（设备、厂房、住宅）；买股票债券只是资产换手，不计入投资。",
   "chapterId": "ch26",
   "tags": [
    "金融体系",
    "易错"
   ]
  },
  {
   "id": "f-ch26-02",
   "front": "债券利率由什么决定",
   "back": "期限、信用风险、税收待遇：期限越长、风险越高，利率越高。",
   "chapterId": "ch26",
   "tags": [
    "债券"
   ]
  },
  {
   "id": "f-ch26-03",
   "front": "可贷资金市场的供给与需求",
   "back": "储蓄是供给（利率升则增），投资是需求（利率升则减），交点定均衡利率。",
   "chapterId": "ch26",
   "tags": [
    "可贷资金"
   ]
  },
  {
   "id": "f-ch26-04",
   "front": "挤出效应",
   "back": "政府借款增加资金需求、抬高利率，从而减少私人投资。",
   "chapterId": "ch26",
   "tags": [
    "财政政策",
    "政策"
   ]
  },
  {
   "id": "f-ch26-05",
   "front": "金融中介的两类",
   "back": "银行（吸存放贷）与共同基金（汇集资金专业投资）。",
   "chapterId": "ch26",
   "tags": [
    "金融体系"
   ]
  },
  {
   "id": "f-ch27-01",
   "front": "现值公式",
   "back": "PV = FV ÷ (1+r)^n；利率越高、期限越长，折得越少。",
   "chapterId": "ch27",
   "tags": [
    "现值",
    "计算"
   ]
  },
  {
   "id": "f-ch27-02",
   "front": "净现值为什么是投资判据",
   "back": "NPV = 现值 − 初始投入；正的才值得做，不同时间的现金流必须先折算。",
   "chapterId": "ch27",
   "tags": [
    "现值"
   ]
  },
  {
   "id": "f-ch27-03",
   "front": "风险厌恶的含义",
   "back": "偏好确定的收益而非期望相同但波动大的收益；损失痛感大于同等收益的快乐。",
   "chapterId": "ch27",
   "tags": [
    "风险"
   ]
  },
  {
   "id": "f-ch27-04",
   "front": "保险为什么值得买",
   "back": "把不确定的大损失换成确定的小支出；保费高于期望赔付是保险公司的成本与利润。",
   "chapterId": "ch27",
   "tags": [
    "保险"
   ]
  },
  {
   "id": "f-ch27-05",
   "front": "企业特有风险与市场风险",
   "back": "前者可由多元化消除，后者影响全部资产、无法分散。",
   "chapterId": "ch27",
   "tags": [
    "风险"
   ]
  },
  {
   "id": "f-ch27-06",
   "front": "基本面分析与有效市场假说",
   "back": "前者估未来现金流现值，后者认为价格已反映公开信息；泡沫是后者的反例。",
   "chapterId": "ch27",
   "tags": [
    "资产评估"
   ]
  },
  {
   "id": "f-ch28-01",
   "front": "失业率与劳动参与率",
   "back": "失业率 = 失业 ÷ 劳动力；参与率 = 劳动力 ÷ 成年人口。放弃求职者退出劳动力会压低失业率。",
   "chapterId": "ch28",
   "tags": [
    "失业",
    "计算"
   ]
  },
  {
   "id": "f-ch28-02",
   "front": "三类失业及对策",
   "back": "摩擦性（信息与匹配，靠招聘服务）、结构性（技能错配，靠培训迁移）、周期性（需求不足，靠宏观政策）。",
   "chapterId": "ch28",
   "tags": [
    "失业"
   ]
  },
  {
   "id": "f-ch28-03",
   "front": "自然失业率",
   "back": "摩擦性与结构性失业对应的失业水平，是经济正常运转时的失业率。",
   "chapterId": "ch28",
   "tags": [
    "失业"
   ]
  },
  {
   "id": "f-ch28-04",
   "front": "效率工资的四个理由",
   "back": "改善体力、降低流动率、吸引更优秀员工、减少偷懒。",
   "chapterId": "ch28",
   "tags": [
    "工资"
   ]
  },
  {
   "id": "f-ch28-05",
   "front": "失业保险的两面",
   "back": "保障失业者生活，但降低求职紧迫性、延长失业持续时间。",
   "chapterId": "ch28",
   "tags": [
    "政策"
   ]
  },
  {
   "id": "f-ch29-01",
   "front": "货币的三项职能",
   "back": "交换媒介、计价单位、价值储藏。",
   "chapterId": "ch29",
   "tags": [
    "货币"
   ]
  },
  {
   "id": "f-ch29-02",
   "front": "M1 与 M2 的差别",
   "back": "M1 为现金加活期存款（流动性最高），M2 再加入定期存款与货币市场基金。",
   "chapterId": "ch29",
   "tags": [
    "货币"
   ]
  },
  {
   "id": "f-ch29-03",
   "front": "部分准备金制度与货币乘数",
   "back": "银行只留一部分存款作准备金，货币乘数 = 1 ÷ 准备金率；贷款创造存款。",
   "chapterId": "ch29",
   "tags": [
    "银行",
    "计算"
   ]
  },
  {
   "id": "f-ch29-04",
   "front": "央行三大工具",
   "back": "公开市场操作（最常用）、调整准备金率（作用猛烈）、调整利率。",
   "chapterId": "ch29",
   "tags": [
    "央行",
    "政策"
   ]
  },
  {
   "id": "f-ch29-05",
   "front": "现实货币乘数为何小于 1/R",
   "back": "现金漏出、银行自愿持有超额准备金、部分存款不进入可贷体系。",
   "chapterId": "ch29",
   "tags": [
    "银行",
    "易错"
   ]
  },
  {
   "id": "f-ch30-01",
   "front": "货币数量方程",
   "back": "M × V = P × Y；V 与 Y 相对稳定时，物价由货币量决定。",
   "chapterId": "ch30",
   "tags": [
    "通胀",
    "货币"
   ]
  },
  {
   "id": "f-ch30-02",
   "front": "为什么说通胀是货币现象",
   "back": "持续、普遍的物价上涨需要货币扩张支撑；单品涨价只是相对价格变化。",
   "chapterId": "ch30",
   "tags": [
    "通胀",
    "易错"
   ]
  },
  {
   "id": "f-ch30-03",
   "front": "通胀税为什么隐蔽且累退",
   "back": "不需立法即可征收，持有现金多的人（多为低收入者）损失比例更大。",
   "chapterId": "ch30",
   "tags": [
    "通胀税"
   ]
  },
  {
   "id": "f-ch30-04",
   "front": "费雪效应",
   "back": "名义利率随预期通胀同步上升，实际利率基本不变；只有意外通胀才重新分配财富。",
   "chapterId": "ch30",
   "tags": [
    "利率",
    "通胀"
   ]
  },
  {
   "id": "f-ch30-05",
   "front": "通胀的五项成本",
   "back": "皮鞋成本、菜单成本、税制扭曲、相对价格混乱、财富再分配。",
   "chapterId": "ch30",
   "tags": [
    "通胀"
   ]
  },
  {
   "id": "f-ch31-01",
   "front": "NX 与 NCF 的关系",
   "back": "NX = NCF；由 S = I + NX 得 NX = S − I。",
   "chapterId": "ch31",
   "tags": [
    "开放经济",
    "恒等式"
   ]
  },
  {
   "id": "f-ch31-02",
   "front": "贸易顺差的经济含义",
   "back": "储蓄大于投资，多余资金借给外国，形成资本净流出。",
   "chapterId": "ch31",
   "tags": [
    "开放经济",
    "易错"
   ]
  },
  {
   "id": "f-ch31-03",
   "front": "实际汇率公式",
   "back": "实际汇率 = 名义汇率 × 国内物价 ÷ 国外物价，衡量本国商品相对价格。",
   "chapterId": "ch31",
   "tags": [
    "汇率",
    "计算"
   ]
  },
  {
   "id": "f-ch31-04",
   "front": "购买力平价的逻辑与局限",
   "back": "靠套利拉平价格，但服务不可贸易、存在壁垒，因此长期部分成立、短期基本无效。",
   "chapterId": "ch31",
   "tags": [
    "汇率"
   ]
  },
  {
   "id": "f-ch32-01",
   "front": "开放经济两个市场",
   "back": "可贷资金市场定利率，外汇市场定汇率，中间由资本净流出连接。",
   "chapterId": "ch32",
   "tags": [
    "开放经济"
   ]
  },
  {
   "id": "f-ch32-02",
   "front": "赤字传导链",
   "back": "赤字 → 利率升 → 资本净流出减少 → 本币升值 → 净出口减少。",
   "chapterId": "ch32",
   "tags": [
    "开放经济",
    "政策"
   ]
  },
  {
   "id": "f-ch32-03",
   "front": "贸易政策为什么不改变贸易余额",
   "back": "进口减少使本币升值、出口同减；NX = S − I 未变，总量不变。",
   "chapterId": "ch32",
   "tags": [
    "贸易政策",
    "易错"
   ]
  },
  {
   "id": "f-ch32-04",
   "front": "资本外逃的两个后果",
   "back": "本币贬值（外汇市场本币供给增加）与利率上升（国内资金减少）。",
   "chapterId": "ch32",
   "tags": [
    "金融危机"
   ]
  },
  {
   "id": "f-ch32-05",
   "front": "判断政策对 NX 影响的快捷键",
   "back": "看它是否改变 S 或 I；不改变则 NX 不变，只改变汇率与构成。",
   "chapterId": "ch32",
   "tags": [
    "开放经济"
   ]
  },
  {
   "id": "f-ch33-01",
   "front": "经济波动的三个事实",
   "back": "无规律不可预测、多数宏观变量同向波动、产量下降时失业上升。",
   "chapterId": "ch33",
   "tags": [
    "波动"
   ]
  },
  {
   "id": "f-ch33-02",
   "front": "AD 向下的三个渠道",
   "back": "财富效应、利率效应、汇率效应。",
   "chapterId": "ch33",
   "tags": [
    "总需求"
   ]
  },
  {
   "id": "f-ch33-03",
   "front": "LRAS 为什么垂直",
   "back": "长期产量由资本、劳动、技术决定，价格水平只影响名义值。",
   "chapterId": "ch33",
   "tags": [
    "总供给"
   ]
  },
  {
   "id": "f-ch33-04",
   "front": "SRAS 向上倾斜的三个解释",
   "back": "粘性工资、粘性价格、对企业自身价格的错觉。",
   "chapterId": "ch33",
   "tags": [
    "总供给"
   ]
  },
  {
   "id": "f-ch33-05",
   "front": "需求冲击的短期与长期结果",
   "back": "短期产量与物价同升，长期产量回到自然率、只有物价上升。",
   "chapterId": "ch33",
   "tags": [
    "AD-AS",
    "易错"
   ]
  },
  {
   "id": "f-ch33-06",
   "front": "滞胀",
   "back": "供给冲击使 SRAS 左移，产量下降与物价上升同时发生，政策两难。",
   "chapterId": "ch33",
   "tags": [
    "滞胀"
   ]
  },
  {
   "id": "f-ch34-01",
   "front": "流动性偏好理论",
   "back": "货币需求随利率上升而减少，货币供给由央行决定，交点定利率。",
   "chapterId": "ch34",
   "tags": [
    "货币政策"
   ]
  },
  {
   "id": "f-ch34-02",
   "front": "货币政策传导链",
   "back": "货币供给增加 → 利率下降 → 投资增加 → 总需求右移。",
   "chapterId": "ch34",
   "tags": [
    "货币政策"
   ]
  },
  {
   "id": "f-ch34-03",
   "front": "支出乘数与税收乘数",
   "back": "支出乘数 1/(1−MPC)；税收乘数 −MPC/(1−MPC)，绝对值更小。",
   "chapterId": "ch34",
   "tags": [
    "财政政策",
    "计算"
   ]
  },
  {
   "id": "f-ch34-04",
   "front": "挤出效应",
   "back": "政府借款抬高利率、减少私人投资，削弱财政政策效果；衰退期较弱。",
   "chapterId": "ch34",
   "tags": [
    "财政政策"
   ]
  },
  {
   "id": "f-ch34-05",
   "front": "自动稳定器",
   "back": "累进所得税与转移支付随经济自动调节，无时滞、不受政治干扰，但只能缓冲。",
   "chapterId": "ch34",
   "tags": [
    "稳定政策"
   ]
  },
  {
   "id": "f-ch35-01",
   "front": "菲利普斯曲线的本质",
   "back": "AD-AS 模型的另一种画法：总需求扩张对应通胀升、失业降。",
   "chapterId": "ch35",
   "tags": [
    "菲利普斯曲线"
   ]
  },
  {
   "id": "f-ch35-02",
   "front": "短期与长期菲利普斯曲线",
   "back": "短期向下倾斜（意料之外的通胀能降失业），长期垂直（在自然失业率处）。",
   "chapterId": "ch35",
   "tags": [
    "菲利普斯曲线",
    "易错"
   ]
  },
  {
   "id": "f-ch35-03",
   "front": "自然率假说",
   "back": "无论通胀多高，失业最终回到自然率；1970 年代滞胀是其证据。",
   "chapterId": "ch35",
   "tags": [
    "菲利普斯曲线"
   ]
  },
  {
   "id": "f-ch35-04",
   "front": "牺牲率",
   "back": "降低 1 个百分点通胀所损失的年度产出百分比，经验值约 2–5。",
   "chapterId": "ch35",
   "tags": [
    "反通胀"
   ]
  },
  {
   "id": "f-ch35-05",
   "front": "理性预期为什么能降低反通胀代价",
   "back": "若央行可信地宣布并被执行，预期立即下调，工资价格同步调整，产量损失小。",
   "chapterId": "ch35",
   "tags": [
    "反通胀"
   ]
  },
  {
   "id": "f-ch35-06",
   "front": "滞胀在曲线上的表现",
   "back": "供给冲击使短期曲线右移，通胀与失业同时上升。",
   "chapterId": "ch35",
   "tags": [
    "滞胀"
   ]
  },
  {
   "id": "f-ch36-01",
   "front": "六个争论的清单",
   "back": "稳定经济？增支还是减税？规则还是相机抉择？零通胀目标？平衡预算？为储蓄改税？",
   "chapterId": "ch36",
   "tags": [
    "政策争论"
   ]
  },
  {
