 "cards": [
  {
   "id": "f01",
   "front": "`A * B` 与 `A @ B` 的区别？",
   "back": "`*` 逐元素相乘，要求形状一致或可广播；`@` 是矩阵乘法，要求内维相等。",
   "chapterId": "ch01",
   "tags": [
    "numpy"
   ]
  },
  {
   "id": "f02",
   "front": "广播从哪里开始对齐？",
   "back": "从最右边的维度开始，长度 1 或缺失的维可被扩展。",
   "chapterId": "ch01",
   "tags": [
    "numpy"
   ]
  },
  {
   "id": "f03",
   "front": "矩阵乘法 (m,n)@(n,p) 的结果形状？",
   "back": "(m,p)。",
   "chapterId": "ch01",
   "tags": [
    "numpy"
   ]
  },
  {
   "id": "f04",
   "front": "感知机的计算式？",
   "back": "a=w1x1+w2x2+b，a>0 输出 1，否则 0。",
   "chapterId": "ch02",
   "tags": [
    "perceptron"
   ]
  },
  {
   "id": "f05",
   "front": "偏置 b 的作用？",
   "back": "平移阈值，让决策直线不必过原点。",
   "chapterId": "ch02",
   "tags": [
    "perceptron"
   ]
  },
  {
   "id": "f06",
   "front": "异或为什么不能用单层感知机？",
   "back": "异或的正负样例在同一条对角线上，线性不可分。",
   "chapterId": "ch02",
   "tags": [
    "xor"
   ]
  },
  {
   "id": "f07",
   "front": "两层解异或的三个门怎么配？",
   "back": "第一层：与非门 + 或门；第二层：与门。",
   "chapterId": "ch02",
   "tags": [
    "xor"
   ]
  },
  {
   "id": "f08",
   "front": "为什么激活函数必须非线性？",
   "back": "否则多层线性变换等价于一次线性变换，加深没有意义。",
   "chapterId": "ch03",
   "tags": [
    "activation"
   ]
  },
  {
   "id": "f09",
   "front": "sigmoid 的导数怎么用函数值表示？",
   "back": "σ'(x)=σ(x)(1-σ(x))。",
   "chapterId": "ch03",
   "tags": [
    "activation"
   ]
  },
  {
   "id": "f10",
   "front": "ReLU 的定义与风险？",
   "back": "max(0,x)；输入长期为负会让梯度恒 0，神经元死亡。",
   "chapterId": "ch03",
   "tags": [
    "activation"
   ]
  },
  {
   "id": "f11",
   "front": "全连接层权重形状规则？",
   "back": "前一层神经元数 × 本层神经元数。",
   "chapterId": "ch03",
   "tags": [
    "layer"
   ]
  },
  {
   "id": "f12",
   "front": "交叉熵损失公式？",
   "back": "E=-Σ t_k log y_k，t 为 one-hot 标签。",
   "chapterId": "ch04",
   "tags": [
    "loss"
   ]
  },
  {
   "id": "f13",
   "front": "为什么分类用交叉熵而不用均方误差？",
   "back": "配 softmax 时梯度是 y-t，不会因饱和而消失。",
   "chapterId": "ch04",
   "tags": [
    "loss"
   ]
  },
  {
   "id": "f14",
   "front": "中心差分公式与误差阶？",
   "back": "f'(x)≈[f(x+h)-f(x-h)]/(2h)，误差 O(h²)。",
   "chapterId": "ch04",
   "tags": [
    "gradient"
   ]
  },
  {
   "id": "f15",
   "front": "梯度方向与更新方向的关系？",
   "back": "梯度指向损失上升最快方向，更新要取反方向。",
   "chapterId": "ch04",
   "tags": [
    "gradient"
   ]
  },
  {
   "id": "f16",
   "front": "学习率过大会出现什么现象？",
   "back": "损失震荡甚至发散。",
   "chapterId": "ch04",
   "tags": [
    "hyperparameter"
   ]
  },
  {
   "id": "f17",
   "front": "mini-batch 与 epoch 的关系？",
   "back": "每次抽一小批更新一次参数，遍历全部样本算一个 epoch。",
   "chapterId": "ch04",
   "tags": [
    "training"
   ]
  },
  {
   "id": "f18",
   "front": "链式法则一句话？",
   "back": "复合函数的导数是各段导数的乘积。",
   "chapterId": "ch05",
   "tags": [
    "backprop"
   ]
  },
  {
   "id": "f19",
   "front": "加法节点反向规则？",
   "back": "上游梯度原样分发给每个输入。",
   "chapterId": "ch05",
   "tags": [
    "backprop"
   ]
  },
  {
   "id": "f20",
   "front": "乘法节点反向规则？",
   "back": "对某个输入的梯度 = 上游梯度 × 另一个输入的值。",
   "chapterId": "ch05",
   "tags": [
    "backprop"
   ]
  },
  {
   "id": "f21",
   "front": "反向传播相对数值微分的优势？",
   "back": "一次前向+反向得到全部参数梯度，数值微分每个参数要两次前向。",
   "chapterId": "ch05",
   "tags": [
    "backprop"
   ]
  },
  {
   "id": "f22",
   "front": "sigmoid 导数上界与后果？",
   "back": "0.25；多层连乘导致梯度消失。",
   "chapterId": "ch05",
   "tags": [
    "vanishing"
   ]
  },
  {
   "id": "f23",
   "front": "层实现里 forward/backward 各做什么？",
   "back": "forward 算输出并缓存输入；backward 接收上游梯度并返回对输入的梯度。",
   "chapterId": "ch05",
   "tags": [
    "layer"
   ]
  },
  {
   "id": "f24",
   "front": "四种优化器的核心差别？",
   "back": "SGD 沿当前梯度；Momentum 加惯性；AdaGrad 按历史梯度缩放步长；Adam 两者合体。",
   "chapterId": "ch06",
   "tags": [
    "optimizer"
   ]
  },
  {
   "id": "f25",
   "front": "为什么权重不能全初始化为 0？",
   "back": "对称性未打破，同层神经元输出与梯度完全相同，等价于一个神经元。",
   "chapterId": "ch06",
   "tags": [
    "init"
   ]
  },
  {
   "id": "f26",
   "front": "Xavier 与 He 分别适合什么激活？",
   "back": "Xavier 适合 sigmoid/tanh；He 适合 ReLU。",
   "chapterId": "ch06",
   "tags": [
    "init"
   ]
  },
  {
   "id": "f27",
   "front": "Batch Norm 训练与推理的统计量差异？",
   "back": "训练用当前批的均值方差，推理用滑动平均。",
   "chapterId": "ch06",
   "tags": [
    "batchnorm"
   ]
  },
  {
   "id": "f28",
   "front": "Dropout 的倒置缩放为什么除以 1-p？",
   "back": "保持训练与推理的输出期望一致。",
   "chapterId": "ch06",
   "tags": [
    "dropout"
   ]
  },
  {
   "id": "f29",
   "front": "验证集与测试集的分工？",
   "back": "验证集挑超参数，测试集只在最后评估一次。",
   "chapterId": "ch06",
   "tags": [
    "dataset"
   ]
  },
  {
   "id": "f30",
   "front": "卷积输出尺寸公式？",
   "back": "(H-KH+2P)/S+1，P 为 padding，S 为步长。",
   "chapterId": "ch07",
   "tags": [
    "cnn"
   ]
  },
  {
   "id": "f31",
   "front": "padding 的常用目的是什么？",
   "back": "保住特征图尺寸，并让边缘被完整覆盖。",
   "chapterId": "ch07",
   "tags": [
    "cnn"
   ]
  },
  {
   "id": "f32",
   "front": "池化层有参数吗？",
   "back": "Max/Average 池化都没有可训练参数。",
   "chapterId": "ch07",
   "tags": [
    "pooling"
   ]
  },
  {
   "id": "f33",
   "front": "im2col 的思路？",
   "back": "把每个滑动窗口展成一列拼成大矩阵，用一次矩阵乘法完成卷积。",
   "chapterId": "ch07",
   "tags": [
    "im2col"
   ]
  },
  {
   "id": "f34",
   "front": "3→64 通道 3×3 卷积层的参数量？",
   "back": "3×3×3×64+64=1792。",
   "chapterId": "ch07",
   "tags": [
    "cnn"
   ]
  },
  {
   "id": "f35",
   "front": "深层网络为什么有效？",
   "back": "逐层抽象：像素→边缘→纹理→部件→物体。",
   "chapterId": "ch08",
   "tags": [
    "deep"
   ]
  },
  {
   "id": "f36",
   "front": "迁移学习两种用法？",
   "back": "冻结特征只训分类头；或全部微调但用很小学习率。",
   "chapterId": "ch08",
   "tags": [
    "transfer"
   ]
  },
  {
   "id": "f37",
   "front": "微调学习率为什么要小？",
   "back": "避免几步之内破坏预训练学到的通用特征。",
   "chapterId": "ch08",
   "tags": [
    "transfer"
   ]
  },
  {
   "id": "f38",
   "front": "GPU 加速深度学习的本质？",
   "back": "把大量矩阵乘法并行化。",
   "chapterId": "ch08",
   "tags": [
    "hardware"
   ]
  }
