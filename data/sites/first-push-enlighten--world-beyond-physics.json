 "cards": [
  {
   "id": "f001",
   "front": "第 1 章一句话核心是什么？",
   "back": "宇宙的粒子数与时间都有限，从未把可能的分子组合试完；因此生命不是被定律“算出来”的，而是在未遍历的空间里长出来的。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f002",
   "front": "数量级论证——一句话说清它是什么？",
   "back": "宇宙约 10^17 秒、10^80 个粒子。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f003",
   "front": "非遍历的含义——一句话说清它是什么？",
   "back": "**遍历**（ergodic）指系统最终会走遍所有状态。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f004",
   "front": "机器隐喻的破产——一句话说清它是什么？",
   "back": "把世界当机器，预设了“初始条件 + 定律 → 全部未来”。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f005",
   "front": "第 2 章一句话核心是什么？",
   "back": "功能是相对于“维持某个整体”而言的；物理只能给出结构，不能预言哪个结构会被选中成为功能，因此功能在出现前不可推导。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f006",
   "front": "功能的定义——一句话说清它是什么？",
   "back": "一个部件的作用由它在整体中的角色决定：眼睛的功能是看，因为它帮助生物体生存。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f007",
   "front": "不可预言性——一句话说清它是什么？",
   "back": "在眼睛出现前，物理不会告诉你“会有一种器官用于成像”。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f008",
   "front": "第 3 章一句话核心是什么？",
   "back": "生命传播的不是分子，而是“约束闭合”的组织：一组约束相互维持，使整体持续存在。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f009",
   "front": "约束闭合——一句话说清它是什么？",
   "back": "蒙特维尔与莫西奥的**约束闭合**（constraint closure）：每个约束由其他约束维持，整个集合自我维持。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f010",
   "front": "传播组织——一句话说清它是什么？",
   "back": "繁殖传下去的是这套闭环关系，不只是 DNA。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f011",
   "front": "与物理的区别——一句话说清它是什么？",
   "back": "物理系统可以有关闭的因果环（如反馈），但约束闭合强调“约束”这一层：不是变量在循环，而是维持循环的条件在互相生产。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f012",
   "front": "第 4 章一句话核心是什么？",
   "back": "DNA 是线性序列，按碱基配对复制；但生命是三维的约束闭合系统，序列只是其中一层信息。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f013",
   "front": "代码层——一句话说清它是什么？",
   "back": "A-T、C-G 配对使复制可靠。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f014",
   "front": "代码之外——一句话说清它是什么？",
   "back": "折叠、膜结构、代谢流、空间位置都不在序列里。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f015",
   "front": "第 5 章一句话核心是什么？",
   "back": "代谢是一张自催化网络：反应的产物反过来催化生成它的反应；网络靠外部能量梯度驱动，靠约束闭合维持。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f016",
   "front": "自催化——一句话说清它是什么？",
   "back": "**自催化集合**（autocatalytic set）：每个分子的生成至少被集合内另一个分子催化，整体不依赖外部催化剂。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f017",
   "front": "能量流——一句话说清它是什么？",
   "back": "自催化只解决“怎么维持结构”，还需要“怎么驱动”。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f018",
   "front": "第 6 章一句话核心是什么？",
   "back": "热泉边的脂质体在干湿交替中反复聚合、分裂，可能先形成能自我维持的膜结构，再容纳代谢与遗传。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f019",
   "front": "三步循环——一句话说清它是什么？",
   "back": "湿润时脂质体是囊泡。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f020",
   "front": "为什么膜先——一句话说清它是什么？",
   "back": "膜提供空间边界与浓度梯度，是约束闭合的物理前提。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f021",
   "front": "第 7 章一句话核心是什么？",
   "back": "自催化集体在分裂时会把组分分配不匀，产生组成差异；这种差异可被选择，因此遗传与变异可以早于 DNA 出现。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f022",
   "front": "分配不均——一句话说清它是什么？",
   "back": "囊泡分裂时，内部的分子的数量随机分配。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f023",
   "front": "选择的作用——一句话说清它是什么？",
   "back": "更稳定的集体分裂得更久、留下更多后代。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f024",
   "front": "第 8 章一句话核心是什么？",
   "back": "生命体的基本循环是：感知世界、评价对自身有利与否、采取行动；情绪是这三步最早整合成一体的形式。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f025",
   "front": "三和弦——一句话说清它是什么？",
   "back": "考夫曼借用凯瑟琳·考夫曼的说法：**感觉**（sense）、**评价**（evaluate）、**行动**（act）构成一个循环。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f026",
   "front": "情绪的位置——一句话说清它是什么？",
   "back": "情绪把“对我有利/有害”直接编码成可行动的状态，比符号推理更早。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f027",
   "front": "第 9 章一句话核心是什么？",
   "back": "选择作用于完整的生物体，基因只是搭车；生态位提供机会，但不导致新物种出现。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f028",
   "front": "选择单位——一句话说清它是什么？",
   "back": "道金斯式“自私的基因”把基因当选择单位。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f029",
   "front": "生态位——一句话说清它是什么？",
   "back": "**生态位**（niche）是生物在群落中的资源与角色。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f030",
   "front": "第 10 章一句话核心是什么？",
   "back": "演化不是“前者导致后者”，而是“前者使后者成为可能”；扩展适应就是旧结构被新用途征用。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f031",
   "front": "enablement vs entailment——一句话说清它是什么？",
   "back": "**使之成为可能**（enablement）：A 出现后，B 有了可行的路径，但 B 不是 A 的必然结果。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f032",
   "front": "扩展适应——一句话说清它是什么？",
   "back": "**扩展适应**（exaptation）：为一种功能演化的结构，被另一种功能征用。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f033",
   "front": "第 11 章一句话核心是什么？",
   "back": "经济像生物圈：每出现一种商品，就把一批新商品变成“相邻可能”；增长不是被算出来的，是被一步步打开的。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f034",
   "front": "相邻可能——一句话说清它是什么？",
   "back": "**相邻可能**（adjacent possible）：从当前状态出发，下一步可达到的状态集合。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f035",
   "front": "经济同构——一句话说清它是什么？",
   "back": "个人电脑使路由器与文件共享成为可能，后者使互联网、电商、搜索成为可能。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f036",
   "front": "理论的缺口——一句话说清它是什么？",
   "back": "主流增长理论把技术当外生变量或用生产函数拟合，无法解释“新商品从哪来”。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  }
