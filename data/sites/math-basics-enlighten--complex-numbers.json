 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "复数 z=2−3i 的实部与虚部分别是：",
   "options": [
    "2 和 3",
    "2 和 −3",
    "−3 和 2",
    "3 和 2"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "z=a+bi 中 a=2，b=−3（虚部是 b 本身，含符号）。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "i³ 的值是：",
   "options": [
    "i",
    "−i",
    "1",
    "−1"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "i³=i²·i=−1·i=−i。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "stem": "(2+i)(1−i) 的结果是：",
   "options": [
    "3−i",
    "3+i",
    "1−i",
    "1+i"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c02",
   "explain": "2−2i+i−i²=2−i+1=3−i。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "stem": "复数 z=3+4i 的模是：",
   "options": [
    "7",
    "5",
    "25",
    "1"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c02",
   "explain": "|z|=√(9+16)=5。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "stem": "复数 z=1+i 的模与辐角（主值）分别是：",
   "options": [
    "√2 和 45°",
    "2 和 45°",
    "√2 和 135°",
    "1 和 90°"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c02",
   "explain": "r=√(1+1)=√2，cosθ=1/√2，故 θ=45°。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "stem": "用棣莫弗定理计算 (1+i)⁴，结果是：",
   "options": [
    "4",
    "−4",
    "4i",
    "−4i"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c02",
   "explain": "模 √2 的四次方为 4，角 45°×4=180°，故结果为 4(cos180°+i sin180°)=−4。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q07",
   "chapterId": "__all__",
   "stem": "复数 (1+i)/(1−i) 的值是：",
   "options": [
    "i",
    "−i",
    "1",
    "−1"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "分子分母同乘 (1+i)：(1+i)²/(1+1)=(2i)/2=i。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q08",
   "chapterId": "__all__",
   "stem": "方程 x²+4=0 在复数范围内的解是：",
   "options": [
    "x=2",
    "x=±2i",
    "x=±2",
    "无解"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "x²=−4，故 x=±2i。",
   "misconception": "",
   "bookSource": null
  }
 ],
 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：数系扩张与复数概念」的一句话核心是什么？",
   "back": "引入 i 的唯一理由：让 x²+1=0 有解；复数就是 a+bi 的形式。",
   "chapterId": "ch01",
   "tags": [
    "complex-numbers",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：复数的运算与几何意义」的一句话核心是什么？",
   "back": "加减是向量平移，乘法是“模相乘、角相加”；除法靠共轭把分母变成实数。",
   "chapterId": "ch02",
   "tags": [
    "complex-numbers",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：三角形式与乘方开方」的一句话核心是什么？",
   "back": "写成 z=r(cosθ+i sinθ) 之后，乘除变成模的乘除与角的加减，乘方开方就是角的倍数与等分。",
   "chapterId": "ch03",
   "tags": [
    "complex-numbers",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "什么是「虚数单位」？",
   "back": "满足 i²=−1 的数 i。",
   "chapterId": "ch01",
   "tags": [
    "complex-numbers",
    "术语"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「复数」？",
   "back": "形如 a+bi 的数，a、b 为实数。",
   "chapterId": "ch01",
   "tags": [
    "complex-numbers",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「实部与虚部」？",
   "back": "复数 a+bi 中的 a 与 b。",
   "chapterId": "ch01",
   "tags": [
    "complex-numbers",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「共轭复数」？",
   "back": "实部相同、虚部相反的复数。",
   "chapterId": "ch02",
   "tags": [
    "complex-numbers",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「模」？",
   "back": "复数到原点的距离 √(a²+b²)。",
   "chapterId": "ch02",
   "tags": [
    "complex-numbers",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「复平面」？",
   "back": "横轴实轴、纵轴虚轴的坐标平面。",
   "chapterId": "ch02",
   "tags": [
    "complex-numbers",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「辐角」？",
   "back": "复数向量与实轴正方向的夹角。",
   "chapterId": "ch03",
   "tags": [
    "complex-numbers",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「三角形式」？",
   "back": "z=r(cosθ+i sinθ)。",
   "chapterId": "ch03",
   "tags": [
    "complex-numbers",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「棣莫弗定理」？",
   "back": "乘方公式 [r(cosθ+i sinθ)]ⁿ=rⁿ(cos nθ+i sin nθ)。",
   "chapterId": "ch03",
   "tags": [
    "complex-numbers",
    "术语"
   ]
  }
 ],
