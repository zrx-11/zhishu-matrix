 "glossary": [
  {
   "term": "Transformer",
   "en": "",
   "def": "由自注意力、FFN、残差和归一化堆叠成的序列模型骨架",
   "chapterIds": [
    "ch02"
   ]
  },
  {
   "term": "decoder-only",
   "en": "",
   "def": "只用因果解码器、按下一个 token 预测训练的架构",
   "chapterIds": [
    "ch02"
   ]
  },
  {
   "term": "encoder-decoder",
   "en": "",
   "def": "编码器双向读输入、解码器自回归生成的架构",
   "chapterIds": [
    "ch02"
   ]
  },
  {
   "term": "注意力",
   "en": "",
   "def": "让每个 token 根据相关性聚合其他 token 信息的机制",
   "chapterIds": [
    "ch02"
   ]
  },
  {
   "term": "自注意力",
   "en": "",
   "def": "Q/K/V 都来自同一序列的注意力",
   "chapterIds": [
    "ch02"
   ]
  },
  {
   "term": "因果掩码",
   "en": "",
   "def": "禁止 token 看到未来位置的掩码",
   "chapterIds": [
    "ch02"
   ]
  },
  {
   "term": "MHA",
   "en": "",
   "def": "每个 Q 头有独立 K/V 的多头注意力",
   "chapterIds": [
    "ch13"
   ]
  },
  {
   "term": "MQA",
   "en": "",
   "def": "所有 Q 头共享 1 组 K/V 的多查询注意力",
   "chapterIds": [
    "ch13"
   ]
  },
  {
   "term": "GQA",
   "en": "",
   "def": "Q 头分组共享 K/V 的分组查询注意力",
   "chapterIds": [
    "ch13"
   ]
  },
  {
   "term": "MLA",
   "en": "",
   "def": "把 K/V 压成低秩潜向量再投影的多头潜在注意力",
   "chapterIds": [
    "ch13"
   ]
  },
  {
   "term": "KV cache",
   "en": "",
   "def": "推理时缓存的 Key/Value，避免每步重算历史",
   "chapterIds": [
    "ch13"
   ]
  },
  {
   "term": "RoPE",
   "en": "",
   "def": "用旋转位置编码让注意力只看相对位置的方案",
   "chapterIds": [
    "ch13"
   ]
  },
  {
   "term": "YaRN",
   "en": "",
   "def": "通过改旋转频率/温度把上下文外推的方法",
   "chapterIds": [
    "ch13"
   ]
  },
  {
   "term": "ALiBi",
   "en": "",
   "def": "用距离线性偏置代替位置编码的方案",
   "chapterIds": [
    "ch08"
   ]
  },
  {
   "term": "sliding window",
   "en": "",
   "def": "每个 token 只看最近 W 个 token 的注意力",
   "chapterIds": [
    "ch05"
   ]
  },
  {
   "term": "局部/全局注意力",
   "en": "",
   "def": "多数层看局部窗口、少数层看全序列的交替设计",
   "chapterIds": [
    "ch06"
   ]
  },
  {
   "term": "RMSNorm",
   "en": "",
   "def": "只按均方根归一化、不减均值的归一化",
   "chapterIds": [
    "ch03"
   ]
  },
  {
   "term": "LayerNorm",
   "en": "",
   "def": "减均值、除标准差再仿射的归一化",
   "chapterIds": [
    "ch03"
   ]
  },
  {
   "term": "QK-Norm",
   "en": "",
   "def": "注意力前对 Q/K 做归一化，稳定大 head_dim 训练",
   "chapterIds": [
    "ch06"
   ]
  },
  {
   "term": "SwiGLU",
   "en": "",
   "def": "用 Swish 门控的两个线性投影组成的 FFN",
   "chapterIds": [
    "ch03"
   ]
  },
  {
   "term": "FFN",
   "en": "",
   "def": "Transformer 层里的前馈网络",
   "chapterIds": [
    "ch02"
   ]
  },
  {
   "term": "MoE",
   "en": "",
   "def": "把 FFN 拆成多个专家、每 token 只激活 top-k 的架构",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "router",
   "en": "",
   "def": "给每个 token 选择专家并输出权重的门控网络",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "top-k",
   "en": "",
   "def": "每个 token 只激活的专家数量",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "expert",
   "en": "",
   "def": "MoE 中独立的一套 FFN 参数",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "shared expert",
   "en": "",
   "def": "所有 token 都经过的通用专家",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "total params",
   "en": "",
   "def": "模型全部权重，决定显存",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "active params",
   "en": "",
   "def": "每 token 实际参与计算的权重，决定算力",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "expert parallelism",
   "en": "",
   "def": "把不同专家放到不同设备上的并行方式",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "load balancing",
   "en": "",
   "def": "让 token 均匀分配到专家的训练约束",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "dense",
   "en": "",
   "def": "每个 token 都走同一套 FFN 的模型",
   "chapterIds": [
    "ch11"
   ]
  },
  {
   "term": "sparse attention",
   "en": "",
   "def": "每 token 只和部分历史做注意力的机制",
   "chapterIds": [
    "ch13"
   ]
  },
  {
   "term": "DSA",
   "en": "",
   "def": "用索引器选 top-k 历史 token 的稀疏注意力",
   "chapterIds": [
    "ch13"
   ]
  },
  {
   "term": "linear attention",
   "en": "",
   "def": "用核函数/递归把注意力降到 O(n) 的方案",
   "chapterIds": [
    "ch10"
   ]
  },
  {
   "term": "SSM",
   "en": "",
   "def": "用固定状态递推建模序列的状态空间模型",
   "chapterIds": [
    "ch10"
   ]
  },
  {
   "term": "Mamba",
   "en": "",
   "def": "带选择性状态的空间状态模型",
   "chapterIds": [
    "ch10"
   ]
  },
  {
   "term": "RWKV",
   "en": "",
   "def": "RNN 化 Transformer，time-mix + channel-mix",
   "chapterIds": [
    "ch10"
   ]
  },
  {
   "term": "hybrid architecture",
   "en": "",
   "def": "线性/SSM 层与全注意力层混合的架构",
   "chapterIds": [
    "ch10"
   ]
  },
  {
   "term": "Jamba",
   "en": "",
   "def": "Transformer + Mamba 的混合模型",
   "chapterIds": [
    "ch10"
   ]
  },
  {
   "term": "Griffin",
   "en": "",
   "def": "RG-LRU + 局部注意力的混合模型",
   "chapterIds": [
    "ch10"
   ]
  },
  {
