 "cards": [
  {
   "id": "f01",
   "front": "有机化学的结构语言：一句话核心是什么？",
   "back": "有机分子靠碳骨架加官能团两件事描述；同一分子式画出不同骨架，就是不同物质。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f02",
   "front": "有机化学的结构语言最容易错在哪？",
   "back": "分子式相同不一定是同一种物质。",
   "chapterId": "ch01",
   "tags": [
    "ch01",
    "易错"
   ]
  },
  {
   "id": "f03",
   "front": "烷烃与构象：一句话核心是什么？",
   "back": "烷烃的 C—C 单键可以自由旋转，不同旋转角度形成不同构象；化学性质以自由基取代为主。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f04",
   "front": "烷烃与构象最容易错在哪？",
   "back": "构象不同不断键，是同一物质。",
   "chapterId": "ch02",
   "tags": [
    "ch02",
    "易错"
   ]
  },
  {
   "id": "f05",
   "front": "烯烃与亲电加成：一句话核心是什么？",
   "back": "C=C 由一个 σ 键和一个 π 键组成，π 电子云暴露在外，容易被亲电试剂进攻发生加成。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f06",
   "front": "烯烃与亲电加成最容易错在哪？",
   "back": "过氧化物存在下 HBr 加成是反马氏，是特例。",
   "chapterId": "ch03",
   "tags": [
    "ch03",
    "易错"
   ]
  },
  {
   "id": "f07",
   "front": "芳香烃、卤代烃与立体化学：一句话核心是什么？",
   "back": "苯环的 π 电子离域使体系特别稳定，倾向取代；手性来自四个不同基团连在同一个碳上。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f08",
   "front": "芳香烃、卤代烃与立体化学最容易错在哪？",
   "back": "R 不一定是右旋，S 不一定是左旋，必须实测。",
   "chapterId": "ch04",
   "tags": [
    "ch04",
    "易错"
   ]
  }
 ],
