    "可行性"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "可读性是工程要求，不在定义里。五条是有限性、确定性、输入、输出、可行性。",
   "misconception": "",
   "bookSource": null
  },
