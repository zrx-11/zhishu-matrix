   "bookSource": null
  },
  {
   "id": "q11",
   "chapterId": "ch04",
   "stem": "在单链表中删除 P 之后的节点 Q，第一步应做什么？",
   "options": [
    "释放 Q",
    "P.LINK = Q.LINK",
    "Q.LINK = P.LINK",
    "P.LINK = Q"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "先让 P 越过 Q 指向 Q 的后继，链才不断；之后才能释放 Q。若先释放 Q，就找不到 Q 的后继了。",
   "misconception": "",
   "bookSource": null
  },
