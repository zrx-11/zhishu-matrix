 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "极坐标 (2, π/2) 对应的直角坐标是：",
   "options": [
    "(2,0)",
    "(0,2)",
    "(0,−2)",
    "(−2,0)"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "x=2cos90°=0，y=2sin90°=2。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "圆心在极点、半径为 3 的圆的极坐标方程是：",
   "options": [
    "ρ=3",
    "ρ=6cosθ",
    "θ=3",
    "ρ=3cosθ"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c01",
   "explain": "到极点距离恒为 3，即 ρ=3。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "stem": "圆 x²+y²=9 的一个参数方程是：",
   "options": [
    "x=3cosθ，y=3sinθ",
    "x=9cosθ，y=9sinθ",
    "x=3θ，y=3θ",
    "x=cosθ，y=sinθ"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c01",
   "explain": "半径 3 的圆，参数方程 x=3cosθ、y=3sinθ。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "stem": "参数方程 x=t²，y=t（t≥0）化为普通方程是：",
   "options": [
    "y²=x（x≥0）",
    "y²=x（x∈R）",
    "y=x²",
    "x=y²"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c01",
   "explain": "t=√x≥0，y=√x，平方得 y²=x，且 x≥0。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "stem": "把 x=cosθ、y=sinθ 消参后得到：",
   "options": [
    "x²+y²=1",
    "x+y=1",
    "y=x",
    "x²−y²=1"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c01",
   "explain": "由 cos²θ+sin²θ=1 得 x²+y²=1。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "stem": "椭圆 x=3cosθ、y=2sinθ 上点到原点距离的最大值是：",
   "options": [
    "3",
    "2",
    "√13",
    "5"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c01",
   "explain": "距离平方 9cos²+4sin²=4+5cos²，最大 9，距离最大 3。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q07",
   "chapterId": "__all__",
