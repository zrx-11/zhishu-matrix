 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：极坐标」的一句话核心是什么？",
   "back": "极坐标用一个距离和一个角定位；同一个点有无穷多组极坐标。",
   "chapterId": "ch01",
   "tags": [
    "polar-parametric",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：参数方程」的一句话核心是什么？",
   "back": "参数方程用第三个变量 t（或 θ）同时表示 x 与 y，把曲线变成“随参数运动的一条轨迹”。",
   "chapterId": "ch02",
   "tags": [
    "polar-parametric",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：互化、范围与最值」的一句话核心是什么？",
   "back": "换表示是为了好算，不是为了好看；每次换完都要核对范围。",
   "chapterId": "ch03",
   "tags": [
    "polar-parametric",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "什么是「极坐标」？",
   "back": "用距离与极角表示点的坐标。",
   "chapterId": "ch01",
   "tags": [
    "polar-parametric",
    "术语"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「极点」？",
   "back": "极坐标的定点。",
   "chapterId": "ch01",
   "tags": [
    "polar-parametric",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「极轴」？",
   "back": "极坐标的基准射线。",
   "chapterId": "ch01",
   "tags": [
    "polar-parametric",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「互化」？",
   "back": "极坐标与直角坐标之间的转换。",
   "chapterId": "ch01",
   "tags": [
    "polar-parametric",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「参数方程」？",
   "back": "用参数 t 表示 x、y 的方程。",
   "chapterId": "ch02",
   "tags": [
    "polar-parametric",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「消参」？",
   "back": "从参数方程消去参数得到普通方程。",
   "chapterId": "ch02",
   "tags": [
    "polar-parametric",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「离心角」？",
   "back": "椭圆参数方程中的 θ。",
   "chapterId": "ch02",
   "tags": [
    "polar-parametric",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「增点」？",
   "back": "互化或消参后多出来的、不属于原曲线的点。",
   "chapterId": "ch03",
   "tags": [
    "polar-parametric",
    "术语"
   ]
  }
 ],
