 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "数据 3、5、5、7、10 的平均数是：",
   "options": [
    "5",
    "6",
    "7",
    "5.5"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "(3+5+5+7+10)/5=30/5=6。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "样本方差除以 n−1 而不是 n 的原因是：",
   "options": [
    "计算更方便",
    "修正用样本均值代替总体均值造成的偏差",
    "使方差变大",
    "避免除以零"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "除以 n−1 是自由度修正，使样本方差成为总体方差的无偏估计。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "stem": "掷一枚均匀骰子，出现偶数的概率是：",
   "options": [
    "1/6",
    "1/3",
    "1/2",
    "2/3"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "c02",
   "explain": "偶数有 2、4、6 共 3 个，P=3/6=1/2。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "stem": "若 A、B 相互独立，则 P(A∩B) 等于：",
   "options": [
    "P(A)+P(B)",
    "P(A)P(B)",
    "0",
    "P(A)−P(B)"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c02",
   "explain": "独立的定义就是乘法公式成立：P(A∩B)=P(A)P(B)。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "stem": "样本容量增大时，样本均值的标准误：",
   "options": [
    "增大",
    "减小",
    "不变",
    "先增后减"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "标准误约 s/√n，n 增大则减小。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "stem": "假设检验中拒绝原假设，意味着：",
   "options": [
    "原假设一定为假",
    "观测数据在原假设下很罕见",
    "样本有误",
    "总体不存在"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "拒绝的依据是数据在原假设下的罕见程度，并非直接证明原假设为假。",
   "misconception": "",
   "bookSource": null
  },
