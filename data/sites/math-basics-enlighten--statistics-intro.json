 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：数据的整理与描述」的一句话核心是什么？",
   "back": "一组数据用两个数就能大致说清：中心在哪里（均值），散得多开（方差）。",
   "chapterId": "ch01",
   "tags": [
    "statistics-intro",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：概率与计数」的一句话核心是什么？",
   "back": "古典概率＝有利结果数除以全部等可能结果数；互斥管相加，独立管相乘。",
   "chapterId": "ch02",
   "tags": [
    "statistics-intro",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：抽样与推断入门」的一句话核心是什么？",
   "back": "用样本推断总体，靠的是随机抽样保证代表性，用概率描述不确定性。",
   "chapterId": "ch03",
   "tags": [
    "statistics-intro",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "什么是「频数」？",
   "back": "某组数据的个数。",
   "chapterId": "ch01",
   "tags": [
    "statistics-intro",
    "术语"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「平均数」？",
   "back": "数据总和除以个数。",
   "chapterId": "ch01",
   "tags": [
    "statistics-intro",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「中位数」？",
   "back": "排序后位于中间位置的数。",
   "chapterId": "ch01",
   "tags": [
    "statistics-intro",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「方差」？",
   "back": "离差平方的平均数，衡量离散程度。",
   "chapterId": "ch01",
   "tags": [
    "statistics-intro",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「标准差」？",
   "back": "方差的算术平方根。",
   "chapterId": "ch01",
   "tags": [
    "statistics-intro",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「古典概率」？",
   "back": "有利结果数与等可能结果总数之比。",
   "chapterId": "ch02",
   "tags": [
    "statistics-intro",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「互斥」？",
   "back": "两个事件不能同时发生。",
   "chapterId": "ch02",
   "tags": [
    "statistics-intro",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「独立」？",
   "back": "一个事件发生不影响另一个的概率。",
   "chapterId": "ch02",
   "tags": [
    "statistics-intro",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「随机抽样」？",
   "back": "每个个体被抽到机会相同的抽样方式。",
   "chapterId": "ch03",
   "tags": [
    "statistics-intro",
    "术语"
   ]
  },
  {
   "id": "f13",
   "front": "什么是「标准误」？",
   "back": "样本均值的标准差，约 s/√n。",
   "chapterId": "ch03",
   "tags": [
    "statistics-intro",
    "术语"
   ]
  }
 ],
