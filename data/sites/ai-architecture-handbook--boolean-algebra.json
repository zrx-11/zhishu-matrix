 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：命题与真值表」的一句话核心是什么？",
   "back": "逻辑代数只有两个值；一切复合命题都能用真值表穷举验证。",
   "chapterId": "ch01",
   "tags": [
    "boolean-algebra",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：逻辑恒等式与化简」的一句话核心是什么？",
   "back": "化简的目标是用最少的“与”“或”项实现同一个逻辑功能；德摩根律是取反的关键。",
   "chapterId": "ch02",
   "tags": [
    "boolean-algebra",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：开关电路与逻辑门」的一句话核心是什么？",
   "back": "串联对应与，并联对应或，常闭触点对应非；逻辑表达式就是电路图。",
   "chapterId": "ch03",
   "tags": [
    "boolean-algebra",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "什么是「逻辑变量」？",
   "back": "只取 0 或 1 的变量。",
   "chapterId": "ch01",
   "tags": [
    "boolean-algebra",
    "术语"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「与」？",
   "back": "两者都真才为真的运算。",
   "chapterId": "ch01",
   "tags": [
    "boolean-algebra",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「或」？",
   "back": "有一个真就为真的运算。",
   "chapterId": "ch01",
   "tags": [
    "boolean-algebra",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「非」？",
   "back": "真假互换的运算。",
   "chapterId": "ch01",
   "tags": [
    "boolean-algebra",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「蕴含」？",
   "back": "A→B，只有 A 真 B 假时为假。",
   "chapterId": "ch01",
   "tags": [
    "boolean-algebra",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「真值表」？",
   "back": "穷举所有取值组合列出结果的表。",
   "chapterId": "ch01",
   "tags": [
    "boolean-algebra",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「德摩根律」？",
   "back": "取反时与或互换、各项取反。",
   "chapterId": "ch02",
   "tags": [
    "boolean-algebra",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「卡诺图」？",
   "back": "按格雷码排列、用圈相邻格化简的图。",
   "chapterId": "ch02",
   "tags": [
    "boolean-algebra",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「逻辑门」？",
   "back": "执行基本逻辑运算的电子元件。",
   "chapterId": "ch03",
   "tags": [
    "boolean-algebra",
    "术语"
   ]
  },
  {
   "id": "f13",
   "front": "什么是「万能门」？",
   "back": "能实现全部基本逻辑功能的门，如与非门。",
   "chapterId": "ch03",
   "tags": [
    "boolean-algebra",
    "术语"
   ]
  }
 ],
