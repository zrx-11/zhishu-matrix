  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "逻辑运算 1+1 的结果是：",
   "options": [
    "0",
    "1",
    "2",
    "无定义"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "或运算只要有一个为真结果就为真，故 1+1=1。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "A→B 等价于：",
