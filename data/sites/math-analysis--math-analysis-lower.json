   "front": "点态与一致收敛的区别",
   "back": "点态 N 依赖 x；一致收敛 N 只依赖 ε，对所有 x 通用。",
   "chapterId": "ch13",
   "tags": [
    "一致收敛"
   ]
  },
  {
   "id": "f04",
   "front": "M 判别法",
   "back": "|u_n(x)|≤M_n 且 ∑M_n 收敛，则函数项级数一致收敛。",
   "chapterId": "ch13",
   "tags": [
    "一致收敛"
   ]
  },
  {
   "id": "f05",
   "front": "收敛半径公式",
   "back": "R=1/L，L 为相邻系数比或根值的极限。",
   "chapterId": "ch14",
   "tags": [
    "幂级数"
   ]
  },
  {
   "id": "f06",
   "front": "五个常用展开式",
   "back": "e^x、sin x、cos x、ln(1+x)、(1+x)^α。",
   "chapterId": "ch14",
   "tags": [
    "幂级数"
   ]
  },
  {
   "id": "f07",
   "front": "傅里叶系数公式",
   "back": "a_n=1/π∫f cos nx dx，b_n=1/π∫f sin nx dx。",
   "chapterId": "ch15",
   "tags": [
    "傅里叶"
   ]
  },
  {
   "id": "f08",
   "front": "收敛定理三条",
   "back": "连续点收敛 f，间断点收敛左右平均，端点同理。",
   "chapterId": "ch15",
   "tags": [
    "傅里叶"
   ]
  },
  {
   "id": "f09",
   "front": "证明二重极限不存在的方法",
   "back": "找两条路径给不同极限，如 y=kx。",
   "chapterId": "ch16",
   "tags": [
    "多元极限"
   ]
  },
  {
   "id": "f10",
   "front": "重极限与累次极限的关系",
   "back": "重极限存在可推出累次极限相等，反之不成立。",
   "chapterId": "ch16",
   "tags": [
    "多元极限"
   ]
  },
  {
   "id": "f11",
   "front": "可微的充分条件",
   "back": "偏导存在且连续（不是必要条件）。",
   "chapterId": "ch17",
   "tags": [
    "微分"
   ]
  },
  {
   "id": "f12",
   "front": "方向导数与梯度",
   "back": "方向导数等于梯度与单位方向向量的内积。",
   "chapterId": "ch17",
   "tags": [
    "微分"
   ]
  },
  {
   "id": "f13",
   "front": "隐函数求导公式",
   "back": "y'=-F_x/F_y，要求 F_y≠0。",
   "chapterId": "ch18",
   "tags": [
    "隐函数"
   ]
  },
  {
   "id": "f14",
   "front": "条件极值的方程组",
   "back": "∇f=λ∇g，联合约束 g=0 求解。",
   "chapterId": "ch18",
   "tags": [
    "极值"
   ]
  },
  {
   "id": "f15",
   "front": "Γ 函数递推",
   "back": "Γ(s+1)=sΓ(s)，Γ(n+1)=n!，Γ(1/2)=√π。",
   "chapterId": "ch19",
   "tags": [
    "欧拉积分"
   ]
  },
  {
   "id": "f16",
   "front": "B 函数与 Γ 函数的关系",
   "back": "B(p,q)=Γ(p)Γ(q)/Γ(p+q)。",
   "chapterId": "ch19",
   "tags": [
    "欧拉积分"
   ]
  },
  {
   "id": "f17",
   "front": "两类曲线积分的关系",
   "back": "∫Pdx+Qdy=∫(P cosα+Q cosβ)ds。",
   "chapterId": "ch20",
   "tags": [
    "曲线积分"
   ]
  },
  {
   "id": "f18",
   "front": "第二型曲线积分的计算",
   "back": "参数化后 ∫[P x'(t)+Q y'(t)]dt，方向由参数方向定。",
   "chapterId": "ch20",
   "tags": [
    "曲线积分"
   ]
  },
  {
   "id": "f19",
   "front": "格林公式",
   "back": "∮Pdx+Qdy=∬(Q_x-P_y)dσ，L 取正向。",
   "chapterId": "ch21",
   "tags": [
    "重积分"
   ]
  },
  {
   "id": "f20",
   "front": "路径无关的条件",
   "back": "单连通区域上 Q_x=P_y，存在势函数。",
   "chapterId": "ch21",
   "tags": [
    "重积分"
   ]
  },
  {
   "id": "f21",
   "front": "球面坐标雅可比",
   "back": "ρ²sinφ，不要与柱面的 r 混淆。",
   "chapterId": "ch21",
   "tags": [
    "重积分"
   ]
  },
  {
   "id": "f22",
   "front": "高斯公式",
   "back": "∯P dydz+Q dzdx+R dxdy=∭(P_x+Q_y+R_z)dV，取外侧。",
   "chapterId": "ch22",
   "tags": [
    "曲面积分"
   ]
  },
  {
   "id": "f23",
   "front": "斯托克斯公式",
   "back": "∮Pdx+Qdy+Rdz=∬(∇×F)·n dS，右手系定向。",
   "chapterId": "ch22",
   "tags": [
    "曲面积分"
   ]
  },
  {
   "id": "f24",
   "front": "向量函数可微的定义",
   "back": "Δf=JΔx+o(‖Δx‖)，J 是雅可比矩阵。",
   "chapterId": "ch23",
   "tags": [
    "向量微分"
   ]
  }
