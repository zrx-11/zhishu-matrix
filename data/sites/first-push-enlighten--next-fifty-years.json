 "cards": [
  {
   "id": "f001",
   "front": "第 1 章一句话核心是什么？",
   "back": "宇宙的结局取决于暗能量的密度与性质：若它保持恒定，膨胀会一直加速，星系彼此远离，夜空越来越空。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f002",
   "front": "三种结局——一句话说清它是什么？",
   "back": "**封闭**：引力最终拉住膨胀，宇宙回缩。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f003",
   "front": "推演的前提——一句话说清它是什么？",
   "back": "这个结论依赖两条：暗能量的密度近似恒定（宇宙常数），以及广义相对论在大尺度上成立。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f004",
   "front": "第 2 章一句话核心是什么？",
   "back": "未来五十年的地外生命搜索会先从太阳系内的微生物级证据开始：火星、木卫二、土卫六；智慧信号搜索仍是最不确定的一项。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f005",
   "front": "候选地点——一句话说清它是什么？",
   "back": "火星：曾有液态水，地下可能有盐水。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f006",
   "front": "为什么先找微生物——一句话说清它是什么？",
   "back": "微生物的痕迹（同位素比、有机分子分布）可以在样本里测出来。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f007",
   "front": "第 3 章一句话核心是什么？",
   "back": "数学有两个动力源：现实问题的刺激与纯粹想象；物理理论会更替，但为它发明的数学往往长期有效。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f008",
   "front": "两个源头——一句话说清它是什么？",
   "back": "一边是物理、工程、经济提出的问题逼出新工具（微积分、傅里叶分析、群论）。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f009",
   "front": "留下的数学——一句话说清它是什么？",
   "back": "牛顿力学被相对论修正，但微积分没被废。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f010",
   "front": "第 4 章一句话核心是什么？",
   "back": "预测未来的前提是看清现在；而现在的大部分被主流叙事遮住，作者要求先看清“阴影里的文化”，再谈五十年。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f011",
   "front": "阴影是什么——一句话说清它是什么？",
   "back": "指非西方、非主流、非文本化的知识传统：地方性技术、口传医学、被殖民史压掉的科学实践。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f012",
   "front": "为什么要回头看——一句话说清它是什么？",
   "back": "作者认为未来学容易变成主流文化的自我投射。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f013",
   "front": "第 5 章一句话核心是什么？",
   "back": "如果一块块把大脑换成人工部件，替换到哪一步“你”就不再是你？这个问题逼出的是同一性标准，而不是技术时间表。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f014",
   "front": "思想实验——一句话说清它是什么？",
   "back": "假设每次只换一小块，功能不变，记忆与性格都保留。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f015",
   "front": "两种标准——一句话说清它是什么？",
   "back": "**同一性**看构成材料（同一堆物质）。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f016",
   "front": "第 6 章一句话核心是什么？",
   "back": "儿童不是被动接收信息，而是自己造朴素理论来解释世界；研究这些理论怎么被修正，是理解学习机制的捷径。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f017",
   "front": "朴素理论——一句话说清它是什么？",
   "back": "幼儿会认为“重的物体沉得快”“月亮跟着自己走”。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f018",
   "front": "为什么值得研究——一句话说清它是什么？",
   "back": "成人已经忘了自己怎么学会的。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f019",
   "front": "第 7 章一句话核心是什么？",
   "back": "行为主义把学习看成刺激-反应的强化，无法解释儿童如何获得“规则”与“道德判断”；替代路线转向内部表征与发展的阶段结构。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f020",
   "front": "行为主义的三个前提——一句话说清它是什么？",
   "back": "①学习是刺激与反应的联结。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f021",
   "front": "道德发展——一句话说清它是什么？",
   "back": "替代路线关注儿童如何形成“应该/不应该”的规则，以及这些规则如何随年龄重组。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f022",
   "front": "第 8 章一句话核心是什么？",
   "back": "心理学研究的是会自我解释的人；被研究者的自我理解会随研究传播而改变，形成反馈环，这使心理学难以像物理那样稳定。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f023",
   "front": "内省与阶级——一句话说清它是什么？",
   "back": "早期心理学靠受过训练的内省者描述意识内容。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f024",
   "front": "反馈环——一句话说清它是什么？",
   "back": "当心理学结论进入大众文化，人们会按结论重新理解自己，下一次研究测到的就是改变后的对象。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f025",
   "front": "第 9 章一句话核心是什么？",
   "back": "行为遗传学发现多数心理特质有中等程度的遗传贡献；进化心理学解释这些倾向为何被选择。两者合起来说明幸福有生物基础，但不等于被基因定死。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f026",
   "front": "遗传贡献——一句话说清它是什么？",
   "back": "双生子研究把方差拆成遗传、共享环境、非共享环境三部分。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f027",
   "front": "进化解释——一句话说清它是什么？",
   "back": "进化心理学主张：情绪机制是被选择出来的适应，幸福不是目标，而是“接近目标”的信号。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f028",
   "front": "第 10 章一句话核心是什么？",
   "back": "抑郁在流行病学上持续上升，原因不单一：诊断标准放宽、社会压力结构变化、求助行为改变都在起作用，不能简单归因于“人变脆弱了”。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f029",
   "front": "上升的两种解释——一句话说清它是什么？",
   "back": "一是**诊断扩大**：标准变宽、筛查普及，原本不被计入的病例被统计进来。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f030",
   "front": "压力的角色——一句话说清它是什么？",
   "back": "作者强调长期压力对神经内分泌的影响，以及社会经济结构如何把压力分配到不同人群。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f031",
   "front": "第 11 章一句话核心是什么？",
   "back": "费米等人模拟一维非线性晶格，预期能量会均匀分布（热化），结果能量几乎原样返回初始状态；这个“复现”说明非线性系统不一定热化，复杂性理论因此有了新的问题。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f032",
   "front": "预期：热化——一句话说清它是什么？",
   "back": "按统计力学，非线性耦合会让能量在各模式间分配，最终趋于均分。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f033",
   "front": "结果：复现——一句话说清它是什么？",
   "back": "实际跑出来的是**复现**（recurrence）：能量在少数模式间来回，几乎回到初态。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f034",
   "front": "第 12 章一句话核心是什么？",
   "back": "生命不是某个神秘成分，而是一组能力的组合：自我复制、做功、维持低熵、响应环境；缺一项就不算完整生命。",
   "chapterId": "ch12",
   "tags": [
    "ch12"
   ]
  },
  {
   "id": "f035",
   "front": "操作性清单——一句话说清它是什么？",
   "back": "①自我复制。",
   "chapterId": "ch12",
   "tags": [
    "ch12"
   ]
  },
  {
   "id": "f036",
   "front": "边界案例——一句话说清它是什么？",
   "back": "病毒能复制但不在体外做功。",
   "chapterId": "ch12",
   "tags": [
    "ch12"
   ]
  },
  {
   "id": "f037",
   "front": "第 13 章一句话核心是什么？",
   "back": "DNA 测序的成本下降速度甚至快于摩尔定律；但读出序列不等于理解它，信息的获取与意义的解读是两件事。",
   "chapterId": "ch13",
   "tags": [
    "ch13"
   ]
  },
  {
   "id": "f038",
   "front": "成本曲线——一句话说清它是什么？",
   "back": "测序一个碱基的成本在二十年间下降了几个数量级，快于集成电路的翻倍节奏。",
   "chapterId": "ch13",
   "tags": [
    "ch13"
   ]
  },
  {
   "id": "f039",
   "front": "信息与意义——一句话说清它是什么？",
   "back": "知道一段 DNA 的序列，与知道它在什么条件下表达、编码什么功能，是两回事。",
   "chapterId": "ch13",
   "tags": [
    "ch13"
   ]
  },
  {
   "id": "f040",
   "front": "第 14 章一句话核心是什么？",
   "back": "合成生物学试图用标准化部件重造生命过程，它更像“第二次创生”，而不是“发现现成生命”。",
   "chapterId": "ch14",
   "tags": [
    "ch14"
   ]
  },
  {
   "id": "f041",
   "front": "标准化部件——一句话说清它是什么？",
   "back": "把基因、启动子、代谢通路做成可拼装的**生物砖**（biobrick），像电子元件一样组合。",
   "chapterId": "ch14",
   "tags": [
    "ch14"
   ]
  },
  {
   "id": "f042",
   "front": "风险与边界——一句话说清它是什么？",
   "back": "风险包括：意外释放、双重用途、生态竞争。",
   "chapterId": "ch14",
   "tags": [
    "ch14"
   ]
  },
  {
   "id": "f043",
   "front": "第 15 章一句话核心是什么？",
   "back": "计算机模型能反复运行、检验极限条件，但建模耗时且依赖假设；模型能跑不等于预测可信。",
   "chapterId": "ch15",
   "tags": [
    "ch15"
   ]
  },
  {
   "id": "f044",
   "front": "模型的优点——一句话说清它是什么？",
   "back": "可重复、可控制变量、可做现实中做不到的极限实验。",
   "chapterId": "ch15",
   "tags": [
    "ch15"
   ]
  },
  {
   "id": "f045",
   "front": "代价——一句话说清它是什么？",
   "back": "建模需要数月到数年。",
   "chapterId": "ch15",
   "tags": [
    "ch15"
   ]
  },
  {
   "id": "f046",
   "front": "第 16 章一句话核心是什么？",
   "back": "人机结合的历史就是不断把外部工具变成身体的一部分；真正让人不安的不是技术，而是“人”的边界被重画。",
   "chapterId": "ch16",
   "tags": [
    "ch16"
   ]
  },
  {
   "id": "f047",
   "front": "从眼镜到植入——一句话说清它是什么？",
   "back": "眼镜、助听器、起搏器都已是身体的一部分。",
   "chapterId": "ch16",
   "tags": [
    "ch16"
   ]
  },
  {
   "id": "f048",
   "front": "不安的来源——一句话说清它是什么？",
   "back": "作者认为不安来自世界观被挑战：伽利略把地球移出中心，达尔文把人放进动物谱系，人机结合把“人”放进可改造的谱系。",
   "chapterId": "ch16",
   "tags": [
    "ch16"
   ]
  },
  {
   "id": "f049",
   "front": "第 17 章一句话核心是什么？",
   "back": "化学已经能按需设计分子与材料；未来的突破更可能在“按功能设计”而非“发现新元素”。",
   "chapterId": "ch17",
   "tags": [
    "ch17"
   ]
  },
  {
   "id": "f050",
   "front": "从发现到设计——一句话说清它是什么？",
   "back": "早期化学靠发现天然物质，现代化学靠计算与合成设计目标分子：药物、聚合物、电池材料、超导体。",
   "chapterId": "ch17",
   "tags": [
    "ch17"
   ]
  },
  {
   "id": "f051",
   "front": "两类方向——一句话说清它是什么？",
   "back": "一是性能极限（更硬、更轻、更耐热）。",
   "chapterId": "ch17",
   "tags": [
    "ch17"
   ]
  },
  {
   "id": "f052",
   "front": "第 18 章一句话核心是什么？",
   "back": "智力不是单一可加总的量；教育、营养、技术都在改变认知表现，但“更聪明”是否等于“更好”，是另一个问题。",
   "chapterId": "ch18",
   "tags": [
    "ch18"
   ]
  },
  {
   "id": "f053",
   "front": "测量的局限——一句话说清它是什么？",
   "back": "IQ 测的是特定文化下的认知任务，能预测学业表现，但不能覆盖创造力、社会判断、实践智慧。",
   "chapterId": "ch18",
   "tags": [
    "ch18"
   ]
  },
  {
   "id": "f054",
   "front": "环境效应——一句话说清它是什么？",
   "back": "营养、教育年限、信息环境都能提升测验分数（弗林效应）。",
   "chapterId": "ch18",
   "tags": [
    "ch18"
   ]
  },
  {
   "id": "f055",
   "front": "第 19 章一句话核心是什么？",
   "back": "“奇点”说假定技术进步可无限指数外推，直到机器智能超越人；这个论证最薄弱处是“智能可以脱离载体无限加速”。",
   "chapterId": "ch19",
   "tags": [
    "ch19"
   ]
  },
  {
   "id": "f056",
   "front": "论证结构——一句话说清它是什么？",
   "back": "前提一：计算能力指数增长。",
   "chapterId": "ch19",
   "tags": [
    "ch19"
   ]
  },
  {
   "id": "f057",
   "front": "薄弱处——一句话说清它是什么？",
   "back": "物理限制（散热、材料）、经济限制（研发成本）、以及“智能”与“计算”是否等价，都是未决问题。",
   "chapterId": "ch19",
   "tags": [
    "ch19"
   ]
  },
  {
   "id": "f058",
   "front": "第 20 章一句话核心是什么？",
   "back": "计算正在从桌面搬进环境：信息贴在物体与地点上，随时可调用；结果是注意力被重新分配，隐私边界也被重画。",
   "chapterId": "ch20",
   "tags": [
    "ch20"
   ]
  },
  {
   "id": "f059",
   "front": "从桌面到环境——一句话说清它是什么？",
   "back": "**泛在计算**（ubiquitous computing）：传感器、标签、无线网络把信息嵌入日常空间。",
   "chapterId": "ch20",
   "tags": [
    "ch20"
   ]
  },
  {
   "id": "f060",
   "front": "代价——一句话说清它是什么？",
   "back": "注意力被切成碎片。",
   "chapterId": "ch20",
   "tags": [
    "ch20"
   ]
  },
  {
   "id": "f061",
   "front": "第 21 章一句话核心是什么？",
   "back": "脑成像能定位功能、比较差异，但不能直接读出“自我”；自我更像叙述与整合的产物，而不是某个脑区。",
   "chapterId": "ch21",
   "tags": [
    "ch21"
   ]
  },
  {
   "id": "f062",
   "front": "成像的边界——一句话说清它是什么？",
   "back": "fMRI 测的是血流变化，不是神经元放电。",
   "chapterId": "ch21",
   "tags": [
    "ch21"
   ]
  },
  {
   "id": "f063",
   "front": "自我的位置——一句话说清它是什么？",
   "back": "自我感来自记忆、身体感、社会角色的整合。",
   "chapterId": "ch21",
   "tags": [
    "ch21"
   ]
  },
  {
   "id": "f064",
   "front": "第 22 章一句话核心是什么？",
   "back": "同辈群体而非父母，是儿童社会化的主要环境；父母提供基因与家庭氛围，但人格的塑造更多发生在同伴之间。",
   "chapterId": "ch22",
   "tags": [
    "ch22"
   ]
  },
  {
   "id": "f065",
   "front": "群体社会化——一句话说清它是什么？",
   "back": "哈里斯的理论：儿童在家庭外发展“群体内”行为规范，同伴接纳与地位压力塑造社会行为。",
   "chapterId": "ch22",
   "tags": [
    "ch22"
   ]
  },
  {
   "id": "f066",
   "front": "争议——一句话说清它是什么？",
   "back": "批评者指出：父母仍通过选择居住地、学校、同伴圈间接影响。",
   "chapterId": "ch22",
   "tags": [
    "ch22"
   ]
  },
  {
   "id": "f067",
   "front": "第 23 章一句话核心是什么？",
   "back": "精神医学从镇静、到靶向神经递质、再到基因分型用药；药物能缓解症状，但不自动改变生活结构，因此与心理治疗长期并存。",
   "chapterId": "ch23",
   "tags": [
    "ch23"
   ]
  },
  {
   "id": "f068",
   "front": "三个阶段——一句话说清它是什么？",
   "back": "①偶然发现（锂盐、丙咪嗪）。",
   "chapterId": "ch23",
   "tags": [
    "ch23"
   ]
  },
  {
   "id": "f069",
   "front": "药与谈话——一句话说清它是什么？",
   "back": "药物改变生理状态，谈话改变解释与行为模式。",
   "chapterId": "ch23",
   "tags": [
    "ch23"
   ]
  },
  {
   "id": "f070",
   "front": "第 24 章一句话核心是什么？",
   "back": "可穿戴设备把治疗从诊室延伸到日常：持续记录生理与行为，随时干预；但它也把私人情绪变成可采集的数据。",
   "chapterId": "ch24",
   "tags": [
    "ch24"
   ]
  },
  {
   "id": "f071",
   "front": "从诊室到日常——一句话说清它是什么？",
   "back": "心率、睡眠、活动、语音语调都能被连续测量。",
   "chapterId": "ch24",
   "tags": [
    "ch24"
   ]
  },
  {
   "id": "f072",
   "front": "伦理边界——一句话说清它是什么？",
   "back": "数据归谁？保险公司能否读取？算法误判会不会造成伤害？作者的态度是：技术可行不等于应当无条件部署，需要明确同意与可解释性。",
   "chapterId": "ch24",
   "tags": [
    "ch24"
   ]
  },
  {
   "id": "f073",
   "front": "第 25 章一句话核心是什么？",
   "back": "现代医学的多数手段是修补与支持，而非根治；未来五十年的突破更可能来自早期诊断与机制干预，而不是更复杂的手术。",
   "chapterId": "ch25",
   "tags": [
    "ch25"
   ]
  },
  {
   "id": "f074",
   "front": "修补为主——一句话说清它是什么？",
   "back": "器官移植、搭桥、多数癌症治疗都是“把坏的部分换掉或切掉”，延长寿命但不消除病因。",
   "chapterId": "ch25",
   "tags": [
    "ch25"
   ]
  },
  {
   "id": "f075",
   "front": "根治的路径——一句话说清它是什么？",
   "back": "真正根治要靠机制：疫苗、抗生素、靶向药、基因治疗。",
   "chapterId": "ch25",
   "tags": [
    "ch25"
   ]
  }
 ],
