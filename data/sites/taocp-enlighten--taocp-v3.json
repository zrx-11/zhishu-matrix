 "cards": [
  {
   "id": "f01",
   "front": "逆序对是什么？平均有多少个？",
   "back": "前大后小的一对位置；n 个元素的平均逆序对数为 n(n−1)/4。",
   "chapterId": "ch01",
   "tags": [
    "组合性质"
   ]
  },
  {
   "id": "f02",
   "front": "插入排序的移动次数等于什么？",
   "back": "等于初始逆序对数，每次左移一格消除恰好一个逆序对。",
   "chapterId": "ch01",
   "tags": [
    "组合性质"
   ]
  },
  {
   "id": "f03",
   "front": "多重集排列的种数公式？",
   "back": "n! 除以各重复组阶乘之积，n!/(n1!n2!…nk!)。",
   "chapterId": "ch01",
   "tags": [
    "组合性质"
   ]
  },
  {
   "id": "f04",
   "front": "五类内部排序是哪五类？",
   "back": "插入、交换、选择、合并、分布。",
   "chapterId": "ch02",
   "tags": [
    "排序"
   ]
  },
  {
   "id": "f05",
   "front": "快排最坏 O(n²) 的典型触发条件？",
   "back": "输入已有序却取首元素当基准，每次划分极不均衡。",
   "chapterId": "ch02",
   "tags": [
    "排序"
   ]
  },
  {
   "id": "f06",
   "front": "堆排序为什么最坏也是 O(n log n)？",
   "back": "建堆 O(n)，之后每次下沉 O(log n)，共 n 次，与输入无关。",
   "chapterId": "ch02",
   "tags": [
    "排序"
   ]
  },
  {
   "id": "f07",
   "front": "哪种排序稳定且 O(n log n)，代价是什么？",
   "back": "合并排序；代价是需要 O(n) 额外空间。",
   "chapterId": "ch02",
   "tags": [
    "排序"
   ]
  },
  {
   "id": "f08",
   "front": "比较排序的下界怎么推？",
   "back": "比较树至少 n! 个叶子，高度 ≥ log2(n!)，约 n log2 n − 1.44n。",
   "chapterId": "ch03",
   "tags": [
    "下界"
   ]
  },
  {
   "id": "f09",
   "front": "5 个元素最坏最少比较几次？",
   "back": "7 次，因为 log2 120 ≈ 6.91，向上取整。",
   "chapterId": "ch03",
   "tags": [
    "下界"
   ]
  },
  {
   "id": "f10",
   "front": "0-1 原理说的是什么？",
   "back": "若排序网络能排好所有 2^n 种 0/1 输入，就能排好任意输入。",
   "chapterId": "ch03",
   "tags": [
    "排序网络"
   ]
  },
  {
   "id": "f11",
   "front": "外部排序的趟数公式？",
   "back": "ceil(log_k R)，R 是初始游程数，k 是合并路数。",
   "chapterId": "ch04",
   "tags": [
    "外部排序"
   ]
  },
  {
   "id": "f12",
   "front": "替代选择的平均游程长度是多少？",
   "back": "约 2P，P 是缓冲区可容纳的记录数。",
   "chapterId": "ch04",
   "tags": [
    "外部排序"
   ]
  },
  {
   "id": "f13",
   "front": "多阶段合并为什么需要不均匀分配？",
   "back": "磁带台数有限，需要始终留一台空带当输出，按 Fibonacci 式分配可做到。",
   "chapterId": "ch04",
   "tags": [
    "外部排序"
   ]
  },
  {
   "id": "f14",
   "front": "顺序查找与二分查找的平均代价？",
   "back": "顺序 (n+1)/2；二分约 log2 n，但要求有序且可随机访问。",
   "chapterId": "ch05",
   "tags": [
    "查找"
   ]
  },
  {
   "id": "f15",
   "front": "AVL 树的高度上界？",
   "back": "约 1.44 log2(n+2) − 0.33，最坏也有对数级保证。",
   "chapterId": "ch05",
   "tags": [
    "查找"
   ]
  },
  {
   "id": "f16",
   "front": "B 树为什么适合数据库索引？",
   "back": "扇出 m 大使层数为 log_m n，每层一次磁盘读，I/O 次数远少于二叉树。",
   "chapterId": "ch05",
   "tags": [
    "查找"
   ]
  },
  {
   "id": "f17",
   "front": "链地址法的平均查找长度？",
   "back": "成功约 1 + α/2，失败约 α，α 是装载因子。",
   "chapterId": "ch06",
   "tags": [
    "散列"
   ]
  },
  {
   "id": "f18",
   "front": "线性探测的平均查找长度与 α 的关系？",
   "back": "成功约 (1/2)(1 + 1/(1−α))，α 趋近 1 时急剧恶化。",
   "chapterId": "ch06",
   "tags": [
    "散列"
   ]
  }
 ],
 "glossary": [
  {
