   "tags": [
    "gtd"
   ]
  },
  {
   "id": "f46",
   "front": "λ 回报的定义？",
   "back": "G^λ=(1-λ)Σλ^{n-1}G_{t:t+n}。",
   "chapterId": "ch12",
   "tags": [
    "trace"
   ]
  },
  {
   "id": "f47",
   "front": "前向与后向视角的关系？",
   "back": "线性情形下数学等价，非线性下不等价。",
   "chapterId": "ch12",
   "tags": [
    "trace"
   ]
  },
  {
   "id": "f48",
   "front": "累积迹与替换迹的差别？",
   "back": "前者累加，后者置位。",
   "chapterId": "ch12",
   "tags": [
    "trace"
   ]
  },
  {
   "id": "f49",
   "front": "TD(λ) 两个端点分别是什么？",
   "back": "λ=0 是 TD(0)，λ=1 是 MC。",
   "chapterId": "ch12",
   "tags": [
    "trace"
   ]
  },
  {
   "id": "f50",
   "front": "策略梯度定理的表达式？",
   "back": "∇J=E[Σ∇logπ(A|S,θ)q(S,A)]。",
   "chapterId": "ch13",
   "tags": [
    "pg"
   ]
  },
  {
   "id": "f51",
   "front": "REINFORCE 的更新式？",
   "back": "θ←θ+αΣG_t∇logπ(A_t|S_t,θ)。",
   "chapterId": "ch13",
   "tags": [
    "pg"
   ]
  },
  {
   "id": "f52",
   "front": "基线为什么不引入偏差？",
   "back": "E[b(s)∇logπ]=0。",
   "chapterId": "ch13",
   "tags": [
    "pg"
   ]
  },
  {
   "id": "f53",
   "front": "连续动作策略怎么参数化？",
   "back": "输出高斯均值与标准差，动作从中采样。",
   "chapterId": "ch13",
   "tags": [
    "pg"
   ]
  },
  {
   "id": "f54",
   "front": "Actor-Critic 的分工？",
   "back": "actor 选动作，critic 估价值提供优势。",
   "chapterId": "ch13",
   "tags": [
    "actorcritic"
   ]
  },
  {
   "id": "f55",
   "front": "经典与操作性条件反射的差别？",
   "back": "前者是刺激—刺激联结，后者是行为—结果联结。",
   "chapterId": "ch14",
   "tags": [
    "psychology"
   ]
  },
  {
   "id": "f56",
   "front": "次级强化物与价值函数的关系？",
   "back": "次级强化物预测未来奖励，等价于价值估计。",
   "chapterId": "ch14",
   "tags": [
    "psychology"
   ]
  },
  {
   "id": "f57",
   "front": "多巴胺峰值为什么会前移？",
   "back": "价值从奖励时刻转移到预测刺激，对应 TD 学习收敛。",
   "chapterId": "ch15",
   "tags": [
    "neuro"
   ]
  },
  {
   "id": "f58",
   "front": "大脑与人工 RL 的主要差异？",
   "back": "大脑同时运行模型-free 与模型-based 两套决策。",
   "chapterId": "ch15",
   "tags": [
    "neuro"
   ]
  },
  {
   "id": "f59",
   "front": "AlphaGo 的三个组件？",
   "back": "策略网络、价值网络、蒙特卡洛树搜索。",
   "chapterId": "ch16",
   "tags": [
    "application"
   ]
  },
  {
   "id": "f60",
   "front": "策略网络与价值网络各解决什么问题？",
   "back": "前者缩搜索宽度，后者缩深度。",
   "chapterId": "ch16",
   "tags": [
    "application"
   ]
  },
  {
   "id": "f61",
   "front": "什么场景不适合用 RL？",
   "back": "一次性决策、标签充足、错误代价高且不可模拟。",
   "chapterId": "ch16",
   "tags": [
    "application"
   ]
  },
  {
   "id": "f62",
   "front": "深度 RL 的三个瓶颈？",
   "back": "样本效率、稳定性、探索。",
   "chapterId": "ch17",
   "tags": [
    "frontier"
   ]
  },
  {
   "id": "f63",
   "front": "DQN 的两个稳定化支柱？",
   "back": "经验回放与目标网络。",
   "chapterId": "ch17",
   "tags": [
    "frontier"
   ]
  },
  {
   "id": "f64",
   "front": "稀疏奖励的四种对策？",
   "back": "内在奖励、课程学习、示范数据、分层 RL。",
   "chapterId": "ch17",
   "tags": [
    "frontier"
   ]
