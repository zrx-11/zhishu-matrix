  },
  {
   "id": "f09",
   "front": "Dropout 推理时怎么处理？",
   "back": "全部神经元启用，不做缩放（倒置 dropout）。",
   "chapterId": "ch03",
   "tags": [
    "regularization"
   ]
  },
  {
   "id": "f10",
   "front": "梯度裁剪怎么做？",
   "back": "梯度范数超阈值时按 θ/||g|| 缩放。",
   "chapterId": "ch03",
   "tags": [
    "stability"
   ]
  },
  {
   "id": "f11",
   "front": "Module 封装了什么？",
   "back": "子层结构、参数登记、前向逻辑。",
   "chapterId": "ch04",
   "tags": [
    "module"
   ]
  },
  {
   "id": "f12",
   "front": "参数与超参数的区别？",
   "back": "参数由梯度更新，超参数由验证集选择。",
   "chapterId": "ch04",
   "tags": [
    "parameter"
   ]
  },
  {
   "id": "f13",
   "front": "自定义层为什么要显式登记参数？",
   "back": "优化器只遍历登记过的参数。",
   "chapterId": "ch04",
   "tags": [
    "layer"
   ]
  },
  {
   "id": "f14",
   "front": "卷积输出尺寸公式？",
   "back": "(H-K+2P)/S+1。",
   "chapterId": "ch05",
   "tags": [
    "cnn"
   ]
  },
  {
   "id": "f15",
   "front": "多通道卷积核的形状？",
   "back": "(输出通道, 输入通道, 核高, 核宽)。",
   "chapterId": "ch05",
   "tags": [
    "cnn"
   ]
  },
  {
   "id": "f16",
   "front": "1×1 卷积为什么有用？",
   "back": "等价于通道维全连接，可降维或升维且参数少。",
   "chapterId": "ch05",
   "tags": [
    "cnn"
   ]
  },
  {
   "id": "f17",
   "front": "池化反向传播规则？",
   "back": "梯度只传给正向取到最大值的位置。",
   "chapterId": "ch05",
   "tags": [
    "pooling"
   ]
  },
  {
   "id": "f18",
   "front": "LeNet 的结构要点？",
   "back": "两个卷积池化块 + 三个全连接层。",
   "chapterId": "ch05",
   "tags": [
    "lenet"
   ]
  },
  {
   "id": "f19",
   "front": "RNN 隐状态更新式？",
   "back": "h_t=φ(W_hh h_{t-1}+W_xh x_t+b_h)。",
   "chapterId": "ch06",
   "tags": [
    "rnn"
   ]
  },
  {
   "id": "f20",
   "front": "BPTT 梯度为什么会爆炸或消失？",
   "back": "沿时间连乘雅可比，范数大于 1 爆炸、小于 1 消失。",
   "chapterId": "ch06",
   "tags": [
    "bptt"
   ]
  },
  {
   "id": "f21",
   "front": "LSTM 细胞状态为什么能保留长程信息？",
   "back": "更新是加法，梯度可近似原样回传。",
   "chapterId": "ch06",
   "tags": [
    "lstm"
   ]
  },
  {
   "id": "f22",
   "front": "GRU 的两个门？",
   "back": "重置门与更新门。",
   "chapterId": "ch06",
   "tags": [
    "gru"
   ]
  },
  {
   "id": "f23",
   "front": "双向 RNN 的适用条件？",
   "back": "整段输入已知，不需要实时输出。",
   "chapterId": "ch06",
   "tags": [
    "rnn"
   ]
  },
  {
   "id": "f24",
   "front": "动量法的更新式？",
   "back": "v_t=βv_{t-1}+g_t，θ←θ-ηv_t。",
   "chapterId": "ch07",
   "tags": [
    "optimizer"
   ]
  },
  {
   "id": "f25",
   "front": "AdaGrad 与 RMSProp 的差别？",
   "back": "前者累加平方导致停滞，后者用指数移动平均。",
   "chapterId": "ch07",
   "tags": [
    "optimizer"
   ]
  },
  {
   "id": "f26",
   "front": "Adam 的偏置修正公式？",
   "back": "m̂=m/(1-β₁^t)，v̂=v/(1-β₂^t)。",
   "chapterId": "ch07",
   "tags": [
    "adam"
   ]
  },
  {
   "id": "f27",
   "front": "学习率预热的动机？",
   "back": "避免训练初期梯度过大导致发散。",
   "chapterId": "ch07",
   "tags": [
    "schedule"
   ]
  },
  {
   "id": "f28",
   "front": "数据并行与模型并行的区别？",
   "back": "前者分数据、每卡全模型；后者切模型、跨卡传中间结果。",
   "chapterId": "ch08",
   "tags": [
    "distributed"
   ]
  },
  {
   "id": "f29",
   "front": "显存不足的四种缓解手段？",
   "back": "减 batch、梯度累积、混合精度、重计算。",
   "chapterId": "ch08",
   "tags": [
    "memory"
   ]
  },
  {
   "id": "f30",
   "front": "异步计算的主要代价？",
   "back": "调试困难、计时需显式同步。",
   "chapterId": "ch08",
   "tags": [
    "performance"
   ]
  },
  {
   "id": "f31",
   "front": "图像增广为什么等价于正则？",
   "back": "扩大分布覆盖，逼模型学不变特征而非记忆位置。",
   "chapterId": "ch09",
   "tags": [
    "augmentation"
   ]
  },
  {
   "id": "f32",
   "front": "微调的标准流程？",
   "back": "加载预训练→换分类头→冻结或全解冻→小学习率训练。",
   "chapterId": "ch09",
   "tags": [
    "finetune"
   ]
  },
  {
   "id": "f33",
   "front": "锚框解决了什么问题？",
   "back": "把任意框回归变成相对参考框的小幅偏移回归。",
   "chapterId": "ch09",
   "tags": [
    "detection"
   ]
  },
  {
   "id": "f34",
   "front": "NMS 的流程？",
   "back": "按分数排序，保留最高，删除 IoU 超阈值的框，重复。",
   "chapterId": "ch09",
   "tags": [
    "detection"
   ]
  },
  {
   "id": "f35",
   "front": "语义分割与实例分割的差别？",
   "back": "前者同类不区分个体，后者区分。",
   "chapterId": "ch09",
   "tags": [
    "segmentation"
   ]
  },
  {
   "id": "f36",
   "front": "word2vec 的两种训练方式？",
   "back": "跳元模型 skip-gram 与连续词袋 CBOW。",
   "chapterId": "ch10",
   "tags": [
    "embedding"
   ]
  },
  {
   "id": "f37",
   "front": "负采样的核心思想？",
   "back": "把全词表 softmax 换成正例加少量负例的二分类。",
   "chapterId": "ch10",
   "tags": [
    "embedding"
   ]
  },
  {
   "id": "f38",
   "front": "GloVe 与 word2vec 的差异？",
   "back": "GloVe 拟合全局共现矩阵，word2vec 看局部窗口。",
   "chapterId": "ch10",
   "tags": [
    "embedding"
   ]
  },
  {
   "id": "f39",
   "front": "注意力的计算式？",
   "back": "α=softmax(score)，c=Σαh，按相关性加权求和。",
   "chapterId": "ch10",
   "tags": [
    "attention"
   ]
  },
  {
   "id": "f40",
   "front": "Transformer 自注意力公式？",
   "back": "softmax(QKᵀ/√d_k)V。",
   "chapterId": "ch10",
   "tags": [
    "transformer"
   ]
  },
  {
   "id": "f41",
   "front": "排错的第一顺位是什么？",
   "back": "形状。形状错必然导致后续全错。",
