 "cards": [
  {
   "id": "f01",
   "front": "R1-Zero 的两类奖励？",
   "back": "准确性奖励（答案对错）和格式奖励（推理/答案标签）。",
   "chapterId": "ch06",
   "tags": [
    "R1",
    "奖励"
   ]
  },
  {
   "id": "f02",
   "front": "GRPO 的优势怎么算？",
   "back": "（该回答奖励 - 组内均值）/ 组内标准差。",
   "chapterId": "ch06",
   "tags": [
    "R1",
    "GRPO"
   ]
  },
  {
   "id": "f03",
   "front": "“aha moment”指什么？",
   "back": "训练中模型自发出现停下来重新检查、反思的行为。",
   "chapterId": "ch06",
   "tags": [
    "R1",
    "现象"
   ]
  },
  {
   "id": "f04",
   "front": "R1-Zero 不能直接上线的原因？",
   "back": "可读性差、中英混杂、格式不合规。",
   "chapterId": "ch06",
   "tags": [
    "R1",
    "局限"
   ]
  },
  {
   "id": "f05",
   "front": "冷启动解决什么问题？",
   "back": "用几千条高质量长链推理稳定格式和可读性。",
   "chapterId": "ch07",
   "tags": [
    "R1",
    "冷启动"
   ]
  },
  {
   "id": "f06",
   "front": "R1 的四个训练阶段？",
   "back": "冷启动 SFT → 推理 RL → 拒绝采样 SFT → 推理+通用 RL。",
   "chapterId": "ch07",
   "tags": [
    "R1",
    "流程"
   ]
  },
  {
   "id": "f07",
   "front": "R1 的 SFT 数据规模？",
   "back": "约 80 万条，60 万推理 + 20 万通用。",
   "chapterId": "ch07",
   "tags": [
    "R1",
    "数据"
   ]
  },
  {
   "id": "f08",
   "front": "R1 蒸馏用什么数据、什么方式？",
   "back": "R1 生成并筛选约 8 万条，学生做 SFT。",
   "chapterId": "ch07",
   "tags": [
    "R1",
    "蒸馏"
   ]
  },
  {
   "id": "f09",
   "front": "CSA 的两个动作？",
   "back": "每 4 token 压 1 条 + top-k 稀疏选择。",
   "chapterId": "ch08",
   "tags": [
    "V4",
    "CSA"
   ]
  },
  {
   "id": "f10",
   "front": "HCA 为什么不做稀疏？",
   "back": "压缩到 1/128 后候选很少，稠密算也可接受。",
   "chapterId": "ch08",
   "tags": [
    "V4",
    "HCA"
   ]
  },
  {
   "id": "f11",
   "front": "mHC 为什么用双随机约束？",
   "back": "保证混合是凸组合，不放大信号，训练稳定。",
   "chapterId": "ch08",
   "tags": [
    "V4",
    "mHC"
   ]
  },
  {
   "id": "f12",
   "front": "Muon 和 AdamW 的核心区别？",
   "back": "Muon 对梯度矩阵整体正交化，AdamW 逐元素自适应。",
   "chapterId": "ch08",
   "tags": [
    "V4",
    "优化器"
   ]
  },
  {
   "id": "f13",
   "front": "CED 的 prefill 为什么能减半？",
   "back": "只算前 20 层编码器，解码器全局 KV 由 H20 投影。",
   "chapterId": "ch09",
   "tags": [
    "V4.1",
    "CED"
   ]
  },
  {
   "id": "f14",
   "front": "CSA2 的三种模式？",
   "back": "Full（完整算）、Reindex（复用 KV 重选 top-k）、Reuse（复用 KV 和索引）。",
   "chapterId": "ch09",
   "tags": [
    "V4.1",
    "CSA2"
   ]
  },
  {
   "id": "f15",
   "front": "Engram 怎么省计算？",
