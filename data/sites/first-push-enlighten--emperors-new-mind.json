 "cards": [
  {
   "id": "f001",
   "front": "第 1 章一句话核心是什么？",
   "back": "争论的焦点不是机器会不会算，而是“按规则运算”这件事本身能不能产生“感觉像什么”的经验；彭罗斯认为不能，而这需要论证而不是直觉。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f002",
   "front": "三种立场——一句话说清它是什么？",
   "back": "**强 AI**：只要程序足够好，运行它的机器就真的有理解与意识。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f003",
   "front": "中文房间：符号操作与理解——一句话说清它是什么？",
   "back": "塞尔设想：一个不懂中文的人关在屋里，按一本规则手册把中文符号拼成回答递出去。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f004",
   "front": "彭罗斯为什么不服——一句话说清它是什么？",
   "back": "他认为塞尔的反驳依赖直觉，而直觉可以被“系统整体有理解”这类说法绕开。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f005",
   "front": "第 2 章一句话核心是什么？",
   "back": "算法是有限、确定、机械的步骤；图灵机把这种步骤形式化，通用图灵机则说明“一台机器可以模拟任何机器”——这正是“计算等价于算法”的技术基础。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f006",
   "front": "算法：欧几里得的最大公约数——一句话说清它是什么？",
   "back": "求 21 与 15 的最大公约数：21 除 15 余 6。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f007",
   "front": "图灵机与通用性——一句话说清它是什么？",
   "back": "图灵机用纸带存数据、读写头按规则表操作、内部状态有限。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f008",
   "front": "不可计算：算法的边界——一句话说清它是什么？",
   "back": "停机问题说明存在算法无法判定的事。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f009",
   "front": "第 3 章一句话核心是什么？",
   "back": "数学对象不是人编出来的约定，而是独立存在的实在；我们通过“看出”它们的性质来发现真理，这种看出不是照着规则算。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f010",
   "front": "曼德博集：规则极简，边界无限复杂——一句话说清它是什么？",
   "back": "从 z=0 开始反复做 z→z²+c，看序列是否有界，有界的 c 涂黑。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f011",
   "front": "复数为什么“不自然”却真实——一句话说清它是什么？",
   "back": "复数由 i²=−1 引入，看似人为。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f012",
   "front": "三种世界的三角——一句话说清它是什么？",
   "back": "物理世界、数学世界、精神世界两两相连：物理世界由数学描述，精神能接触数学真理，数学又约束物理。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f013",
   "front": "第 4 章一句话核心是什么？",
   "back": "对任何足够强的一致形式系统，人总能看出“这句在本系统中不可证”是真的，而系统本身证不出它；因此人的洞察不能被任何一个固定系统（也就是任何算法）所包含。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f014",
   "front": "形式系统与哥德尔句——一句话说清它是什么？",
   "back": "把数学写成符号游戏：公理 + 推理规则。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f015",
   "front": "彭罗斯的转身——一句话说清它是什么？",
   "back": "哥德尔的结果本身只是限制机器。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f016",
   "front": "反驳与再反驳——一句话说清它是什么？",
   "back": "常见反驳：人可能出错、人也只是另一台机器、需要的系统可以逐级扩充。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f017",
   "front": "第 5 章一句话核心是什么？",
   "back": "经典物理把世界写成场与时空的几何：麦克斯韦方程让光成为电磁波，相对论则说明空间与时间不是绝对的背景，而是彼此耦合的舞台。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f018",
   "front": "麦克斯韦：把光收进电磁——一句话说清它是什么？",
   "back": "变化的电场生磁场，变化的磁场生电场，二者互相激发形成波，传播速度由两个常数算出，恰好等于光速。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f019",
   "front": "相对论：同时性是约定——一句话说清它是什么？",
   "back": "**狭义相对论**的两条公设：物理规律在所有惯性系相同、光速不变。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f020",
   "front": "相空间：把状态画成点——一句话说清它是什么？",
   "back": "一个系统的所有可能状态构成**相空间**，系统演化就是相空间里的一条轨迹。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f021",
   "front": "第 6 章一句话核心是什么？",
   "back": "量子力学的计算极其成功，但它对“测量时发生了什么”没有公认答案：叠加、坍缩、纠缠三件事放在一起，就逼出了哲学难题。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f022",
   "front": "叠加与测量——一句话说清它是什么？",
   "back": "**叠加**（superposition，白话：一个系统同时处于多个可能状态，直到被测量）。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f023",
   "front": "EPR 与贝尔——一句话说清它是什么？",
   "back": "爱因斯坦等人提出 EPR 论证：若两个粒子纠缠，测量一个立刻确定另一个，似乎需要“超距作用”，因此量子力学不完备。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f024",
   "front": "几种解释——一句话说清它是什么？",
   "back": "哥本哈根：测量就是边界，不问过程。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f025",
   "front": "第 7 章一句话核心是什么？",
   "back": "时间有方向，是因为宇宙从一个极特殊的低熵初始状态出发；这个特殊性不能由现有物理定律解释，彭罗斯把它归因于时空几何的初始约束。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f026",
   "front": "三种箭头——一句话说清它是什么？",
   "back": "热力学箭头：熵增。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f027",
   "front": "低熵初始条件——一句话说清它是什么？",
   "back": "大爆炸时宇宙的熵极低，才有后来的熵增空间。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f028",
   "front": "韦尔曲率假说——一句话说清它是什么？",
   "back": "彭罗斯提出：初始奇点的**韦尔曲率**（描述时空形状畸变的量）为零，而物质熵可以很高。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f029",
   "front": "第 8 章一句话核心是什么？",
   "back": "把量子力学与广义相对论放在一起，会在普朗克尺度上产生无法自洽的结论；量子引力就是为填补这一块而提出的理论，而彭罗斯希望它顺带解释坍缩。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f030",
   "front": "普朗克尺度——一句话说清它是什么？",
   "back": "在约 10^-35 米、10^-43 秒的尺度上，量子涨落与时空弯曲同样剧烈，现有两套理论都无法给出自洽描述。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f031",
   "front": "霍金辐射与黑洞熵——一句话说清它是什么？",
   "back": "黑洞会因视界附近的量子效应发出热辐射，温度与质量成反比。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f032",
   "front": "彭罗斯的取向——一句话说清它是什么？",
   "back": "他发展**扭量理论**与自旋网络，试图从组合结构重建时空。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f033",
   "front": "第 9 章一句话核心是什么？",
   "back": "大脑是物质系统：神经元以电化学信号传递信息，突触强度可塑；但“这些信号如何变成感觉”仍不是把线路图放大就能回答的问题。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f034",
   "front": "从神经元到网络——一句话说清它是什么？",
   "back": "**神经元**（neuron）接收突触输入，加权求和后超过阈值就发放**动作电位**，信号沿轴突传到下一个神经元。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f035",
   "front": "连接主义与符号主义——一句话说清它是什么？",
   "back": "符号 AI 把智能写成规则与符号操作。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f036",
   "front": "大脑里有没有“非算法”的位置——一句话说清它是什么？",
   "back": "彭罗斯的假设是：神经元之间的信号传递在微观上可能依赖量子相干，而量子坍缩是非算法的物理过程。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f037",
   "front": "第 10 章一句话核心是什么？",
   "back": "意识最难的部分不是智能行为，而是“感觉像什么”；彭罗斯把它接到量子坍缩上，提出意识发生在微管中的客观还原过程——这是一个可讨论但未证实的猜想。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f038",
   "front": "感受质与难问题——一句话说清它是什么？",
   "back": "**感受质**（qualia，白话：看到红色时那种“红”的感觉）无法用波长、频率、神经放电完整描述。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f039",
   "front": "Orch OR：三个环节——一句话说清它是什么？",
   "back": "①**Orch**：神经元微管中有序排列的分子结构，能维持量子相干。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f040",
   "front": "评价：大胆但未证实——一句话说清它是什么？",
   "back": "支持者认为它把物理与意识接在一个可检验的机制上。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  }
 ],
