 "cards": [
  {
   "id": "f01",
   "front": "二分查找对列表有什么硬性前提？",
   "back": "列表必须有序；无序时只能逐个排查 O(n)。",
   "chapterId": "ch01",
   "tags": [
    "二分查找"
   ]
  },
  {
   "id": "f02",
   "front": "含 n 个元素的有序列表二分查找最多几步？",
   "back": "log₂n 步。128 个元素 7 步，256 个 8 步。",
   "chapterId": "ch01",
   "tags": [
    "二分查找",
    "对数"
   ]
  },
  {
   "id": "f03",
   "front": "大O表示法看最糟还是最佳情况？",
   "back": "最糟情况——绝不会更差的上限承诺。",
   "chapterId": "ch01",
   "tags": [
    "大O"
   ]
  },
  {
   "id": "f04",
   "front": "从快到慢排：O(n) O(log n) O(n!) O(n²) O(n log n)",
   "back": "O(log n) < O(n) < O(n log n) < O(n²) < O(n!)",
   "chapterId": "ch01",
   "tags": [
    "大O"
   ]
  },
  {
   "id": "f05",
   "front": "旅行商 5 个城市有多少种路线？",
   "back": "5! = 120 种，对应 O(n!)。",
   "chapterId": "ch01",
   "tags": [
    "旅行商"
   ]
  },
  {
   "id": "f06",
   "front": "数组和链表各擅长什么？",
   "back": "数组随机读取 O(1) 快；链表插删 O(1) 快。",
   "chapterId": "ch02",
   "tags": [
    "数组",
    "链表"
   ]
  },
  {
   "id": "f07",
   "front": "数组索引从几开始？",
   "back": "从 0 开始，第 2 个元素在索引 1。",
   "chapterId": "ch02",
   "tags": [
    "索引"
   ]
  },
  {
   "id": "f08",
   "front": "选择排序为什么是 O(n²)？",
   "back": "每轮找最小 O(n) × 找 n 轮；常数 1/2 被省略。",
   "chapterId": "ch02",
   "tags": [
    "选择排序"
   ]
  },
  {
   "id": "f09",
   "front": "递归函数必须有哪两半？",
   "back": "递归条件（调自己）+ 基线条件（不再调自己）。",
   "chapterId": "ch03",
   "tags": [
    "递归"
   ]
  },
  {
   "id": "f10",
   "front": "栈是 FIFO 还是 LIFO？",
   "back": "LIFO 后进先出；队列才是 FIFO。",
   "chapterId": "ch03",
   "tags": [
    "栈",
    "队列"
   ]
  },
  {
   "id": "f11",
   "front": "无限递归会怎样？",
   "back": "调用栈无限增厚→栈溢出，程序崩溃。",
   "chapterId": "ch03",
   "tags": [
    "递归",
    "调用栈"
   ]
  },
  {
   "id": "f12",
   "front": "fact(5) = ?",
   "back": "120（5×4×3×2×1）。",
   "chapterId": "ch03",
   "tags": [
    "阶乘"
   ]
  },
  {
   "id": "f13",
   "front": "D&C 分而治之两步是什么？",
   "back": "①找最简基线条件；②每次递归缩小问题规模。",
   "chapterId": "ch04",
   "tags": [
    "分而治之"
   ]
  },
  {
   "id": "f14",
   "front": "快速排序的基线条件？",
   "back": "数组为空或只有 1 个元素（本来就有序）。",
   "chapterId": "ch04",
   "tags": [
    "快速排序"
   ]
  },
  {
   "id": "f15",
   "front": "快排平均/最糟时间？",
   "back": "平均 O(n log n)；最糟 O(n²)。",
   "chapterId": "ch04",
   "tags": [
    "快速排序"
   ]
  },
  {
   "id": "f16",
   "front": "为什么随机选基准值能避开最糟？",
   "back": "固定取首元素遇已排序输入每次分出空堆；随机选大致平分。",
   "chapterId": "ch04",
   "tags": [
    "快速排序"
   ]
  },
  {
   "id": "f17",
   "front": "散列表由哪两样拼成？",
   "back": "散列函数 + 数组；函数把键算成下标。",
   "chapterId": "ch05",
   "tags": [
    "散列表"
   ]
  },
  {
   "id": "f18",
   "front": "散列表平均/最糟操作时间？",
   "back": "平均 O(1)；最糟 O(n)（全撞车）。",
   "chapterId": "ch05",
   "tags": [
    "散列表"
   ]
  },
  {
   "id": "f19",
   "front": "填装因子超过多少要扩容？",
   "back": "0.7；扩容=数组翻倍+重新散列。",
   "chapterId": "ch05",
   "tags": [
    "散列表",
    "填装因子"
   ]
  },
  {
   "id": "f20",
   "front": "散列表三大用途？",
   "back": "模拟映射、防止重复、缓存。",
   "chapterId": "ch05",
   "tags": [
    "散列表"
   ]
  },
  {
   "id": "f21",
   "front": "两个键撞同一位置怎么办？",
   "back": "该位置挂链表（拉链法）；链表越短越快。",
   "chapterId": "ch05",
   "tags": [
    "散列表",
    "冲突"
   ]
  },
  {
   "id": "f22",
   "front": "图由哪两种零件组成？",
   "back": "节点和边；直接相连的互为邻居。",
   "chapterId": "ch06",
   "tags": [
    "图"
   ]
  },
  {
   "id": "f23",
   "front": "BFS 为什么必须用队列？",
   "back": "FIFO 保证一度关系先于二度被检查，找到段数最短。",
   "chapterId": "ch06",
   "tags": [
    "BFS",
    "队列"
   ]
  },
  {
   "id": "f24",
   "front": "BFS 为什么要已检查名单？",
   "back": "同一节点会被多次指向；不标记可能无限循环。",
   "chapterId": "ch06",
   "tags": [
    "BFS"
   ]
  },
  {
   "id": "f25",
   "front": "BFS 运行时间怎么写？",
   "back": "O(V+E)：V 个顶点各入队一次，E 条边各走一次。",
   "chapterId": "ch06",
   "tags": [
    "BFS",
    "大O"
   ]
  },
  {
   "id": "f26",
   "front": "什么是拓扑排序？",
   "back": "把依赖图排成被依赖者在前的有序列表。",
   "chapterId": "ch06",
   "tags": [
    "拓扑排序"
   ]
  },
  {
   "id": "f27",
   "front": "BFS 和狄克斯特拉各管哪种图？",
   "back": "BFS 管非加权图数段数；狄克斯特拉管加权图算总权重。",
   "chapterId": "ch07",
   "tags": [
    "最短路径"
   ]
  },
  {
   "id": "f28",
   "front": "狄克斯特拉四步？",
   "back": "选最便宜节点→更新邻居开销→重复→父节点回溯。",
   "chapterId": "ch07",
   "tags": [
    "狄克斯特拉"
   ]
  },
  {
   "id": "f29",
   "front": "负权边为什么让狄克斯特拉失效？",
   "back": "破坏了已处理节点不可能更便宜的假设。",
   "chapterId": "ch07",
   "tags": [
    "狄克斯特拉"
   ]
  },
  {
   "id": "f30",
   "front": "含负权边用什么算法？",
   "back": "贝尔曼-福德算法。",
   "chapterId": "ch07",
   "tags": [
    "最短路径"
   ]
  },
  {
   "id": "f31",
   "front": "什么是贪婪算法？",
   "back": "每步选局部最优，简单快但不保证全局最优。",
   "chapterId": "ch08",
   "tags": [
    "贪婪算法"
   ]
  },
  {
   "id": "f32",
   "front": "集合覆盖精确解/贪婪近似大O？",
   "back": "精确 O(2ⁿ)；贪婪近似 O(n²)。",
   "chapterId": "ch08",
   "tags": [
    "贪婪算法",
    "NP完全"
   ]
  },
  {
   "id": "f33",
   "front": "NP 完全两个经典代表？",
   "back": "旅行商问题（n!）和集合覆盖问题（2ⁿ）。",
   "chapterId": "ch08",
   "tags": [
    "NP完全"
   ]
  },
  {
   "id": "f34",
   "front": "遇到 NP 完全问题怎么应对？",
   "back": "别死磕精确解，直接设计贪婪近似算法。",
   "chapterId": "ch08",
   "tags": [
    "贪婪算法"
   ]
  },
  {
   "id": "f35",
   "front": "动态规划的核心结构？",
   "back": "一张网格：每行加一个对象，每格填子问题最优值。",
   "chapterId": "ch09",
   "tags": [
    "动态规划"
   ]
  },
  {
   "id": "f36",
   "front": "4 磅背包吉他/音响/笔记本最优解？",
   "back": "吉他+笔记本=4 磅/$3500，不是音响 $3000。",
   "chapterId": "ch09",
   "tags": [
    "动态规划",
    "背包"
   ]
  },
  {
   "id": "f37",
   "front": "动态规划适用前提？",
   "back": "子问题离散且彼此独立；互相依赖就建不了网格。",
   "chapterId": "ch09",
   "tags": [
    "动态规划"
   ]
  },
  {
   "id": "f38",
   "front": "子串和子序列公式在哪分支不同？",
   "back": "字母不同时：子串归 0；子序列取 max(上,左)。",
   "chapterId": "ch09",
   "tags": [
    "动态规划"
   ]
  },
  {
   "id": "f39",
   "front": "KNN 两步流程？",
   "back": "①抽特征坐标；②找最近 K 个邻居，分类投票/回归平均。",
   "chapterId": "ch10",
   "tags": [
    "KNN"
   ]
  },
  {
   "id": "f40",
   "front": "分类和回归的区别？",
   "back": "分类=编组投票；回归=预测数值（邻居平均）。",
   "chapterId": "ch10",
   "tags": [
    "KNN"
   ]
  },
  {
   "id": "f41",
   "front": "K 取多少的经验法则？",
   "back": "√N 个邻居。",
   "chapterId": "ch10",
   "tags": [
    "KNN"
   ]
  },
  {
   "id": "f42",
   "front": "为什么特征选择决定 KNN 成败？",
   "back": "特征必须与目标相关、不偏不倚；无关特征全是噪声。",
   "chapterId": "ch10",
   "tags": [
    "KNN",
    "特征"
   ]
  },
  {
   "id": "f43",
   "front": "布隆过滤器错报/漏报是什么意思？",
   "back": "可能错报（说在但不在）；绝不漏报（说不在就肯定不在）。",
   "chapterId": "ch11",
   "tags": [
    "布隆过滤器"
   ]
  },
  {
   "id": "f44",
   "front": "SHA 为什么能安全存密码？",
   "back": "单向：能从密码算散列值，不能反推。",
   "chapterId": "ch11",
   "tags": [
    "SHA",
    "安全"
   ]
  },
  {
   "id": "f45",
   "front": "MapReduce 的 map/reduce 各干什么？",
   "back": "map=逐元素同样处理；reduce=数组归并成一个值。",
   "chapterId": "ch11",
   "tags": [
    "MapReduce"
   ]
  },
  {
   "id": "f46",
   "front": "二叉查找树平均/最糟查找时间？",
   "back": "平均 O(log n)；不平衡退化 O(n)。",
   "chapterId": "ch11",
   "tags": [
    "树",
    "数据结构"
   ]
  }
