 "cards": [
  {
   "id": "f01",
   "front": "智能体的五个特征是什么？",
   "back": "自主性、主动性、响应性、工具使用、记忆与通信。",
   "chapterId": "ch00",
   "tags": [
    "ch00",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "智能体 = 什么 + 什么？",
   "back": "认知引擎（大语言模型）+ 架构（状态、工具、通信、控制流）。",
   "chapterId": "ch00",
   "tags": [
    "ch00",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "提示链的价值不在“多问几次”，而在于？",
   "back": "把一次不可验证的整体推断拆成若干可验证的局部转换，实现错误局部化。",
   "chapterId": "ch01",
   "tags": [
    "ch01",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "判断一步该不该拆出去的判据？",
   "back": "这一步的输出能否被独立验证。",
   "chapterId": "ch01",
   "tags": [
    "ch01",
    "核心"
   ]
  },
  {
   "id": "f05",
   "front": "路由与提示链的根本区别？",
   "back": "路由是运行时决定路径，提示链是路径写死。",
   "chapterId": "ch02",
   "tags": [
    "ch02",
    "核心"
   ]
  },
  {
   "id": "f06",
   "front": "路由器必须保留什么？为什么？",
   "back": "兜底分支；否则未匹配的输入会直接失败。",
   "chapterId": "ch02",
   "tags": [
    "ch02",
    "核心"
   ]
  },
  {
   "id": "f07",
   "front": "判断两个子任务能否并行的判据？",
   "back": "B 需不需要 A 的输出。",
   "chapterId": "ch03",
   "tags": [
    "ch03",
    "核心"
   ]
  },
  {
   "id": "f08",
   "front": "投票并行压不住哪类错误？",
   "back": "系统性错误——同一模型同上下文的错误高度相关，投票只会强化。",
   "chapterId": "ch03",
   "tags": [
    "ch03",
    "核心"
   ]
  },
  {
   "id": "f09",
   "front": "反思的结构本质是？",
   "back": "带一条回边的控制结构：产出→按判据检查→改→直到通过或达上限。",
   "chapterId": "ch04",
   "tags": [
    "ch04",
    "核心"
   ]
  },
  {
   "id": "f10",
   "front": "有判据的反思也必须有哪两个出口条件？",
   "back": "判据通过；轮次上限（实践 2~3 轮）。",
   "chapterId": "ch04",
   "tags": [
    "ch04",
    "核心"
   ]
  },
  {
   "id": "f11",
   "front": "工具循环里真正执行工具的是谁？",
   "back": "框架。模型只生成调用意图，不直接碰网络。",
   "chapterId": "ch05",
   "tags": [
    "ch05",
    "核心"
   ]
  },
  {
   "id": "f12",
   "front": "工具描述里最容易被漏写、却最能压低误触发的内容？",
   "back": "“什么情况下不要用这个工具”的负向说明。",
   "chapterId": "ch05",
   "tags": [
    "ch05",
    "核心"
   ]
  },
  {
   "id": "f13",
   "front": "三种计划形态怎么选？",
   "back": "看不确定性在哪一层：路径确定→清单；依赖复杂→DAG；边走边看→迭代。",
   "chapterId": "ch06",
   "tags": [
    "ch06",
    "核心"
   ]
  },
  {
   "id": "f14",
   "front": "重规划的三个触发条件？",
   "back": "连续失败达阈值（约 3 次）、判据不符、约束显式变化。",
   "chapterId": "ch06",
   "tags": [
    "ch06",
    "核心"
   ]
  },
  {
   "id": "f15",
   "front": "拆多智能体的三个正当理由？",
   "back": "上下文拥挤、角色能力冲突、错误无人对照。",
   "chapterId": "ch07",
   "tags": [
    "ch07",
    "核心"
   ]
  },
  {
   "id": "f16",
   "front": "批评-审查者的六类标准？",
   "back": "政策、安全、合规、正确性、质量、目标对齐。",
   "chapterId": "ch07",
   "tags": [
    "ch07",
    "核心"
   ]
  },
  {
   "id": "f17",
   "front": "短期记忆的三个限制？",
   "back": "容量有限、会话结束即失、每轮重复计费。",
   "chapterId": "ch08",
   "tags": [
    "ch08",
    "核心"
   ]
  },
  {
   "id": "f18",
   "front": "直接改 session.state 会带来什么问题？",
   "back": "绕过事件处理：不记录、不持久化、并发冲突、元数据不更新。",
   "chapterId": "ch08",
   "tags": [
    "ch08",
    "核心"
   ]
  },
  {
   "id": "f19",
   "front": "“它不懂我们公司的规矩”该用哪条学习路径？",
   "back": "记忆 + RAG（知识缺失），不是微调。",
   "chapterId": "ch09",
   "tags": [
    "ch09",
    "核心"
   ]
  },
  {
   "id": "f20",
   "front": "PPO 的裁剪切的是什么？",
   "back": "新旧策略的概率比，把它限制在 1±ε，防止单次更新步长过大。",
   "chapterId": "ch09",
   "tags": [
    "ch09",
    "核心"
   ]
  },
  {
   "id": "f21",
   "front": "MCP 解决的核心经济问题？",
   "back": "把 M×N 次定制集成压成 M+N 次。",
   "chapterId": "ch10",
   "tags": [
    "ch10",
    "核心"
   ]
  },
  {
   "id": "f22",
   "front": "MCP 救不了什么？",
   "back": "底层 API 不支持过滤、排序、文本返回的情况。",
   "chapterId": "ch10",
   "tags": [
    "ch10",
    "核心"
   ]
  },
  {
   "id": "f23",
   "front": "一个目标要成立，必须包含哪四样？",
   "back": "指标、阈值、时限、判定者。",
   "chapterId": "ch11",
   "tags": [
    "ch11",
    "核心"
   ]
  },
  {
   "id": "f24",
   "front": "监控的四个观测对象？",
   "back": "行为、环境、工具输出、判据。",
   "chapterId": "ch11",
   "tags": [
    "ch11",
    "核心"
   ]
  },
  {
   "id": "f25",
   "front": "重试的硬前提？",
   "back": "操作幂等；否则重试等于重复副作用。",
   "chapterId": "ch12",
   "tags": [
    "ch12",
    "核心"
   ]
  },
  {
   "id": "f26",
   "front": "“看起来成功的失败”典型例子？",
   "back": "返回结构合法但值为空（如 {\"stock\": null}），下游不校验就当成功。",
   "chapterId": "ch12",
   "tags": [
    "ch12",
    "核心"
   ]
  },
  {
   "id": "f27",
   "front": "是否插人的统一判据？",
   "back": "错了能不能撤回。",
   "chapterId": "ch13",
   "tags": [
    "ch13",
    "核心"
   ]
  },
  {
   "id": "f28",
   "front": "Human-on-the-loop 适合什么？",
   "back": "高频、单次价值低、规则可写清的场景。",
   "chapterId": "ch13",
   "tags": [
    "ch13",
    "核心"
   ]
  },
  {
   "id": "f29",
   "front": "余弦相似度为什么“只看方向”？",
   "back": "公式是 (a·b)/(‖a‖‖b‖),分母消掉了长度。",
   "chapterId": "ch14",
   "tags": [
    "ch14",
    "核心"
   ]
  },
  {
   "id": "f30",
   "front": "只设 top_k 不设阈值会怎样？",
   "back": "会把无关内容硬塞进上下文，比不检索更糟。",
   "chapterId": "ch14",
   "tags": [
    "ch14",
    "核心"
   ]
  },
  {
   "id": "f31",
   "front": "A2A 与 MCP 的分工？",
   "back": "A2A 接智能体（横向），MCP 接资源（向下）。",
   "chapterId": "ch15",
   "tags": [
    "ch15",
    "核心"
   ]
  },
  {
   "id": "f32",
   "front": "Agent Card 里 examples 字段为什么重要？",
   "back": "它告诉调用方“什么场景该找我”,直接降低误调用。",
   "chapterId": "ch15",
   "tags": [
    "ch15",
    "核心"
   ]
  },
  {
   "id": "f33",
   "front": "单次调用成本公式？",
   "back": "C = (T_in·p_in + T_out·p_out)/1000。",
   "chapterId": "ch16",
   "tags": [
    "ch16",
    "核心"
   ]
  },
  {
   "id": "f34",
   "front": "资源优化的两个闭环？",
   "back": "批判回流（慢，改策略）、回退（快，保可用）。",
   "chapterId": "ch16",
   "tags": [
    "ch16",
    "核心"
   ]
  },
  {
   "id": "f35",
   "front": "四种推理路径各解决什么？",
   "back": "CoT 给草稿纸；ToT 多路径搜索；ReAct 边查边算；PALMs 精确执行。",
   "chapterId": "ch17",
   "tags": [
    "ch17",
    "核心"
   ]
  },
  {
   "id": "f36",
   "front": "自洽投票成立的三个前提？",
   "back": "采样相对独立；有可用的筛选机制；错误不是系统性的。",
   "chapterId": "ch17",
   "tags": [
    "ch17",
    "核心"
   ]
  },
  {
   "id": "f37",
   "front": "唯一能挡住“做错事”的护栏层？",
   "back": "工具调用层——参数与权限校验。",
   "chapterId": "ch18",
   "tags": [
    "ch18",
    "核心"
   ]
  },
  {
   "id": "f38",
   "front": "结构性护栏校验的是什么？",
   "back": "输出的结构（字段、类型），不是内容合规。",
   "chapterId": "ch18",
   "tags": [
    "ch18",
    "核心"
   ]
  },
  {
   "id": "f39",
   "front": "为什么必须评轨迹？",
   "back": "结果对但过程违规、结果错但过程合理，只看结果都看不见。",
   "chapterId": "ch19",
   "tags": [
    "ch19",
    "核心"
   ]
  },
  {
   "id": "f40",
   "front": "LLM-as-a-Judge 的两个偏见？",
   "back": "位置偏见、自我偏好。",
   "chapterId": "ch19",
   "tags": [
    "ch19",
    "核心"
   ]
  },
  {
   "id": "f41",
   "front": "优先级排序是评价问题还是调度问题？",
   "back": "调度问题——资源有限时下一个做什么。",
   "chapterId": "ch20",
   "tags": [
    "ch20",
    "核心"
   ]
  },
  {
   "id": "f42",
   "front": "优先级通胀的解法？",
   "back": "配额，例如 P0 最多占 20% 并发槽位。",
   "chapterId": "ch20",
   "tags": [
    "ch20",
    "核心"
   ]
  },
  {
   "id": "f43",
   "front": "探索与优化的分界？",
   "back": "能否写出评分函数；写不出就是在探索。",
   "chapterId": "ch21",
   "tags": [
    "ch21",
    "核心"
   ]
  },
  {
   "id": "f44",
   "front": "AI 联合科学体为什么用 Elo？",
   "back": "假设质量无法绝对打分，只能两两比较。",
   "chapterId": "ch21",
   "tags": [
    "ch21",
    "核心"
   ]
  },
  {
   "id": "f45",
   "front": "“该停止加模式”的三个信号？",
   "back": "没有对应失败案例、评估指标没变好、故障面变大且不可观测。",
   "chapterId": "ch22",
   "tags": [
    "ch22",
    "核心"
   ]
  },
  {
   "id": "f46",
   "front": "21 个模式归为哪四组？",
   "back": "执行与任务分解、与外部环境交互、状态学习与自我提升、协作与沟通。",
   "chapterId": "ch22",
   "tags": [
    "ch22",
    "核心"
   ]
  },
  {
   "id": "f47",
   "front": "工具与技能的区别？",
   "back": "工具是外部接口（能调的），技能是集成能力（会做的）。",
   "chapterId": "ch23",
   "tags": [
    "ch23",
    "核心"
   ]
  },
  {
   "id": "f48",
   "front": "提示链为什么不足以替代反思？",
   "back": "把输出喂给下一步往往只是重述，反思需要结构化批评与外部判据。",
   "chapterId": "ch23",
   "tags": [
    "ch23",
    "核心"
   ]
  },
  {
   "id": "f49",
   "front": "正面指令为什么优于约束？",
   "back": "约束会让模型聚焦规避风险，输出变保守；目标明确的指令更有效。",
   "chapterId": "ch24",
   "tags": [
    "ch24",
    "核心"
   ]
  },
  {
   "id": "f50",
   "front": "要求 JSON 之后还必须做什么？",
   "back": "结构性校验（Pydantic），并对失败重试。",
   "chapterId": "ch24",
   "tags": [
    "ch24",
    "核心"
   ]
  },
  {
   "id": "f51",
