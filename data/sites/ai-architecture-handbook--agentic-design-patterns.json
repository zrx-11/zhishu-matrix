 "glossary": [
  {
   "term": "智能体",
   "en": "",
   "def": "能感知环境、依据目标决策并自主行动的软件系统。",
   "chapterIds": [
    "ch00"
   ]
  },
  {
   "term": "认知引擎",
   "en": "",
   "def": "智能体里负责理解与生成的大模型，只提供认知能力，不提供结构。",
   "chapterIds": [
    "ch00"
   ]
  },
  {
   "term": "自主等级",
   "en": "",
   "def": "按能力复杂度划分的 Level 0~3：纯模型、加工具、加规划、加协作。",
   "chapterIds": [
    "ch00"
   ]
  },
  {
   "term": "上下文窗口",
   "en": "",
   "def": "模型一次能处理的最大 token 数，含输入与输出。",
   "chapterIds": [
    "ch00"
   ]
  },
  {
   "term": "上下文工程",
   "en": "",
   "def": "为当前任务动态组装背景信息（检索、工具输出、隐式数据），区别于静态系统提示。",
   "chapterIds": [
    "ch01"
   ]
  },
  {
   "term": "提示链",
   "en": "",
   "def": "把整体任务拆成若干可验证的局部转换，逐步传递。",
   "chapterIds": [
    "ch01"
   ]
  },
  {
   "term": "输出契约",
   "en": "",
   "def": "规定上一步交给下一步的结构、取值约束与失败语义。",
   "chapterIds": [
    "ch01"
   ]
  },
  {
   "term": "路由",
   "en": "",
   "def": "运行时根据输入决定走哪条路径，而不是把路径写死。",
   "chapterIds": [
    "ch02"
   ]
  },
  {
   "term": "兜底分支",
   "en": "",
   "def": "路由必须保留的默认路径，防止没有匹配分支时直接失败。",
   "chapterIds": [
    "ch02"
   ]
  },
  {
   "term": "判别式路由",
   "en": "",
   "def": "用训练好的分类器决定路径，知识固化在权重里。",
   "chapterIds": [
    "ch02"
   ]
  },
  {
   "term": "截面并行",
   "en": "",
   "def": "把互不依赖的子任务同时执行，用时间换吞吐。",
   "chapterIds": [
    "ch03"
   ]
  },
  {
   "term": "投票并行",
   "en": "",
   "def": "同一任务多次采样后聚合，用冗余换可靠性。",
   "chapterIds": [
    "ch03"
   ]
  },
  {
   "term": "反思",
   "en": "",
   "def": "带一条回边的控制结构：产出→按判据检查→改→直到通过或达上限。",
   "chapterIds": [
    "ch04"
   ]
  },
  {
   "term": "外部判据",
   "en": "",
   "def": "来自产出者之外的判断依据，如测试、原文、清单、规则。",
   "chapterIds": [
    "ch04"
   ]
  },
  {
   "term": "过度修正",
   "en": "",
   "def": "反思中没有可靠判据时越改越偏的一种退化。",
   "chapterIds": [
    "ch04"
   ]
  },
  {
   "term": "工具使用循环",
   "en": "",
   "def": "定义→决策→生成参数→框架执行→观察结果→再决策的闭环。",
   "chapterIds": [
    "ch05"
   ]
  },
  {
   "term": "工具 schema",
   "en": "",
   "def": "工具的名称、参数、类型与使用条件的结构化声明。",
   "chapterIds": [
    "ch05"
   ]
  },
  {
   "term": "ReAct",
   "en": "",
   "def": "思考→行动→观察→再思考的循环，边走边查。",
   "chapterIds": [
    "ch05"
   ]
  },
  {
