 "cards": [
  {
   "id": "f01",
   "front": "数独的三条约束是什么？",
   "back": "每行、每列、每个 3×3 宫都含 1–9 各一次。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f02",
   "front": "R4C5 是哪一格？",
   "back": "第 4 行第 5 列，属于第 5 宫（B5）。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f03",
   "front": "“填满”“合法”“唯一解”分别是什么意思？",
   "back": "填满 = 81 格都有数；合法 = 没有行列宫重复；唯一解 = 只有一个合法终盘。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f04",
   "front": "标准数独有多少个解？",
   "back": "终盘总数为 6,670,903,752,021,072,936,960；单题通常只保留一个解。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f05",
   "front": "“本质不同”的终盘有多少个？",
   "back": "5,472,730,538 个（去掉数字重命名、行列置换、转置等等价变换）。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f06",
   "front": "唯一解最少需要几个提示数？",
   "back": "17 个；16 个不可能，2012 年由 McGuire 等人穷举证明。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f07",
   "front": "数独和拉丁方的差别在哪？",
   "back": "数独在拉丁方的基础上多了 9 个 3×3 宫的约束。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f08",
   "front": "候选数怎么算？",
   "back": "对每个空格，划掉同行、同列、同宫已出现的数字，剩下的就是候选。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f09",
   "front": "候选数是概率吗？",
   "back": "不是。候选是确定的信息：这个数字目前没有被规则排除。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f10",
   "front": "唯一余数和隐性唯一，分别看什么？",
   "back": "唯一余数看格子（只剩一个候选）；隐性唯一看单元里的数字（只剩一个位置）。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f11",
   "front": "唯一余数为什么一定成立？",
   "back": "该格的同行、同列、同宫已经占掉了另外 8 个数字，它只剩这一个选择。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f12",
   "front": "隐性唯一的扫描顺序？",
   "back": "先宫，再行，再列；按数字 1–9 逐个看位置。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f13",
   "front": "区块排除的“指向”和“声明”方向？",
   "back": "指向：宫 → 线；声明：线 → 宫。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f14",
   "front": "区块排除后要做什么？",
   "back": "只删候选，不落子；删完继续找唯一余数或隐性唯一。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f15",
   "front": "显性数对的条件？",
   "back": "同一单元两格，候选并集恰好两个数字，且每格候选不超过两个。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f16",
   "front": "隐性数对的条件？",
   "back": "同一单元两个数字只出现在同样两个格子里。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f17",
   "front": "X-Wing 的条件？",
   "back": "一个数字在两行里都只剩相同的两列（或两列里都只剩相同的两行）。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f18",
   "front": "X-Wing 为什么能删？",
   "back": "两行各放一个 d，必须占掉这两列，所以这两列在其他行不能再有 d。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f19",
   "front": "Swordfish 是几行几列？",
   "back": "3 行 3 列；Jellyfish 是 4 行 4 列。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f20",
   "front": "唯一矩形为什么依赖唯一解？",
   "back": "如果四格能互换 a、b，题目就会出现第二个解；唯一解前提让这种互换不可能。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f21",
   "front": "唯一矩形要求四格落在几个宫？",
   "back": "恰好两个宫；四个宫时互换会破坏宫约束，死锁不成立。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f22",
   "front": "XY-Wing 的结论？",
   "back": "同时看见两翼的格子不能取共同候选 z。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f23",
   "front": "XY-Wing 的枢纽和两翼分别是什么？",
   "back": "枢纽是双值格 {x,y}；两翼是 {x,z} 和 {y,z}，且都看见枢纽。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f24",
   "front": "强链的定义？",
   "back": "两个候选至少一个为真；来源是共轭对或双值格。",
   "chapterId": "ch12",
   "tags": [
    "ch12"
   ]
  },
  {
   "id": "f25",
   "front": "弱链的定义？",
   "back": "两个候选至多一个为真；同一单元同一数字、同一格不同数字都是弱链。",
   "chapterId": "ch12",
   "tags": [
    "ch12"
   ]
  },
  {
   "id": "f26",
   "front": "单数染色的两条规则？",
   "back": "同色两格互相看见 → 该色全假；某格同时看见两色 → 该格删该数字。",
   "chapterId": "ch12",
   "tags": [
    "ch12"
   ]
  },
  {
   "id": "f27",
   "front": "AIC 的端点规则？",
   "back": "强-弱-强交替，两端都是强链时至少一端为真；两端同数字时删共同可见格的该数字。",
   "chapterId": "ch12",
   "tags": [
    "ch12"
   ]
  },
  {
   "id": "f28",
   "front": "解题卡住时先检查什么？",
   "back": "候选是否漏更新；有没有更简单的技巧；不要一上来就用链。",
   "chapterId": "ch13",
   "tags": [
    "ch13"
   ]
  },
  {
   "id": "f29",
   "front": "MRV 是什么？",
   "back": "优先选候选最少的格子试填，减少搜索分支。",
   "chapterId": "ch14",
   "tags": [
    "ch14"
   ]
  },
  {
   "id": "f30",
   "front": "精确覆盖的四类约束？",
   "back": "格、行-数字、列-数字、宫-数字，共 81+81+81+81=324 列。",
   "chapterId": "ch14",
   "tags": [
    "ch14"
   ]
  },
  {
   "id": "f31",
   "front": "DLX 的核心数据结构？",
   "back": "十字链表；覆盖和恢复一列都是 O(1) 级别的指针操作。",
   "chapterId": "ch14",
   "tags": [
    "ch14"
   ]
  },
  {
   "id": "f32",
   "front": "挖洞法怎么保证唯一解？",
   "back": "每去掉一个提示数，就用求解器数解，最多数到 2 个；不是 1 就恢复。",
   "chapterId": "ch15",
   "tags": [
    "ch15"
   ]
  },
  {
   "id": "f33",
   "front": "提示数越少越难吗？",
   "back": "不是。难度由所需技巧层级决定；17 提示可以很难，30 提示也可能很简单。",
   "chapterId": "ch15",
   "tags": [
    "ch15"
   ]
  },
  {
   "id": "f34",
   "front": "广义数独的复杂度？",
   "back": "NP-complete；但 9×9 是常数规模，程序可以秒解。",
   "chapterId": "ch14",
   "tags": [
    "ch14"
   ]
  }
 ],
 "glossary": [
  {
   "term": "数独",
