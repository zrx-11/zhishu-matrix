 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "线性同余法满周期的条件不包括下列哪一条？",
   "options": [
    "c 与 m 互素",
    "a−1 被 m 的所有素因子整除",
    "m 必须是素数",
    "m 被 4 整除时 a−1 也被 4 整除"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "模可以是 2 的幂也可以是素数，条件里没有要求 m 必须是素数。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "m=16、a=5、c=3、x0=1 的线性同余序列，周期是多少？（填数字）",
   "options": [],
   "answer": "16",
   "type": "blank",
   "conceptId": "",
   "explain": "序列走遍 0 到 15 后回到 1，周期等于模 16。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch01",
   "stem": "模取 2 的幂时，线性同余序列的哪一部分质量最差？",
   "options": [
    "最高位",
    "最低位",
    "中间位",
    "都一样"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "模 2^e 时最低位周期只有 2，第 k 位周期最多 2^(k+1)；进位只向上传播，低位看不到高位变化。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "stem": "掷骰子 60 次，六面各出现 10 次，卡方统计量是多少？",
   "options": [
    "0",
    "1",
    "6",
    "10"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "每项 (10−10)²/10 = 0，总和 0。统计量恰为 0 反而提示「整齐得不像抽样」。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q05",
   "chapterId": "ch02",
   "stem": "卡方检验分成 6 个格子，自由度是多少？（填数字）",
   "options": [],
   "answer": "5",
   "type": "blank",
   "conceptId": "",
   "explain": "自由度 = 格子数 − 1 = 5，因为六个频数之和被样本量固定。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q06",
   "chapterId": "ch02",
   "stem": "正确的洗牌做法是？",
   "options": [
    "每个 i 与 1 到 n 中随机位置交换",
    "从 i=n 递减，与 1 到 i 中随机位置交换",
    "随机排序键后排序",
    "每次随机取两个位置交换 n 次"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "Fisher-Yates：第 i 步只在 1 到 i 中取，路径数恰为 n!，每种排列等概率。全范围交换有 n^n 条路径，通常不能被 n! 整除，必然偏斜。",
   "misconception": "",
   "bookSource": null
  },
