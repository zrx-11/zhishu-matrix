 "cards": [
  {
   "id": "f01",
   "front": "线性同余法的递推式怎么写？",
   "back": "x(n+1) = (a·x(n) + c) mod m，参数是模 m、乘数 a、增量 c、初值 x0。",
   "chapterId": "ch01",
   "tags": [
    "随机数"
   ]
  },
  {
   "id": "f02",
   "front": "满周期的三个条件是什么？",
   "back": "gcd(c, m)=1；a−1 被 m 的所有素因子整除；m 被 4 整除时 a−1 也被 4 整除。",
   "chapterId": "ch01",
   "tags": [
    "随机数"
   ]
  },
  {
   "id": "f03",
   "front": "为什么线性同余不能直接用最低位？",
   "back": "模 2^e 时最低位周期只有 2，第 k 位周期最多 2^(k+1)，低位都很短，要用高位。",
   "chapterId": "ch01",
   "tags": [
    "随机数"
   ]
  },
  {
   "id": "f04",
   "front": "模取 2 的幂与取素数各有什么代价？",
   "back": "2 的幂快（按位与）但低位差；素数高低位一致但要做真除法。",
   "chapterId": "ch01",
   "tags": [
    "随机数"
   ]
  },
  {
   "id": "f05",
   "front": "卡方统计量的公式与自由度怎么定？",
   "back": "χ² = Σ(观测−期望)²/期望；自由度 = 格子数 − 1。",
   "chapterId": "ch02",
   "tags": [
    "检验"
   ]
  },
  {
   "id": "f06",
   "front": "卡方检验对期望频数有什么要求？",
   "back": "每格期望不小于 5，否则近似失效，要合并相邻格子。",
   "chapterId": "ch02",
   "tags": [
    "检验"
   ]
  },
  {
   "id": "f07",
   "front": "逆变换法怎么把均匀数变成指数分布？",
   "back": "x = −ln(1−u)/λ，λ 是速率参数。",
   "chapterId": "ch02",
   "tags": [
    "变换"
   ]
  },
  {
   "id": "f08",
   "front": "Fisher-Yates 洗牌怎么做？",
   "back": "从 i=n 递减到 2，随机取 j 在 1 到 i 之间，交换第 i 与第 j 个。",
   "chapterId": "ch02",
   "tags": [
    "洗牌"
   ]
  },
  {
   "id": "f09",
   "front": "浮点数由哪三部分组成？",
   "back": "符号位、指数、尾数；尾数位数决定精度。",
   "chapterId": "ch03",
   "tags": [
    "浮点"
   ]
  },
  {
   "id": "f10",
   "front": "为什么 0.1 + 0.2 不等于 0.3？",
   "back": "0.1 与 0.2 在二进制下都是无限循环小数，存进有限尾数时已被截断，相加再舍入。",
   "chapterId": "ch03",
   "tags": [
    "浮点"
   ]
  },
  {
   "id": "f11",
   "front": "朴素多精度乘法的代价是多少？快速乘法呢？",
   "back": "朴素 O(n²)；快速乘法 T(n)=3T(n/2)+O(n)，约 O(n^1.585)。",
   "chapterId": "ch03",
   "tags": [
    "多精度"
   ]
  },
  {
   "id": "f12",
   "front": "模运算里什么时候可以做除法？",
   "back": "除数的逆元存在时，条件是 gcd(a, m) = 1。",
   "chapterId": "ch03",
   "tags": [
    "模算术"
   ]
  },
  {
   "id": "f13",
   "front": "整数转 b 进制的步骤？",
   "back": "不断除以 b 记余数，商为 0 后把余数倒着读。",
   "chapterId": "ch04",
   "tags": [
    "进制"
   ]
  },
  {
   "id": "f14",
   "front": "秦九韶法则的步骤？",
   "back": "从最高次系数开始，每次「乘 x 再加下一个系数」，直到常数项。",
   "chapterId": "ch04",
   "tags": [
    "多项式"
   ]
  },
  {
   "id": "f15",
   "front": "有理数运算为什么必须约分？",
   "back": "不约分分子分母会指数膨胀；用欧几里得算法约分后规模可控。",
   "chapterId": "ch04",
   "tags": [
    "有理数"
   ]
  },
  {
   "id": "f16",
   "front": "Horner 与进制转换有什么共同点？",
   "back": "两者都是「从一端开始，每步乘基数再加下一位/下一系数」，是同一个算法。",
   "chapterId": "ch04",
   "tags": [
    "多项式"
   ]
  }
 ],
 "glossary": [
  {
   "term": "伪随机数",
