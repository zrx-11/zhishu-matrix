 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：角、弧度与三角比」的一句话核心是什么？",
   "back": "角不再限于 0°~90°：它可以任意大、可以为负；三角比由单位圆上点的坐标定义。",
   "chapterId": "ch01",
   "tags": [
    "trigonometry",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：同角关系与诱导公式」的一句话核心是什么？",
   "back": "同角关系管“同一个角的三种比”，诱导公式管“不同角的同名比”。",
   "chapterId": "ch02",
   "tags": [
    "trigonometry",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：加法定理与倍角公式」的一句话核心是什么？",
   "back": "所有和角、倍角公式都由一条出发：cos(α−β)=cosαcosβ+sinαsinβ。",
   "chapterId": "ch03",
   "tags": [
    "trigonometry",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "「第 4 章：图象、性质与三角方程」的一句话核心是什么？",
   "back": "正弦、余弦的周期是 2π，正切是 π；图象的平移伸缩都写在 A、ω、φ 三个参数里。",
   "chapterId": "ch04",
   "tags": [
    "trigonometry",
    "核心"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「弧度」？",
   "back": "弧长与半径之比定义的角的度量。",
   "chapterId": "ch01",
   "tags": [
    "trigonometry",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「终边相同的角」？",
   "back": "相差 360° 整数倍的角。",
   "chapterId": "ch01",
   "tags": [
    "trigonometry",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「正弦」？",
   "back": "单位圆上角的终边交点的纵坐标。",
   "chapterId": "ch01",
   "tags": [
    "trigonometry",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「余弦」？",
   "back": "单位圆上角的终边交点的横坐标。",
   "chapterId": "ch01",
   "tags": [
    "trigonometry",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「诱导公式」？",
   "back": "把任意角三角比化为锐角三角比的公式。",
   "chapterId": "ch02",
   "tags": [
    "trigonometry",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「加法定理」？",
   "back": "展开 α±β 三角比的公式。",
   "chapterId": "ch03",
   "tags": [
    "trigonometry",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「二倍角公式」？",
   "back": "sin2α、cos2α、tan2α 的公式。",
   "chapterId": "ch03",
   "tags": [
    "trigonometry",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「周期」？",
   "back": "函数值重复出现的最小正间隔。",
   "chapterId": "ch04",
   "tags": [
    "trigonometry",
    "术语"
   ]
  },
  {
   "id": "f13",
   "front": "什么是「振幅」？",
   "back": "y=A sin(ωx+φ) 中的 |A|。",
   "chapterId": "ch04",
   "tags": [
    "trigonometry",
    "术语"
   ]
  },
  {
   "id": "f14",
   "front": "什么是「通解」？",
   "back": "含整数 k、表示全部解的表达式。",
   "chapterId": "ch04",
   "tags": [
    "trigonometry",
    "术语"
   ]
  }
 ],
