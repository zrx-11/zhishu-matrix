 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "与 −30° 终边相同的角是：",
   "options": [
    "30°",
    "330°",
    "300°",
    "150°"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "−30°+360°=330°。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "150° 化为弧度是：",
   "options": [
    "5π/6",
    "2π/3",
    "3π/4",
    "7π/6"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c01",
   "explain": "150°=150×π/180=5π/6。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "stem": "sin210° 的值是：",
   "options": [
    "1/2",
    "−1/2",
    "√3/2",
    "−√3/2"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "sin210°=sin(180°+30°)=−sin30°=−1/2。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "stem": "已知 cosθ=−3/5 且 θ 在第三象限，则 sinθ 为：",
   "options": [
    "4/5",
    "−4/5",
    "3/5",
    "−3/5"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "第三象限正弦为负，sinθ=−√(1−9/25)=−4/5。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "stem": "cos(α+β) 展开为：",
   "options": [
    "cosαcosβ+sinαsinβ",
    "cosαcosβ−sinαsinβ",
    "sinαcosβ+cosαsinβ",
    "sinαcosβ−cosαsinβ"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "余弦和角公式为 cosαcosβ−sinαsinβ。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "stem": "sin2α 等于：",
   "options": [
    "2sinα",
    "2sinαcosα",
    "sin²α−cos²α",
    "1−2sin²α"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "二倍角正弦公式为 2sinαcosα。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q07",
   "chapterId": "ch04",
   "stem": "y=2sin(3x) 的周期是：",
   "options": [
    "2π",
    "2π/3",
    "3π",
    "π/3"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c02",
   "explain": "T=2π/|ω|=2π/3。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q08",
   "chapterId": "ch04",
   "stem": "方程 cosx=0 的通解是：",
   "options": [
    "x=kπ",
