 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "数列 a_n=1/n 的极限是：",
   "options": [
    "1",
    "0",
    "不存在",
    "∞"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "n 越大 1/n 越接近 0，可任意小。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "ε-N 定义中，N 的作用是：",
   "options": [
    "表示项数上限",
    "表示从第 N 项以后都满足精度要求",
    "表示误差",
    "表示极限值"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "N 是“从这一项开始，之后所有项都落在 ε 范围内”的分界。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "stem": "f(x)=x³ 的导数是：",
   "options": [
    "3x²",
    "x²",
    "3x",
    "x³/4"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c01",
   "explain": "由 (x^n)'=nx^(n−1) 得 3x²。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "stem": "y=(2x+1)³ 的导数是：",
   "options": [
    "3(2x+1)²",
    "6(2x+1)²",
    "3(2x+1)³",
    "6(2x+1)³"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "链式法则：3(2x+1)²·2=6(2x+1)²。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q05",
   "chapterId": "ch03",
   "stem": "∫_0^2 x dx 的值是：",
   "options": [
    "2",
    "4",
    "1",
    "0"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c01",
   "explain": "原函数 x²/2，代入得 4/2−0=2。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "stem": "微积分基本定理的作用是：",
   "options": [
    "定义极限",
    "把定积分化为原函数在端点的差",
    "求导数",
    "判断连续"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "∫_a^b f=F(b)−F(a)，把求和变成代端点。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q07",
   "chapterId": "ch04",
   "stem": "f(x)=x²−2x 的极小值点是：",
   "options": [
    "x=1",
    "x=0",
    "x=2",
    "x=−1"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "f'(x)=2x−2，零点 x=1，且为极小值点。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q08",
   "chapterId": "ch04",
   "stem": "y=x 与 y=x² 在 [0,1] 围成的面积是：",
   "options": [
    "1/6",
    "1/3",
    "1/2",
    "1"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "∫_0^1(x−x²)dx=1/2−1/3=1/6。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q09",
   "chapterId": "__all__",
   "stem": "f(x)=3x²+1 的导数是：",
   "options": [
    "6x",
    "3x",
    "6x+1",
    "x²"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "常数项导数为 0，(3x²)'=6x。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q10",
   "chapterId": "__all__",
   "stem": "∫_1^2 2x dx 的值是：",
   "options": [
    "3",
    "4",
    "2",
    "1"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "原函数 x²，代入得 4−1=3。",
   "misconception": "",
   "bookSource": null
  }
