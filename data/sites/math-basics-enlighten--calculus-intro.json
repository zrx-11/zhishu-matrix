 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：实数与极限」的一句话核心是什么？",
   "back": "极限描述“越来越接近”的严格含义：要多近就能多近。",
   "chapterId": "ch01",
   "tags": [
    "calculus-intro",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：连续与导数」的一句话核心是什么？",
   "back": "连续是“极限等于函数值”；导数是“差商的极限”，即瞬时变化率。",
   "chapterId": "ch02",
   "tags": [
    "calculus-intro",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：微分与积分」的一句话核心是什么？",
   "back": "微分是增量的线性主部；定积分是分割求和的极限；两者由基本定理连接。",
   "chapterId": "ch03",
   "tags": [
    "calculus-intro",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "「第 4 章：单调、极值与面积」的一句话核心是什么？",
   "back": "导数正负决定增减，导数为零的点是极值候选；面积用上减下再积分。",
   "chapterId": "ch04",
   "tags": [
    "calculus-intro",
    "核心"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「极限」？",
   "back": "变量无限接近某个值的趋势的严格描述。",
   "chapterId": "ch01",
   "tags": [
    "calculus-intro",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「ε-N 语言」？",
   "back": "用任意小的 ε 与分界 N 表述数列极限。",
   "chapterId": "ch01",
   "tags": [
    "calculus-intro",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「连续」？",
   "back": "函数在某点的极限等于函数值。",
   "chapterId": "ch02",
   "tags": [
    "calculus-intro",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「导数」？",
   "back": "差商当 h→0 时的极限，表示瞬时变化率。",
   "chapterId": "ch02",
   "tags": [
    "calculus-intro",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「链式法则」？",
   "back": "复合函数求导：外层导数乘内层导数。",
   "chapterId": "ch02",
   "tags": [
    "calculus-intro",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「微分」？",
   "back": "增量的线性主部 dy=f'(x)dx。",
   "chapterId": "ch03",
   "tags": [
    "calculus-intro",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「定积分」？",
   "back": "分割求和的极限，表示累积量。",
   "chapterId": "ch03",
   "tags": [
    "calculus-intro",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「原函数」？",
   "back": "导数等于被积函数的函数。",
   "chapterId": "ch03",
   "tags": [
    "calculus-intro",
    "术语"
   ]
  },
  {
   "id": "f13",
   "front": "什么是「极值」？",
   "back": "局部最大或最小值。",
   "chapterId": "ch04",
   "tags": [
    "calculus-intro",
    "术语"
   ]
  }
 ],
