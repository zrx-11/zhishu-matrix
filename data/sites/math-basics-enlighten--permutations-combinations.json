 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：两条原理与排列」的一句话核心是什么？",
   "back": "分类用加法、分步用乘法；有序用排列。",
   "chapterId": "ch01",
   "tags": [
    "permutations-combinations",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：组合与组合数」的一句话核心是什么？",
   "back": "组合只问“选哪些”，不问“怎么排”；所以 C(n,m)=A(n,m)/m!。",
   "chapterId": "ch02",
   "tags": [
    "permutations-combinations",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：可重复排列与分组分配」的一句话核心是什么？",
   "back": "允许重复时每一步都有 n 种；分组时若各组人数相同，要除以组数的阶乘。",
   "chapterId": "ch03",
   "tags": [
    "permutations-combinations",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "什么是「加法原理」？",
   "back": "分类计数，各类互斥则相加。",
   "chapterId": "ch01",
   "tags": [
    "permutations-combinations",
    "术语"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「乘法原理」？",
   "back": "分步计数，各步相依则相乘。",
   "chapterId": "ch01",
   "tags": [
    "permutations-combinations",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「排列」？",
   "back": "取出的元素要计顺序的排法。",
   "chapterId": "ch01",
   "tags": [
    "permutations-combinations",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「全排列」？",
   "back": "n 个元素全部参与排列，共 n! 种。",
   "chapterId": "ch01",
   "tags": [
    "permutations-combinations",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「组合」？",
   "back": "只计取出哪些元素、不计顺序。",
   "chapterId": "ch02",
   "tags": [
    "permutations-combinations",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「组合数」？",
   "back": "C(n,m)=n!/[m!(n−m)!]。",
   "chapterId": "ch02",
   "tags": [
    "permutations-combinations",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「可重复排列」？",
   "back": "元素可重复取用，数目为 nᵐ。",
   "chapterId": "ch03",
   "tags": [
    "permutations-combinations",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「均匀分组」？",
   "back": "各组元素个数相同，需除以组数阶乘。",
   "chapterId": "ch03",
   "tags": [
    "permutations-combinations",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「分配」？",
   "back": "把分好的组派到有标号的位置。",
   "chapterId": "ch03",
   "tags": [
    "permutations-combinations",
    "术语"
   ]
  }
 ],
