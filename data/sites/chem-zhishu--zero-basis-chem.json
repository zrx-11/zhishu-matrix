    "8、9、9",
    "17、8、17"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "O 的原子序数 8，质子数 8；中子数 17-8=9；中性原子电子数=质子数=8。",
   "misconception": "",
   "bookSource": null
  },
  {
