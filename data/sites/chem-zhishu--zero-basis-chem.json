 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "下列属于纯净物的是？",
   "options": [
    "洁净的空气",
    "冰水混合物",
    "生理盐水",
    "大理石"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "冰和水都是 H2O，只有一种物质；其余都含多种物质。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "下列物质中属于氧化物的是？",
   "options": [
    "O2",
    "KClO3",
    "Fe3O4",
    "H2SO4"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "Fe3O4 只含 Fe、O 两种元素；A 是单质，B、D 含三种元素。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "stem": "17O 的质子数、中子数、电子数分别是？",
