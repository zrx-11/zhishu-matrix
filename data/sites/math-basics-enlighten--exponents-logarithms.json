 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：指数的推广与指数函数」的一句话核心是什么？",
   "back": "指数每推广一步，都要求原来的运算法则继续成立；指数函数的值域恒为正。",
   "chapterId": "ch01",
   "tags": [
    "exponents-logarithms",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：对数与对数运算」的一句话核心是什么？",
   "back": "对数就是“问指数”：log_a N 是“a 的几次方等于 N”。",
   "chapterId": "ch02",
   "tags": [
    "exponents-logarithms",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：对数函数、幂函数与指对方程」的一句话核心是什么？",
   "back": "对数函数与指数函数关于 y=x 对称；解指对方程靠“化同底”或“取对数”。",
   "chapterId": "ch03",
   "tags": [
    "exponents-logarithms",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "什么是「指数函数」？",
   "back": "y=aˣ（a>0，a≠1），值域 (0,+∞)。",
   "chapterId": "ch01",
   "tags": [
    "exponents-logarithms",
    "术语"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「零指数」？",
   "back": "a⁰=1（a≠0）。",
   "chapterId": "ch01",
   "tags": [
    "exponents-logarithms",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「分数指数」？",
   "back": "a^(m/n)=ⁿ√(aᵐ)，把根式写成指数。",
   "chapterId": "ch01",
   "tags": [
    "exponents-logarithms",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「对数」？",
   "back": "log_a N=b 表示 aᵇ=N。",
   "chapterId": "ch02",
   "tags": [
    "exponents-logarithms",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「真数」？",
   "back": "对数记号中的 N，必须大于 0。",
   "chapterId": "ch02",
   "tags": [
    "exponents-logarithms",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「换底公式」？",
   "back": "log_a N=log_b N/log_b a。",
   "chapterId": "ch02",
   "tags": [
    "exponents-logarithms",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「对数函数」？",
   "back": "y=log_a x，与指数函数互为反函数。",
   "chapterId": "ch03",
   "tags": [
    "exponents-logarithms",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「幂函数」？",
   "back": "y=x^α，底是变量、指数是常数。",
   "chapterId": "ch03",
   "tags": [
    "exponents-logarithms",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「增根」？",
   "back": "解对数方程时使真数非正的解。",
   "chapterId": "ch03",
   "tags": [
    "exponents-logarithms",
    "术语"
   ]
  }
 ],
