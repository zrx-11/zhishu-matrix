 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：函数与图象」的一句话核心是什么？",
   "back": "函数不是公式，是一条规则：给定输入，唯一确定输出。",
   "chapterId": "ch01",
   "tags": [
    "linear-quadratic-functions",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：一次函数」的一句话核心是什么？",
   "back": "一次函数 y=kx+b 的变化率恒为 k：k 正则升，k 负则降，b 是它与 y 轴的交点。",
   "chapterId": "ch02",
   "tags": [
    "linear-quadratic-functions",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：二次函数与变化率」的一句话核心是什么？",
   "back": "二次函数的一切都藏在顶点式 y=a(x−h)²+k 里：a 定开口，顶点 (h,k) 定最值。",
   "chapterId": "ch03",
   "tags": [
    "linear-quadratic-functions",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "什么是「函数」？",
   "back": "一个输入对应唯一输出的规则。",
   "chapterId": "ch01",
   "tags": [
    "linear-quadratic-functions",
    "术语"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「定义域」？",
   "back": "允许输入的所有取值组成的集合。",
   "chapterId": "ch01",
   "tags": [
    "linear-quadratic-functions",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「值域」？",
   "back": "所有实际输出组成的集合。",
   "chapterId": "ch01",
   "tags": [
    "linear-quadratic-functions",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「增函数」？",
   "back": "x 增大时 y 也增大的函数。",
   "chapterId": "ch01",
   "tags": [
    "linear-quadratic-functions",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「斜率」？",
   "back": "一次函数 y=kx+b 中的 k，反映倾斜与增减。",
   "chapterId": "ch02",
   "tags": [
    "linear-quadratic-functions",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「截距」？",
   "back": "图象与 y 轴交点的纵坐标 b。",
   "chapterId": "ch02",
   "tags": [
    "linear-quadratic-functions",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「顶点式」？",
   "back": "y=a(x−h)²+k 的形式，直接读出顶点。",
   "chapterId": "ch03",
   "tags": [
    "linear-quadratic-functions",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「对称轴」？",
   "back": "抛物线关于它左右对称的竖直线 x=−b/2a。",
   "chapterId": "ch03",
   "tags": [
    "linear-quadratic-functions",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「平均变化率」？",
   "back": "区间两端函数值之差与自变量之差的比。",
   "chapterId": "ch03",
   "tags": [
    "linear-quadratic-functions",
    "术语"
   ]
  }
 ],
