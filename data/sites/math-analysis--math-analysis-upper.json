 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "E={1-1/n: n=1,2,...} 的上确界是？",
   "options": [
    "0",
    "1",
    "不存在",
    "2"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c01",
   "explain": "所有项小于 1，且可任意接近 1，1 是最小上界，但不属于 E。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "{x∈Q: x²<2} 在有理数范围内有上确界吗？",
   "options": [
    "有，是 2",
    "有，是 √2",
    "没有",
    "无法判断"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "c01",
   "explain": "√2 不是有理数，最小有理上界不存在，说明有理数集不满足确界原理。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "stem": "收敛数列一定满足？",
   "options": [
    "单调",
    "有界",
    "从某项起等于极限",
    "有上界无下界"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c02",
   "explain": "收敛必有界；单调与恒等都不是必要条件。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "stem": "a_n=(-1)^n 是柯西列吗？",
   "options": [
    "是，因为有界",
    "是，因为没有极限",
    "不是，取 ε=1 可找到相距 2 的两项",
    "无法判断"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "c02",
   "explain": "相邻异号项之差为 2，任意 N 之后都能找到，违反柯西条件。",
   "misconception": "",
   "bookSource": null
  },
  {
