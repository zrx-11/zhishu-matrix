 "cards": [
  {
   "id": "f01",
   "front": "上确界的两条判据",
   "back": "是上界；且对任意 ε>0 存在 x0∈E 使 x0>η-ε。",
   "chapterId": "ch01",
   "tags": [
    "确界"
   ]
  },
  {
   "id": "f02",
   "front": "为什么有理数集不满足确界原理",
   "back": "{x∈Q: x²<2} 有上界但没有最小有理上界，缺口在 √2。",
   "chapterId": "ch01",
   "tags": [
    "完备性"
   ]
  },
  {
   "id": "f03",
   "front": "ε-N 定义",
   "back": "任给 ε>0，存在 N，n>N 时 |a_n-a|<ε。",
   "chapterId": "ch02",
   "tags": [
    "极限"
   ]
  },
  {
   "id": "f04",
   "front": "柯西准则",
   "back": "收敛的充要条件：任给 ε>0，存在 N，m,n>N 时 |a_n-a_m|<ε。",
   "chapterId": "ch02",
   "tags": [
    "极限",
    "完备性"
   ]
  },
  {
   "id": "f05",
   "front": "海涅定理",
   "back": "函数极限存在等价于任意趋近数列给出的函数值数列同极限。",
   "chapterId": "ch03",
   "tags": [
    "极限"
   ]
  },
  {
   "id": "f06",
   "front": "两个重要极限",
   "back": "lim sin x/x=1；lim(1+x)^{1/x}=e。",
   "chapterId": "ch03",
   "tags": [
    "极限"
   ]
  },
  {
   "id": "f07",
   "front": "间断点四类",
   "back": "可去、跳跃（第一类）；无穷、振荡（第二类）。",
   "chapterId": "ch04",
   "tags": [
    "连续"
   ]
  },
  {
   "id": "f08",
   "front": "闭区间连续四定理",
   "back": "有界、取到最值、介值、一致连续。",
   "chapterId": "ch04",
   "tags": [
    "连续"
   ]
  },
  {
   "id": "f09",
   "front": "可导与连续的关系",
   "back": "可导必连续，连续不必可导（|x| 在 0 点）。",
   "chapterId": "ch05",
   "tags": [
    "导数"
   ]
  },
  {
   "id": "f10",
   "front": "一阶微分形式不变性",
   "back": "无论 x 是自变量还是中间变量，dy=f'(u)du 都成立。",
   "chapterId": "ch05",
   "tags": [
    "微分"
   ]
  },
  {
   "id": "f11",
   "front": "拉格朗日中值定理",
   "back": "f 连续可导，则存在 ξ 使 f(b)-f(a)=f'(ξ)(b-a)。",
   "chapterId": "ch06",
   "tags": [
    "中值定理"
   ]
  },
  {
   "id": "f12",
   "front": "洛必达失效的例子",
   "back": "lim(x→∞)(x+sin x)/x，导数比震荡，但原极限为 1。",
   "chapterId": "ch06",
   "tags": [
    "极限"
   ]
  },
  {
   "id": "f13",
   "front": "六条完备性定理",
   "back": "确界、单调有界、区间套、聚点、致密性、柯西。",
   "chapterId": "ch07",
   "tags": [
    "完备性"
   ]
  },
  {
   "id": "f14",
   "front": "上极限与下极限相等意味着什么",
   "back": "数列收敛，且共同值就是极限。",
   "chapterId": "ch07",
   "tags": [
    "极限"
   ]
  },
  {
   "id": "f15",
   "front": "分部积分选 u 的口诀",
   "back": "反对幂三指：反三角、对数、幂、三角、指数。",
   "chapterId": "ch08",
   "tags": [
    "积分"
   ]
  },
  {
   "id": "f16",
   "front": "三角代换三种对应",
   "back": "√(a²-x²) 用 a sin t；√(a²+x²) 用 a tan t；√(x²-a²) 用 a sec t。",
   "chapterId": "ch08",
   "tags": [
    "积分"
   ]
  },
  {
   "id": "f17",
   "front": "可积的充要条件",
   "back": "分割细度趋于 0 时，上和与下和之差趋于 0。",
   "chapterId": "ch09",
   "tags": [
    "定积分"
   ]
  },
  {
   "id": "f18",
   "front": "牛顿-莱布尼茨公式",
   "back": "∫ₐᵇf=F(b)-F(a)，要求 f 连续、F 是原函数。",
   "chapterId": "ch09",
   "tags": [
    "定积分"
   ]
  },
  {
   "id": "f19",
   "front": "旋转体体积公式",
   "back": "绕 x 轴 V=π∫f²dx；绕 y 轴用柱壳 V=2π∫x·f dx。",
   "chapterId": "ch10",
   "tags": [
    "应用"
   ]
  },
  {
   "id": "f20",
   "front": "弧长公式",
   "back": "s=∫√(1+y'²)dx，参数与极坐标只需换 ds。",
   "chapterId": "ch10",
   "tags": [
    "应用"
   ]
  },
  {
   "id": "f21",
   "front": "p 积分的敛散",
   "back": "∫₁^∞x^{-p}：p>1 收敛；∫₀¹x^{-p}：p<1 收敛。",
   "chapterId": "ch11",
   "tags": [
    "反常积分"
   ]
  },
  {
   "id": "f22",
   "front": "条件收敛的例子",
   "back": "∫₁^∞ sin x/x dx：本身收敛，绝对值发散。",
   "chapterId": "ch11",
   "tags": [
    "反常积分"
   ]
  }
 ],
