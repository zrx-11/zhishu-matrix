 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "一个 2×3 矩阵乘一个 3 维向量，结果是什么形状？",
   "options": [
    "2×3 矩阵",
    "3 维向量",
    "2 维向量",
    "一个标量"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "c02",
   "explain": "左矩阵两行，每行与 3 维向量做一次加权求和，得到两个数。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "对分数 [0, 0, 0] 做 softmax，输出是什么？",
   "options": [
    "[0, 0, 0]",
    "[1/3, 1/3, 1/3]",
    "[1, 0, 0]",
    "[3, 3, 3]"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c03",
   "explain": "三个 e^0=1，总和 3，各占三分之一。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch01",
   "stem": "embedding 表在模型里做什么？",
   "options": [
    "把 token 编号映射成向量",
    "把向量压缩成标量",
    "把句子翻译成英文",
    "计算损失"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c01",
   "explain": "embedding 表按 token 编号查出一串固定长度的向量。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "stem": "梯度为正时，梯度下降会把参数往哪个方向更新？",
   "options": [
    "增大",
    "减小",
    "不变",
    "随机"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c05",
   "explain": "更新规则是减去学习率乘梯度，梯度为正就减小参数。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q05",
   "chapterId": "ch02",
   "stem": "w=1、x=2、y=3，损失 L=(wx-y)^2，对 w 的梯度是多少？",
   "options": [
    "-4",
    "4",
    "-2",
    "2"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c05",
   "explain": "2(wx-y)x = 2(2-3)×2 = -4。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q06",
   "chapterId": "ch02",
   "stem": "学习率取得过大，训练曲线通常会出现什么？",
   "options": [
    "收敛更快且稳定",
    "损失震荡或发散",
    "参数不再更新",
    "模型自动变小"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c04",
   "explain": "步子太大会跨过谷底，损失震荡甚至变成 NaN。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q07",
   "chapterId": "ch03",
   "stem": "注意力里真正被加权混合的是哪一项？",
   "options": [
    "Query",
    "Key",
    "Value",
    "因果掩码"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "c06",
   "explain": "Q 和 K 只用于算分数，输出是 V 的加权和。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q08",
   "chapterId": "ch03",
   "stem": "分数 [1, 1, 1] 经过 softmax 后的权重是什么？",
   "options": [
    "[1, 0, 0]",
    "[1/3, 1/3, 1/3]",
    "[0.5, 0.5, 0]",
    "[3, 3, 3]"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c03",
   "explain": "三个 e^1 相等，各占三分之一。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q09",
   "chapterId": "ch03",
   "stem": "注意力分数为什么要除以 sqrt(d_k)？",
   "options": [
    "让分数更大",
    "防止 softmax 过度集中",
    "增加注意力头数",
    "去掉位置信息"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c06",
   "explain": "维度高时点积数值大，softmax 会过度集中，梯度变小。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q10",
   "chapterId": "ch04",
   "stem": "一个 Transformer 层里，残差连接加在哪两处？",
   "options": [
    "只在注意力后",
    "只在 FFN 后",
    "注意力和 FFN 后各一次",
    "每层最后只加一次"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "c08",
   "explain": "注意力和 FFN 是两个子层，各自带残差。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q11",
   "chapterId": "ch04",
   "stem": "输入形状 [6, 16] 经过 4 倍 FFN 后，中间层形状是什么？",
   "options": [
    "[6, 16]",
    "[6, 64]",
    "[24, 16]",
    "[6, 4]"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c10",
   "explain": "隐藏维度 16 放大 4 倍是 64，token 数不变。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q12",
   "chapterId": "ch04",
   "stem": "为什么位置信息必须显式注入 Transformer？",
   "options": [
    "让模型知道词序",
    "减少参数量",
    "加速训练",
    "替代注意力"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "c11",
   "explain": "查表得到的 token 向量不含顺序信息，不注入位置就分不清词序。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q13",
   "chapterId": "ch05",
   "stem": "MLA 推理时缓存的核心内容是什么？",
   "options": [
    "每个头的完整 K 和 V",
    "低维潜向量和 RoPE key",
    "只有 Query",
    "整个隐藏层输出"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c12",
   "explain": "MLA 缓存压缩后的 c_KV 和承载位置的 RoPE key。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q14",
   "chapterId": "ch05",
   "stem": "DeepSeekMoE 中共享专家的作用是什么？",
   "options": [
    "只处理英文",
    "始终激活，兜住通用知识",
    "只处理数学题",
    "替代注意力"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c13",
   "explain": "共享专家对所有 token 生效，减少路由专家重复学习通用知识。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q15",
   "chapterId": "ch05",
   "stem": "MTP 在训练时额外预测哪个位置？",
   "options": [
    "只预测 t+1",
    "额外预测 t+2",
    "预测前一个 token",
    "随机位置"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "c14",
   "explain": "在位置 t 额外预测 t+2，增加训练信号密度。",
   "misconception": "",
   "bookSource": null
  }
