 "cards": [
  {
   "id": "f01",
   "front": "序完备性说的是什么？",
   "back": "每个非空、上有界的子集都有上确界。ℝ 满足，ℚ 不满足。",
   "chapterId": "ch01",
   "tags": [
    "完备性",
    "实数"
   ]
  },
  {
   "id": "f02",
   "front": "皮亚诺第 5 条公理的作用？",
   "back": "把“从 0 起逐個到达”变成公理，保证归纳法覆盖整个 ℕ。",
   "chapterId": "ch01",
   "tags": [
    "自然数",
    "归纳"
   ]
  },
  {
   "id": "f03",
   "front": "ℚ 中 {x : x² < 2, x > 0} 有上确界吗？",
   "back": "没有。它的上确界是 √2，不在 ℚ 中。",
   "chapterId": "ch01",
   "tags": [
    "完备性",
    "反例"
   ]
  },
  {
   "id": "f04",
   "front": "可数与稠密的区别？",
   "back": "可数=存在到 ℕ 的双射；稠密=任意两数之间还有数。ℚ 既稠密又可数。",
   "chapterId": "ch01",
   "tags": [
    "可数"
   ]
  },
  {
   "id": "f05",
   "front": "数系扩张的统一手法？",
   "back": "造一个更大的集合，再按等价关系取商（如整数用差相同，分数用交叉相乘相等）。",
   "chapterId": "ch01",
   "tags": [
    "构造"
   ]
  },
  {
   "id": "f06",
   "front": "ε-N 定义中三个容易忽略的点？",
   "back": "ε 任意；N 依赖 ε；只要求从 N 以后成立。",
   "chapterId": "ch02",
   "tags": [
    "极限",
    "定义"
   ]
  },
  {
   "id": "f07",
   "front": "柯西列与收敛列的关系？",
   "back": "收敛 ⇒ 柯西；柯西 ⇒ 收敛只在完备空间成立。",
   "chapterId": "ch02",
   "tags": [
    "完备性"
   ]
  },
  {
   "id": "f08",
   "front": "单调有界定理为什么好用？",
   "back": "不需要猜极限，只要验证“递增 + 有上界”，收敛性与极限存在性一起得到。",
   "chapterId": "ch02",
   "tags": [
    "极限"
   ]
  },
  {
   "id": "f09",
   "front": "绝对收敛与条件收敛的差别？",
   "back": "绝对收敛=绝对值级数收敛，可任意重排；条件收敛重排会改变和。",
   "chapterId": "ch02",
   "tags": [
    "级数"
   ]
  },
  {
   "id": "f10",
   "front": "幂级数的收敛集合形状？",
   "back": "以展开点为心的圆盘；半径由 1/R = limsup |aₙ|^(1/n) 给出。",
   "chapterId": "ch02",
   "tags": [
    "幂级数"
   ]
  },
  {
   "id": "f11",
   "front": "连续性的开集刻画？",
   "back": "f 连续 ⇔ 每个开集的原像是开集。",
   "chapterId": "ch03",
   "tags": [
    "连续",
    "拓扑"
   ]
  },
  {
   "id": "f12",
   "front": "紧致性的两条等价说法（度量空间）？",
   "back": "开覆盖有有限子覆盖；每个序列有收敛子列。",
   "chapterId": "ch03",
   "tags": [
    "紧致"
   ]
  },
  {
   "id": "f13",
   "front": "为什么紧集上连续函数一致连续？",
   "back": "若没有统一 δ，可取 xₙ、yₙ 距离趋 0 而函数值差 ≥ ε，紧性抽出共同极限点，与连续性矛盾。",
   "chapterId": "ch03",
   "tags": [
    "紧致",
    "一致连续"
   ]
  },
  {
   "id": "f14",
   "front": "介值定理对复值函数成立吗？",
   "back": "不成立。值域必须是一维有序的；复值可以绕圈避开中间值。",
   "chapterId": "ch03",
   "tags": [
    "介值"
   ]
  },
  {
   "id": "f15",
   "front": "exp 怎么定义？",
   "back": "exp(z) = Σ zⁿ/n!，绝对收敛；由柯西乘积得加法定理。",
   "chapterId": "ch03",
   "tags": [
    "指数函数"
   ]
  },
  {
   "id": "f16",
   "front": "可微的线性逼近说法？",
   "back": "存在仿射 g 使 f(a)=g(a) 且 ‖f(x)−g(x)‖/|x−a| → 0。",
   "chapterId": "ch04",
   "tags": [
    "微分"
   ]
  },
  {
   "id": "f17",
   "front": "罗尔定理的证明关键？",
   "back": "紧区间上连续函数取到极值；内部极值处导数为 0；端点极值则函数为常数。",
   "chapterId": "ch04",
   "tags": [
    "中值定理"
   ]
  },
  {
   "id": "f18",
   "front": "泰勒两种余项各适合什么？",
   "back": "皮亚诺余项适合求极限；拉格朗日余项给出具体误差界。",
   "chapterId": "ch04",
   "tags": [
    "泰勒"
   ]
  },
  {
   "id": "f19",
   "front": "牛顿法何时退化？",
   "back": "f′ 接近 0、根为重根、初值不在吸引域时；收敛从二次退化为线性或发散。",
   "chapterId": "ch04",
   "tags": [
    "迭代"
   ]
  },
  {
   "id": "f20",
   "front": "f′(a)=0 一定是极值吗？",
   "back": "不一定。x³ 在 0 处导数为 0 但不是极值。",
   "chapterId": "ch04",
   "tags": [
    "极值"
   ]
  },
  {
   "id": "f21",
   "front": "逐点与一致收敛的唯一差别？",
   "back": "N 是否依赖 x。一致收敛的 N 只依赖 ε。",
   "chapterId": "ch05",
   "tags": [
