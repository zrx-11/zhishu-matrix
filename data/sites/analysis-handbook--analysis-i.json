 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "下列哪个集合在 ℚ 中没有上确界？",
   "options": [
    "{x ∈ ℚ : x < 1}",
    "{x ∈ ℚ : x² < 2 且 x > 0}",
    "{x ∈ ℚ : 0 ≤ x ≤ 1}",
    "{x ∈ ℚ : x² < 4 且 x > 0}"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "前三个的上确界分别是 1、1、2，都在 ℚ 中。第二个集合的上确界是 √2，不在 ℚ 中；书中用 ξ = (2c+2)/(c+2) 证明任何有理上界都能被改进。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "皮亚诺公理中，哪一条保证数学归纳法可用？",
   "options": [
    "0 ∈ ℕ",
    "后继是单射",
    "归纳公理（第 5 条）",
    "0 不是任何数的后继"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "前四条只刻画后继链，第 5 条排除“链外还有多余元素”的模型，归纳才能覆盖整个 ℕ。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch01",
   "stem": "关于集合的可数性，下列判断正确的是？",
   "options": [
    "ℚ 不可数",
    "ℝ 可数",
    "ℤ 与 ℚ 都可数",
    "有限集不可数"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "ℤ 可按 0,1,−1,2,−2,… 排队；ℚ 可按 |p|+q 分层排队。ℝ 由康托对角线不可数，有限集按定义可数。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "stem": "数列 xₙ = (−1)ⁿ 的收敛情况是？",
   "options": [
    "收敛到 1",
    "收敛到 −1",
    "不收敛",
    "收敛到 0"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "取 ε₀ = 1，任何 N 之后都能找到奇偶两项，距离为 2，不满足柯西条件，因此不收敛。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q05",
   "chapterId": "ch02",
   "stem": "下列空间中，哪一个在通常度量下不完备？",
   "options": [
    "ℝ",
    "ℂ",
    "ℚ",
    "ℝ²"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "√2 的截断小数是 ℚ 中的柯西列，但极限不在 ℚ 中。ℝ、ℂ、ℝ² 都完备。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q06",
   "chapterId": "ch02",
   "stem": "关于级数，正确的说法是？",
   "options": [
    "通项趋于 0 则级数收敛",
    "在巴拿赫空间中绝对收敛必定收敛",
    "条件收敛的级数重排后仍收敛到同一值",
    "收敛级数必定绝对收敛"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "A 错，调和级数通项趋于 0 却发散；C 错，重排可改变和甚至发散；D 错，交错调和级数收敛但绝对值级数发散。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q07",
   "chapterId": "ch03",
   "stem": "f(x) = 1/x 在 (0, 1) 上的一致连续性如何？",
   "options": [
    "一致连续",
    "连续但非一致连续",
    "不连续",
    "只在 (1/2,1) 上一致连续"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "取 xₙ = 1/n，yₙ = 1/(n+1)，两点距离趋于 0，函数值之差恒为 1，不存在统一 δ。定义域不紧致，正是一致连续失效的典型场景。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q08",
   "chapterId": "ch03",
   "stem": "下列哪个条件能保证连续函数 f : X → ℝ 取到最小值？",
   "options": [
    "X 是开区间",
    "X 紧致",
    "f 有界",
    "X 连通"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "紧集上连续函数取到最大最小值。开区间、连通都不够（f(x)=x 在 (0,1) 无最小值）；仅有界也不够。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q09",
   "chapterId": "ch03",
   "stem": "介值定理成立的必要条件不包括？",
   "options": [
    "定义域连通",
    "函数连续",
    "值域是一维有序的",
    "函数可微"
   ],
   "answer": 3,
   "type": "single",
   "conceptId": "",
   "explain": "介值定理只用连续性，不要求可微。去掉连通、去掉连续、或换成复值，结论都会失效。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q10",
   "chapterId": "ch04",
   "stem": "f(x) = |x| 在 x = 0 处？",
   "options": [
    "可微且导数为 0",
    "连续但不可微",
    "不连续",
    "可微但导数不存在"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "左右差商分别为 1 和 −1，极限不存在，所以不可微；但函数本身连续。",
   "misconception": "",
   "bookSource": null
  },
