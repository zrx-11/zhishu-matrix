  },
  {
   "id": "q19",
   "chapterId": "ch07",
   "stem": "GQA 的 KV 缩减比是？",
   "options": [
    "n_h/n_kv",
    "n_kv/n_h",
    "d_head/d",
    "h/d"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "KV 头数除以查询头数；n_h=32、n_kv=8 时缩到 1/4。",
   "misconception": "",
   "bookSource": null
  },
