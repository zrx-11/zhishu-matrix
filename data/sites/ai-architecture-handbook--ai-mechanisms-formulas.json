 "quizzes": [
  {
   "id": "q01",
   "chapterId": "ch01",
   "stem": "这份总库最适合怎么用？",
   "options": [
    "从 1 到 114 按编号背完",
    "把它当回查索引，按问题定位机制",
    "只看公式，不看机制",
    "用它替代所有分册"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "编号是索引，不是学习顺序；先定位问题再回主手册深读。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q02",
   "chapterId": "ch01",
   "stem": "114 个机制被分成几组？",
   "options": [
    "6 组",
    "7 组",
    "9 组",
    "12 组"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "模型架构、变体、预训练、后训练、解码、推理、生成、应用、安全，共九组。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q03",
   "chapterId": "ch02",
   "stem": "BPE 分词的核心操作是？",
   "options": [
    "把每个字符单独作为一个 token",
    "反复合并最高频相邻字符对",
    "用固定词表查表",
    "按语法树切分"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "BPE 从字符表开始，统计并合并最高频相邻对，高频词整词一个 token。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q04",
   "chapterId": "ch02",
   "stem": "GQA 主要压缩哪一份账？",
   "options": [
    "注意力 FLOPs",
    "KV cache 显存",
    "FFN 参数",
    "词表大小"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "GQA 让多个查询头共享 K/V，省 KV cache 显存与带宽，不省注意力 FLOPs。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q05",
   "chapterId": "ch02",
   "stem": "MLA 的代价是什么？",
   "options": [
    "完全不能长上下文",
    "多一次投影矩阵乘",
    "必须放弃 MoE",
    "只能训练不能推理"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "MLA 把 K/V 压成低秩潜向量，省 KV 显存；用时投影回来，多一次矩阵乘。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q06",
   "chapterId": "ch03",
   "stem": "数据并行（DP）的主要限制是？",
   "options": [
    "每卡仍要一份完整权重",
    "只能单卡运行",
    "不能同步梯度",
    "只支持 CNN"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "DP 分摊数据，不分摊权重；每卡仍持有完整模型。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q07",
   "chapterId": "ch03",
   "stem": "长上下文训练最先爆的常是？",
   "options": [
    "词表",
    "激活显存",
    "磁盘",
    "CPU"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "序列并行与梯度检查点都在处理激活；长序列激活常是最大一块。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q08",
   "chapterId": "ch03",
   "stem": "loss spike 的合理急救顺序是？",
   "options": [
    "直接换模型",
    "梯度裁剪、降学习率、回滚检查点，再查数据",
    "只加大 batch",
    "忽略继续训"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "先稳住训练，再定位数据或数值问题。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q09",
   "chapterId": "ch04",
   "stem": "RLVR 的前提是？",
   "options": [
    "有大量人工偏好标注",
    "任务能自动判对错",
    "必须训练奖励模型",
    "只能做对话"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "RLVR 把答案交给验证器；没有可验证环境就无法给奖励。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q10",
   "chapterId": "ch04",
   "stem": "DPO 相比 RLHF 少了什么？",
   "options": [
    "偏好数据",
    "奖励模型与在线采样",
    "参考策略",
    "SFT"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "DPO 直接用偏好对算分类损失，省掉奖励模型和在线采样。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q11",
   "chapterId": "ch04",
   "stem": "推测解码在什么情况下可能倒亏？",
   "options": [
    "接受率很低",
    "显存很大",
    "上下文很短",
    "batch=1"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "接受率低时草稿大量被拒，开销超过收益。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q12",
   "chapterId": "ch05",
   "stem": "PagedAttention 主要解决？",
   "options": [
    "KV cache 显存碎片",
    "词表外 token",
    "梯度爆炸",
    "数据重复"
   ],
   "answer": 0,
   "type": "single",
   "conceptId": "",
   "explain": "借虚拟内存分页，把 KV 切成固定块按需分配。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q13",
   "chapterId": "ch05",
   "stem": "prefill 与 decode 的特性分别是？",
   "options": [
    "都算力密集",
    "都带宽密集",
    "prefill 算力密集，decode 带宽密集",
    "prefill 带宽密集，decode 算力密集"
   ],
   "answer": 2,
   "type": "single",
   "conceptId": "",
   "explain": "prefill 一次处理整段 prompt，是大矩阵乘；decode 逐 token，受带宽约束。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q14",
   "chapterId": "ch05",
   "stem": "KV 驱逐时必须保留哪些 token？",
   "options": [
    "所有停用词",
    "开头几个 Attention Sink",
    "最后一个 token",
    "随机 token"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "开头几个 token 是注意力落脚点，丢掉会让整段注意力失准。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q15",
   "chapterId": "ch06",
   "stem": "RAG 链路中最影响召回质量的一步是？",
   "options": [
    "生成温度",
    "切块与嵌入",
    "标点",
    "模型参数量"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "切块决定颗粒度，嵌入决定语义召回；生成不是召回瓶颈。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q16",
   "chapterId": "ch06",
   "stem": "提示注入攻击的核心结构缺陷是？",
   "options": [
    "模型参数太小",
    "模型分不清数据与指令",
    "词表太大",
    "上下文太短"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "上下文里所有 token 一律平等，第三方数据里的指令会被当指令执行。",
   "misconception": "",
   "bookSource": null
  },
  {
   "id": "q17",
   "chapterId": "ch06",
   "stem": "越狱与提示注入的区别是？",
   "options": [
    "完全一样",
    "越狱由用户发起，注入藏在数据里",
    "越狱只攻击图像",
    "注入只攻击训练集"
   ],
   "answer": 1,
   "type": "single",
   "conceptId": "",
   "explain": "越狱是用户自己想让模型说禁区内容；注入是第三方把指令藏进模型会读的数据。",
   "misconception": "",
   "bookSource": null
  },
  {
