 "cards": [
  {
   "id": "f01",
   "front": "函数的核心含义是什么？",
   "back": "输入定输出：每个输入对应唯一输出。",
   "chapterId": "ch01",
   "tags": [
    "函数"
   ]
  },
  {
   "id": "f02",
   "front": "f(g(x)) 先算哪层？",
   "back": "先算内层 g(x)，把结果喂给外层 f。",
   "chapterId": "ch01",
   "tags": [
    "复合"
   ]
  },
  {
   "id": "f03",
   "front": "神经网络整体是什么？",
   "back": "一个函数：输入一组数，输出一组数。",
   "chapterId": "ch01",
   "tags": [
    "函数"
   ]
  },
  {
   "id": "f04",
   "front": "y=kx+b 中 k 和 b 各管什么？",
   "back": "k 管倾斜（每走一格升降多少），b 管上下平移。",
   "chapterId": "ch02",
   "tags": [
    "直线"
   ]
  },
  {
   "id": "f05",
   "front": "线性分类规则的判断依据是什么？",
   "back": "z=w1x1+w2x2+b 的符号，正判 1，负判 0。",
   "chapterId": "ch02",
   "tags": [
    "分类"
   ]
  },
  {
   "id": "f06",
   "front": "导数的定义式是什么？",
   "back": "f'(x)=lim(h→0)[f(x+h)-f(x)]/h。",
   "chapterId": "ch03",
   "tags": [
    "导数"
   ]
  },
  {
   "id": "f07",
   "front": "(x²)' 等于什么？怎么推？",
   "back": "2x。展开 (x+h)² 减 x²，除以 h 得 2x+h，令 h→0。",
   "chapterId": "ch03",
   "tags": [
    "导数"
   ]
  },
  {
   "id": "f08",
   "front": "导数为正说明什么？",
   "back": "输入增大时输出增大；要让输出变小，应减小输入。",
   "chapterId": "ch03",
   "tags": [
    "导数"
   ]
  },
  {
   "id": "f09",
   "front": "链式法则的公式是什么？",
   "back": "dy/dx=(dy/du)(du/dx)，外层导数乘内层导数。",
   "chapterId": "ch04",
   "tags": [
    "链式法则"
   ]
  },
  {
   "id": "f10",
   "front": "链式法则为什么是乘？",
   "back": "变化量链条上中间变量被约掉，传导率逐段相乘。",
   "chapterId": "ch04",
   "tags": [
    "链式法则"
   ]
  },
  {
   "id": "f11",
   "front": "点积怎么算？",
   "back": "对应位置相乘，再把所有乘积加起来。",
   "chapterId": "ch05",
   "tags": [
    "向量"
   ]
  },
  {
   "id": "f12",
   "front": "矩阵乘向量的维度规则？",
   "back": "W 是 m×n，x 是 n 维，结果是 m 维。",
   "chapterId": "ch05",
   "tags": [
    "矩阵"
   ]
  },
  {
   "id": "f13",
   "front": "一个神经元做哪两步？",
   "back": "加权求和 z=w·x+b，再过激活函数。",
   "chapterId": "ch06",
   "tags": [
    "神经元"
   ]
  },
  {
   "id": "f14",
   "front": "为什么单个神经元做不了异或？",
   "back": "异或两类点对角交错，一条直线无法完整分开。",
   "chapterId": "ch06",
   "tags": [
    "异或"
   ]
  },
  {
   "id": "f15",
   "front": "两层纯线性网络等价于什么？为什么？",
   "back": "等价于一层线性。W2(W1x+b1)+b2 仍是 Wx+B 的形式。",
   "chapterId": "ch07",
   "tags": [
    "激活函数"
   ]
  },
  {
   "id": "f16",
   "front": "sigmoid 的导数是什么？",
   "back": "σ'(z)=σ(z)(1-σ(z))，最大值 0.25。",
   "chapterId": "ch07",
   "tags": [
    "sigmoid"
   ]
  },
  {
   "id": "f17",
   "front": "ReLU 的定义和导数？",
   "back": "ReLU(z)=max(0,z)；正区间导数 1，负区间 0。",
   "chapterId": "ch07",
   "tags": [
    "ReLU"
   ]
  },
  {
   "id": "f18",
   "front": "前向传播每层做哪三件事？",
   "back": "矩阵乘、加偏置、过激活。",
   "chapterId": "ch08",
   "tags": [
    "前向传播"
   ]
  },
  {
   "id": "f19",
   "front": "2-2-1 网络有多少参数？",
   "back": "9 个：6 个权重加 3 个偏置。",
   "chapterId": "ch08",
   "tags": [
    "参数"
   ]
  },
  {
   "id": "f20",
   "front": "隐藏层为什么叫隐藏？",
   "back": "它的值没有标签监督，是网络自己算出的中间表示。",
   "chapterId": "ch08",
   "tags": [
    "隐藏层"
   ]
  },
  {
   "id": "f21",
   "front": "平方损失怎么算？",
   "back": "L=(y-ŷ)²，多样本取平均。",
   "chapterId": "ch09",
   "tags": [
    "损失"
   ]
  },
  {
   "id": "f22",
   "front": "用平方而不是绝对值的三个理由？",
   "back": "不抵消、放大严重错误、处处可导。",
   "chapterId": "ch09",
   "tags": [
    "损失"
   ]
  },
  {
   "id": "f23",
   "front": "损失和准确率的区别？",
   "back": "损失看差距大小，准确率只看对错。",
   "chapterId": "ch09",
   "tags": [
    "损失"
   ]
  },
  {
   "id": "f24",
   "front": "梯度下降的更新公式？",
   "back": "θ←θ-η∂L/∂θ，沿梯度反方向走一步。",
   "chapterId": "ch10",
   "tags": [
    "梯度下降"
   ]
  },
  {
   "id": "f25",
   "front": "学习率过大会怎样？过小呢？",
   "back": "过大震荡或发散，过小收敛很慢。",
   "chapterId": "ch10",
   "tags": [
    "学习率"
   ]
  },
  {
   "id": "f26",
   "front": "梯度为 0 一定是谷底吗？",
   "back": "不一定，也可能是山顶或鞍点。",
   "chapterId": "ch10",
   "tags": [
    "梯度"
   ]
  },
  {
   "id": "f27",
   "front": "δ 的定义是什么？",
   "back": "δ=∂L/∂z，损失对该层激活前打分的偏导。",
   "chapterId": "ch11",
   "tags": [
    "反向传播"
   ]
  },
  {
   "id": "f28",
   "front": "隐藏层 δ 的递推公式？",
   "back": "δ_l=(W_{l+1}ᵀδ_{l+1})⊙σ'(z_l)。",
   "chapterId": "ch11",
   "tags": [
    "反向传播"
   ]
  },
  {
   "id": "f29",
   "front": "权重梯度和 δ 的关系？",
   "back": "∂L/∂W=δ×该层的输入，∂L/∂b=δ。",
   "chapterId": "ch11",
   "tags": [
    "反向传播"
   ]
  },
  {
   "id": "f30",
   "front": "过拟合的典型曲线形状？",
   "back": "训练损失持续下降，验证损失先降后升。",
   "chapterId": "ch12",
   "tags": [
    "过拟合"
   ]
  },
  {
   "id": "f31",
   "front": "四种对抗过拟合的手段？",
   "back": "正则化、Dropout、早停、数据增强。",
   "chapterId": "ch12",
   "tags": [
    "过拟合"
   ]
  },
  {
   "id": "f32",
   "front": "异或网络的三步逻辑？",
   "back": "OR 且非 AND：h1 算 OR，h2 算 AND，输出层组合。",
   "chapterId": "ch13",
   "tags": [
    "异或"
   ]
  },
  {
   "id": "f33",
   "front": "隐藏层解决异或的本质？",
   "back": "换坐标：把交错的两类点映射到可分的新位置。",
   "chapterId": "ch13",
   "tags": [
    "异或"
   ]
  },
  {
   "id": "f34",
   "front": "手工设计用阶跃，实际训练为什么不行？",
   "back": "阶跃不可导，无法做反向传播，要用 sigmoid 等平滑近似。",
   "chapterId": "ch13",
   "tags": [
    "激活函数"
   ]
  }
 ],
