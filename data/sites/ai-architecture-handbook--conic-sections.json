 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：椭圆」的一句话核心是什么？",
   "back": "椭圆是“到两定点距离之和为常数”的点集；a 是半长轴，c 是半焦距，b²=a²−c²。",
   "chapterId": "ch01",
   "tags": [
    "conic-sections",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：双曲线与抛物线」的一句话核心是什么？",
   "back": "双曲线是“距离之差为常数”，抛物线是“到定点与定直线等距”；前者有渐近线，后者只有一条对称轴。",
   "chapterId": "ch02",
   "tags": [
    "conic-sections",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：统一定义、光学性质与坐标变换」的一句话核心是什么？",
   "back": "三条曲线可以合成一句话：到焦点距离与到准线距离之比等于 e。",
   "chapterId": "ch03",
   "tags": [
    "conic-sections",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "什么是「椭圆」？",
   "back": "到两定点距离之和为常数的点的轨迹。",
   "chapterId": "ch01",
   "tags": [
    "conic-sections",
    "术语"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「焦点」？",
   "back": "定义中的定点。",
   "chapterId": "ch01",
   "tags": [
    "conic-sections",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「半长轴」？",
   "back": "椭圆中的 a，长轴长为 2a。",
   "chapterId": "ch01",
   "tags": [
    "conic-sections",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「离心率」？",
   "back": "e=c/a，描述曲线的形状参数。",
   "chapterId": "ch01",
   "tags": [
    "conic-sections",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「双曲线」？",
   "back": "到两定点距离之差为常数的点的轨迹。",
   "chapterId": "ch02",
   "tags": [
    "conic-sections",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「渐近线」？",
   "back": "双曲线无限接近但不相交的直线。",
   "chapterId": "ch02",
   "tags": [
    "conic-sections",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「抛物线」？",
   "back": "到定点与定直线等距的点的轨迹。",
   "chapterId": "ch02",
   "tags": [
    "conic-sections",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「准线」？",
   "back": "统一定义中的定直线。",
   "chapterId": "ch03",
   "tags": [
    "conic-sections",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「通径」？",
   "back": "过焦点垂直于对称轴的弦。",
   "chapterId": "ch01",
   "tags": [
    "conic-sections",
    "术语"
   ]
  }
 ],
