 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：消元法与解的判定」的一句话核心是什么？",
   "back": "消元的目的是化成阶梯形；阶梯形里有几条有效的“非零行”，就有几个独立方程。",
   "chapterId": "ch01",
   "tags": [
    "linear-systems-matrices",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：行列式与克莱默法则」的一句话核心是什么？",
   "back": "行列式是一个由方阵算出的数，它不为零就说明方程组有唯一解。",
   "chapterId": "ch02",
   "tags": [
    "linear-systems-matrices",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：矩阵运算与逆矩阵」的一句话核心是什么？",
   "back": "矩阵乘法是“行乘列”，不是对应元素相乘；只有方阵才谈逆矩阵。",
   "chapterId": "ch03",
   "tags": [
    "linear-systems-matrices",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "「第 4 章：线性变换与二次型」的一句话核心是什么？",
   "back": "线性变换就是“用矩阵乘向量”；二次型是“把二次多项式写成 xᵀAx”。",
   "chapterId": "ch04",
   "tags": [
    "linear-systems-matrices",
    "核心"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「增广矩阵」？",
   "back": "系数矩阵右侧接上常数项列得到的矩阵。",
   "chapterId": "ch01",
   "tags": [
    "linear-systems-matrices",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「初等行变换」？",
   "back": "交换两行、某行乘非零数、某行的倍数加到另一行。",
   "chapterId": "ch01",
   "tags": [
    "linear-systems-matrices",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「秩」？",
   "back": "阶梯形中非零行的个数。",
   "chapterId": "ch01",
   "tags": [
    "linear-systems-matrices",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「自由未知量」？",
   "back": "无穷多解中可以任意取值的未知量。",
   "chapterId": "ch01",
   "tags": [
    "linear-systems-matrices",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「行列式」？",
   "back": "由方阵算出的一个数。",
   "chapterId": "ch02",
   "tags": [
    "linear-systems-matrices",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「克莱默法则」？",
   "back": "用行列式表示唯一解的公式。",
   "chapterId": "ch02",
   "tags": [
    "linear-systems-matrices",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「转置」？",
   "back": "行列互换得到的矩阵。",
   "chapterId": "ch03",
   "tags": [
    "linear-systems-matrices",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「逆矩阵」？",
   "back": "满足 AA⁻¹=E 的矩阵。",
   "chapterId": "ch03",
   "tags": [
    "linear-systems-matrices",
    "术语"
   ]
  },
  {
   "id": "f13",
   "front": "什么是「线性变换」？",
   "back": "用矩阵乘法表示的、保持线性结构的映射。",
   "chapterId": "ch04",
   "tags": [
    "linear-systems-matrices",
    "术语"
   ]
  },
  {
   "id": "f14",
   "front": "什么是「二次型」？",
   "back": "二次齐次多项式，可写成 xᵀAx。",
   "chapterId": "ch04",
   "tags": [
    "linear-systems-matrices",
    "术语"
   ]
  }
 ],
