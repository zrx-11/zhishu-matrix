 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：数列与通项」的一句话核心是什么？",
   "back": "数列是定义在正整数上的函数：aₙ=f(n)，顺序本身就是信息。",
   "chapterId": "ch01",
   "tags": [
    "sequences-limits",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：等差数列与等比数列」的一句话核心是什么？",
   "back": "等差是“加”，等比是“乘”；求和公式都能由“配对”或“错位相减”推出来。",
   "chapterId": "ch02",
   "tags": [
    "sequences-limits",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：级数与极限」的一句话核心是什么？",
   "back": "极限就是“n 越大越靠近某个定值”；无穷多个数相加，和可能是一个有限的数。",
   "chapterId": "ch03",
   "tags": [
    "sequences-limits",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "什么是「数列」？",
   "back": "按顺序排列的一列数。",
   "chapterId": "ch01",
   "tags": [
    "sequences-limits",
    "术语"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「通项公式」？",
   "back": "用 n 表示第 n 项的公式。",
   "chapterId": "ch01",
   "tags": [
    "sequences-limits",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「递推公式」？",
   "back": "用前项表示后项的关系式加初值。",
   "chapterId": "ch01",
   "tags": [
    "sequences-limits",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「等差数列」？",
   "back": "相邻两项差为常数的数列。",
   "chapterId": "ch02",
   "tags": [
    "sequences-limits",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「等比数列」？",
   "back": "相邻两项比为常数的数列。",
   "chapterId": "ch02",
   "tags": [
    "sequences-limits",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「部分和」？",
   "back": "前 n 项相加得到的 Sₙ。",
   "chapterId": "ch03",
   "tags": [
    "sequences-limits",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「极限」？",
   "back": "n 无限增大时数列趋向的定值。",
   "chapterId": "ch03",
   "tags": [
    "sequences-limits",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「收敛」？",
   "back": "极限存在，部分和趋向有限值。",
   "chapterId": "ch03",
   "tags": [
    "sequences-limits",
    "术语"
   ]
  },
  {
   "id": "f12",
   "front": "什么是「连分数」？",
   "back": "分母中含下一层分式的无限表达式。",
   "chapterId": "ch03",
   "tags": [
    "sequences-limits",
    "术语"
   ]
  }
 ],
