 "cards": [
  {
   "id": "f001",
   "front": "第 1 章一句话核心是什么？",
   "back": "科学家不是靠灵感生活的人，而是把大部分时间花在测量、计算、验证上的人；一个模型的价值，取决于它能否被独立实验证实。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f002",
   "front": "从散射实验到原子核模型——一句话说清它是什么？",
   "back": "卢瑟福让 α 粒子打金箔，发现大多数穿过去、少数大角度反弹。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f003",
   "front": "科学家的日常——一句话说清它是什么？",
   "back": "他描述科学家的生活：长时间的重复测量、枯燥的计算、与同行争论、写论文被拒。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f004",
   "front": "验证的分量——一句话说清它是什么？",
   "back": "模型提出后，盖革与马斯顿用一系列实验证实了散射公式的预言。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f005",
   "front": "第 2 章一句话核心是什么？",
   "back": "科学追求的动机不止实用与好奇，还包括对秩序与和谐的信念；开普勒就是被“宇宙必须是和谐的”这一信念推着走的。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f006",
   "front": "开普勒的执念——一句话说清它是什么？",
   "back": "开普勒相信行星轨道背后有几何与音乐的和谐，花了二十多年试各种正多面体模型，最后用第谷的观测数据逼出椭圆轨道。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f007",
   "front": "动机的谱系——一句话说清它是什么？",
   "back": "钱德拉塞卡列出几类：实用（计时、导航）、好奇（想知道为什么）、审美（追求简洁与对称）、野心（想要名声）。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f008",
   "front": "动机与诚实——一句话说清它是什么？",
   "back": "他提醒：动机会影响你接受什么证据。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f009",
   "front": "第 3 章一句话核心是什么？",
   "back": "创造力在人生中的分布有三种形态：早年即巅峰后转向（莎士比亚）、一次爆发后不再有原创（牛顿）、持续上升到晚年（贝多芬）。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f010",
   "front": "莎士比亚：早年巅峰——一句话说清它是什么？",
   "back": "莎士比亚在三十岁前后写出主要喜剧与历史剧，随后转向悲剧与传奇剧。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f011",
   "front": "牛顿：一次爆发——一句话说清它是什么？",
   "back": "牛顿的核心工作（微积分、光学、引力）集中在二十几岁到三十出头，之后转向造币厂与神学，再没有同等量级的原创。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f012",
   "front": "贝多芬：持续上升——一句话说清它是什么？",
   "back": "贝多芬从早期古典风格，到晚期的《第九交响曲》与弦乐四重奏，创造力持续深化到耳聋之后。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f013",
   "front": "第 4 章一句话核心是什么？",
   "back": "科学家用“美”作为选择理论的判据：简洁、对称、少假设的理论更可能真；但美是启发式，不是证明。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f014",
   "front": "狄拉克的判据——一句话说清它是什么？",
   "back": "狄拉克说：如果两个理论都符合数据，选更美的那个。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f015",
   "front": "拉马努金的直觉——一句话说清它是什么？",
   "back": "拉马努金给出大量没有证明的公式，后来被逐一证实。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f016",
   "front": "风险——一句话说清它是什么？",
   "back": "美可能来自人的认知偏好，而非世界的结构。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f017",
   "front": "第 5 章一句话核心是什么？",
   "back": "米尔恩把恒星内部当作可计算的结构问题，也把强烈的个人信念带进理论；钱德拉塞卡借此说明科学家的性格会留在工作里。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f018",
   "front": "把恒星当结构算——一句话说清它是什么？",
   "back": "恒星靠引力与压强平衡，内部温度与密度由方程决定。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f019",
   "front": "性格与方法——一句话说清它是什么？",
   "back": "米尔恩有强烈的直觉式风格，喜欢从少数原理推出大胆结论。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f020",
   "front": "第 6 章一句话核心是什么？",
   "back": "爱丁顿早年以严谨的恒星物理与广义相对论验证著称，晚年却沉迷用基本常数拼出宇宙结构；同一个人可以同时留下两种极端的遗产。",
   "chapterId": "ch06",
