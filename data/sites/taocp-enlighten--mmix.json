 "cards": [
  {
   "id": "f01",
   "front": "MMIX 的寄存器与内存规格？",
   "back": "256 个 64 位通用寄存器（$0 恒为 0）；内存 2^64 字节，按字节编址、大端序。",
   "chapterId": "ch01",
   "tags": [
    "架构"
   ]
  },
  {
   "id": "f02",
   "front": "MMIX 指令的四个字段？",
   "back": "opcode、x、y、z 各 8 位；x 通常是目的寄存器，y、z 是源或立即数。",
   "chapterId": "ch01",
   "tags": [
    "架构"
   ]
  },
  {
   "id": "f03",
   "front": "数组第 k 个 8 字节元素的偏移是多少？",
   "back": "k×8 字节；偏移量按字节计，不是按元素计。",
   "chapterId": "ch01",
   "tags": [
    "架构"
   ]
  },
  {
   "id": "f04",
   "front": "PUSHJ 做哪三件事？",
   "back": "压入 $X 旧值、把返回地址写进 $X、跳到目标地址。",
   "chapterId": "ch02",
   "tags": [
    "调用"
   ]
  },
  {
   "id": "f05",
   "front": "栈帧里通常存什么？",
   "back": "返回地址、被调用者保存的寄存器旧值、局部变量。",
   "chapterId": "ch02",
   "tags": [
    "调用"
   ]
  },
  {
   "id": "f06",
   "front": "协同程序与子程序的区别？",
   "back": "子程序单向调用返回；协同程序对称交替，切换时双方状态都保留。",
   "chapterId": "ch02",
   "tags": [
    "协同程序"
   ]
  },
  {
   "id": "f07",
   "front": "64 位下链表为什么相对更贵？",
   "back": "指针占 8 字节、节点分散、缓存命中率低；同样数据用数组更省也更快。",
   "chapterId": "ch03",
   "tags": [
    "增补"
   ]
  }
 ],
