 "cards": [
  {
   "id": "f01",
   "front": "「第 1 章：倾斜角与斜率」的一句话核心是什么？",
   "back": "斜率是直线倾斜程度的数：k=tanα，α 是倾斜角；竖直直线没有斜率。",
   "chapterId": "ch01",
   "tags": [
    "line-equations",
    "核心"
   ]
  },
  {
   "id": "f02",
   "front": "「第 2 章：直线方程的五种形式」的一句话核心是什么？",
   "back": "五种形式是同一件事的五种写法；选哪种取决于题目给了什么条件。",
   "chapterId": "ch02",
   "tags": [
    "line-equations",
    "核心"
   ]
  },
  {
   "id": "f03",
   "front": "「第 3 章：位置关系与距离」的一句话核心是什么？",
   "back": "平行看斜率相等，垂直看斜率乘积为 −1；距离靠“点到直线的公式”。",
   "chapterId": "ch03",
   "tags": [
    "line-equations",
    "核心"
   ]
  },
  {
   "id": "f04",
   "front": "什么是「倾斜角」？",
   "back": "直线向上方向与 x 轴正方向的夹角。",
   "chapterId": "ch01",
   "tags": [
    "line-equations",
    "术语"
   ]
  },
  {
   "id": "f05",
   "front": "什么是「斜率」？",
   "back": "倾斜角的正切，反映直线的倾斜程度。",
   "chapterId": "ch01",
   "tags": [
    "line-equations",
    "术语"
   ]
  },
  {
   "id": "f06",
   "front": "什么是「点斜式」？",
   "back": "y−y₀=k(x−x₀)。",
   "chapterId": "ch02",
   "tags": [
    "line-equations",
    "术语"
   ]
  },
  {
   "id": "f07",
   "front": "什么是「斜截式」？",
   "back": "y=kx+b。",
   "chapterId": "ch02",
   "tags": [
    "line-equations",
    "术语"
   ]
  },
  {
   "id": "f08",
   "front": "什么是「截距式」？",
   "back": "x/a+y/b=1。",
   "chapterId": "ch02",
   "tags": [
    "line-equations",
    "术语"
   ]
  },
  {
   "id": "f09",
   "front": "什么是「一般式」？",
   "back": "Ax+By+C=0（A、B 不全为零）。",
   "chapterId": "ch02",
   "tags": [
    "line-equations",
    "术语"
   ]
  },
  {
   "id": "f10",
   "front": "什么是「点到直线距离」？",
   "back": "点与直线上最近点的距离。",
   "chapterId": "ch03",
   "tags": [
    "line-equations",
    "术语"
   ]
  },
  {
   "id": "f11",
   "front": "什么是「夹角」？",
   "back": "两直线所成的锐角或直角。",
   "chapterId": "ch03",
   "tags": [
    "line-equations",
    "术语"
   ]
  }
 ],
