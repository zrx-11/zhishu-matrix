 "cards": [
  {
   "id": "f001",
   "front": "第 1 章一句话核心是什么？",
   "back": "时间不是直接被感知的东西，而是通过比较周期性事件来测量；钟的可靠性靠“全等”检验，而选择哪种运动作标准，含有约定的成分。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f002",
   "front": "格林威治的意外——一句话说清它是什么？",
   "back": "本初子午线的位置是政治协商的结果，不是地理事实。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f003",
   "front": "全等检验——一句话说清它是什么？",
   "back": "把不同构造的钟放在一起，看它们是否保持同步。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f004",
   "front": "时间与自然律——一句话说清它是什么？",
   "back": "如果某个物理过程被选作“标准钟”，时间就成了“该过程的参数”。",
   "chapterId": "ch01",
   "tags": [
    "ch01"
   ]
  },
  {
   "id": "f005",
   "front": "第 2 章一句话核心是什么？",
   "back": "把时间等同于变化，会遇到“变化之间的时间”问题；但设想一段完全没有变化的时间，又似乎可以成立——两种直觉各有代价。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f006",
   "front": "时间即变化——一句话说清它是什么？",
   "back": "柏拉图与亚里士多德都把时间与变化绑定：没有变化就没有时间。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f007",
   "front": "无变化的时间——一句话说清它是什么？",
   "back": "设想一个完全空无、没有任何事件的宇宙，仍可问“它持续了多久”。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f008",
   "front": "皆事有因——一句话说清它是什么？",
   "back": "若时间独立于变化，那么“为什么这一刻而不是那一刻”就缺少理由。",
   "chapterId": "ch02",
   "tags": [
    "ch02"
   ]
  },
  {
   "id": "f009",
   "front": "第 3 章一句话核心是什么？",
   "back": "虚空是否存在，取决于你把“空间”当容器还是当物体之间的关系；气压实验把“真空”从哲学争论变成可操作的现象。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f010",
   "front": "亚里士多德的反驳——一句话说清它是什么？",
   "back": "他主张“自然厌恶真空”：物体运动需要介质，空间不能独立于物体存在。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f011",
   "front": "罐、泵与气压计——一句话说清它是什么？",
   "back": "抽气泵把罐内空气抽出，气压计读数下降，说明“空”是可以被制造的状态。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f012",
   "front": "绝对运动——一句话说清它是什么？",
   "back": "若空间是容器，就可谈“相对于空间的绝对运动”。",
   "chapterId": "ch03",
   "tags": [
    "ch03"
   ]
  },
  {
   "id": "f013",
   "front": "第 4 章一句话核心是什么？",
   "back": "欧几里得几何不是唯一的空间描述；平行公设可以被替换，得到自洽的非欧几何。空间是否有内在曲率，成了可检验的问题。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f014",
   "front": "平行公设的动摇——一句话说清它是什么？",
   "back": "第五公设（过直线外一点只有一条平行线）不像其他公设那样自明。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f015",
   "front": "可感知的空间——一句话说清它是什么？",
   "back": "康德认为空间是感知的先验形式，欧氏几何因此“必然”。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f016",
   "front": "高于三维——一句话说清它是什么？",
   "back": "二维生物无法想象第三维，但可以用“投影”“截面”推理。",
   "chapterId": "ch04",
   "tags": [
    "ch04"
   ]
  },
  {
   "id": "f017",
   "front": "第 5 章一句话核心是什么？",
   "back": "若时间有开端，开端的“之前”无法谈论；若过去无限，又要面对“无穷序列能否完成”。两种选择都有直觉上的代价。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f018",
   "front": "开端的问题——一句话说清它是什么？",
   "back": "“时间从何时开始”若答案是“某时刻”，那此前是什么？若答“无此前”，则“开始”这个词失去通常含义。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f019",
   "front": "过去无限——一句话说清它是什么？",
   "back": "若过去无限，则今天之前有无限多天。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f020",
   "front": "结局——一句话说清它是什么？",
   "back": "开放宇宙永远膨胀。",
   "chapterId": "ch05",
   "tags": [
    "ch05"
   ]
  },
  {
   "id": "f021",
   "front": "第 6 章一句话核心是什么？",
   "back": "若宇宙有边缘，把手伸出去就需要边缘之外的空间；若没有边缘而有限，空间可以像球面一样闭合——有限但无边界。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f022",
   "front": "阿基塔的论证——一句话说清它是什么？",
   "back": "站在宇宙边缘伸手：若能伸出，外面有空间，那原处不是边缘。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f023",
   "front": "有限无边界——一句话说清它是什么？",
   "back": "球面是二维的有限无边界例子：面积有限，但走不到边。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f024",
   "front": "无限的错觉——一句话说清它是什么？",
   "back": "“宇宙之外还有空间”是直觉的产物，它预设了空间是容器。",
   "chapterId": "ch06",
   "tags": [
    "ch06"
   ]
  },
  {
   "id": "f025",
   "front": "第 7 章一句话核心是什么？",
   "back": "芝诺悖论把“运动”拆成无穷段，逼出“无穷过程不能完成”的结论；回应的关键是重新理解无穷级数的和与时间的连续性。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f026",
   "front": "阿基里斯——一句话说清它是什么？",
   "back": "乌龟先跑一段，阿基里斯要追上必须先到乌龟起点，再到乌龟新位置……每次都要经过前一段的一半或一段，似乎永远差一点。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f027",
   "front": "两种回应——一句话说清它是什么？",
   "back": "**无穷小量**：把距离分成越来越小的段，其和收敛到有限值（1/2 + 1/4 + … = 1），所以能追上有明确位置。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f028",
   "front": "汤姆逊的灯——一句话说清它是什么？",
   "back": "灯在 1/2 分钟开关一次、1/4 分钟再开关……到 1 分钟时灯是开还是关？这个思想实验说明“无穷多次操作在有限时间完成”在逻辑上会留下未定义状态。",
   "chapterId": "ch07",
   "tags": [
    "ch07"
   ]
  },
  {
   "id": "f029",
   "front": "第 8 章一句话核心是什么？",
   "back": "麦克塔格特论证：时间若真实，就必须有“过去/现在/未来”的流动（A 系列），但同一事件不能同时具有三种性质，故时间不真实；回应分成现在主义与 B 理论两派。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f030",
   "front": "A 系列与 B 系列——一句话说清它是什么？",
   "back": "**A 系列**（A-series）：事件分为过去、现在、未来，且这个划分在变。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f031",
   "front": "麦克塔格特的论证——一句话说清它是什么？",
   "back": "每个事件都曾是未来、现在是现在、将是过去——三种性质不能同时成立，除非说“曾经是未来、现在是现在”，但这就引入了 A 系列本身，循环。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f032",
   "front": "两种回应——一句话说清它是什么？",
   "back": "**现在主义**（presentism）：只有现在是真实的，过去与未来不实在。",
   "chapterId": "ch08",
   "tags": [
    "ch08"
   ]
  },
  {
   "id": "f033",
   "front": "第 9 章一句话核心是什么？",
   "back": "若时间由瞬间组成，每个瞬间物体都占据一个确定位置，那瞬间内没有运动；但连续运动又不能由静止的瞬间拼出——这是芝诺问题的现代版。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f034",
   "front": "飞矢不动——一句话说清它是什么？",
   "back": "在任一瞬间，箭占据与自身等长的空间，因此在该瞬间静止。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f035",
   "front": "电影隐喻——一句话说清它是什么？",
   "back": "电影由静止帧快速播放造成运动错觉。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f036",
   "front": "连续体——一句话说清它是什么？",
   "back": "数学上，运动可用位置函数 x(t) 描述，瞬时速度为导数。",
   "chapterId": "ch09",
   "tags": [
    "ch09"
   ]
  },
  {
   "id": "f037",
   "front": "第 10 章一句话核心是什么？",
   "back": "时间旅行若允许改变过去，会产生因果矛盾；两种出路是：过去不可改变（自洽），或存在多条时间线（分支）。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f038",
   "front": "祖父悖论——一句话说清它是什么？",
   "back": "回到过去杀死祖父，则父亲不会出生，你也不会出生，于是你无法回去杀死祖父。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f039",
   "front": "自洽解——一句话说清它是什么？",
   "back": "物理上可能只有自洽的历史：你能回去，但任何尝试都会被某种方式阻止，或你的行动本来就是历史的一部分。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f040",
   "front": "分支解——一句话说清它是什么？",
   "back": "回到过去会分出新时间线，你改变的是另一条线，原线不变。",
   "chapterId": "ch10",
   "tags": [
    "ch10"
   ]
  },
  {
   "id": "f041",
   "front": "第 11 章一句话核心是什么？",
   "back": "多重宇宙不是单一假说，而是几类不同结构：空间上遥远的分区、量子分支、模空间里的不同常数；它们的可检验性各不相同。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f042",
   "front": "空间分区——一句话说清它是什么？",
   "back": "若宇宙无限，任何有限组合都会在足够远处重复出现。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f043",
   "front": "量子分支——一句话说清它是什么？",
   "back": "多世界解释把每次测量看成世界分支，所有结果都实现。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f044",
   "front": "可检验性——一句话说清它是什么？",
   "back": "遥远分区原则上不可访问。",
   "chapterId": "ch11",
   "tags": [
    "ch11"
   ]
  },
  {
   "id": "f045",
   "front": "第 12 章一句话核心是什么？",
   "back": "热力学、宇宙学、心理学各有箭头；它们方向一致，但一致的原因没有定论——可能都源于宇宙初始的低熵条件。",
   "chapterId": "ch12",
   "tags": [
    "ch12"
   ]
  },
  {
   "id": "f046",
   "front": "三个箭头——一句话说清它是什么？",
   "back": "**热力学箭头**：熵增。",
   "chapterId": "ch12",
   "tags": [
    "ch12"
   ]
  },
  {
   "id": "f047",
   "front": "一致性问题——一句话说清它是什么？",
   "back": "为什么三种完全不同的过程方向相同？一种解释是它们都继承自初始条件：宇宙从极低熵状态出发，之后所有过程都沿同一方向展开。",
   "chapterId": "ch12",
   "tags": [
    "ch12"
   ]
  },
  {
   "id": "f048",
   "front": "局部的方向——一句话说清它是什么？",
   "back": "在局部系统中，熵可以减少（生命、冰箱）。",
   "chapterId": "ch12",
   "tags": [
    "ch12"
   ]
  }
 ],
